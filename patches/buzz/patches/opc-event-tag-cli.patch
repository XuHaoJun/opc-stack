+/// Parse `--tag KEY=VALUE` arguments into event tags.
+///
+/// Keys are restricted to the shape machine consumers use, and the routing tags
+/// (`h` channel, `e` thread, `p` mentions, `a`/`k` references, `t`/`broadcast`)
+/// are refused: a caller must not be able to redirect delivery by stamping one.
+fn parse_extra_tags(raw: &[String]) -> Result<Vec<Tag>, CliError> {
+    const RESERVED: [&str; 7] = ["h", "e", "p", "a", "k", "t", "broadcast"];
+    let mut tags = Vec::with_capacity(raw.len());
+    for item in raw {
+        let (key, value) = item.split_once('=').ok_or_else(|| {
+            CliError::Usage(format!("--tag expects KEY=VALUE, got {item:?}"))
+        })?;
+        let valid_key = !key.is_empty()
+            && key.len() <= 32
+            && key.chars().all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '-');
+        if !valid_key || RESERVED.contains(&key) {
+            return Err(CliError::Usage(format!(
+                "--tag key {key:?} is invalid or reserved (allowed: [a-z0-9-]{{1,32}})"
+            )));
+        }
+        if value.trim().is_empty() {
+            return Err(CliError::Usage(format!("--tag {key} has an empty value")));
+        }
+        let tag = Tag::parse([key.to_string(), value.to_string()])
+            .map_err(|e| CliError::Usage(format!("--tag {key}: {e}")))?;
+        tags.push(tag);
+    }
+    Ok(tags)
+}
+
+#[cfg(test)]
+mod opc_tag_tests {
+    use super::parse_extra_tags;
+
+    #[test]
+    fn parses_key_value_pairs_in_order() {
+        let tags = parse_extra_tags(&["opc-event=evt_1".to_string(), "opc-track=lab".to_string()])
+            .expect("valid tags");
+        assert_eq!(tags.len(), 2);
+        assert_eq!(tags[0].as_slice(), ["opc-event".to_string(), "evt_1".to_string()]);
+        assert_eq!(tags[1].as_slice(), ["opc-track".to_string(), "lab".to_string()]);
+    }
+
+    #[test]
+    fn rejects_reserved_and_malformed_keys() {
+        for raw in ["h=abc", "p=abc", "broadcast=1", "OpC=1", "=v", "key=", "no-equals", "k e y=v"] {
+            assert!(parse_extra_tags(&[raw.to_string()]).is_err(), "{raw} must be rejected");
+        }
+    }
+}
