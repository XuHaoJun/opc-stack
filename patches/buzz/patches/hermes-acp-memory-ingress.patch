+def preserve_prompt_block_meta(prompt: list[PromptBlock]) -> list[dict[str, Any]]:
+    """Return each prompt block's `_meta` payload, unjoined, in block order.
+
+    OPC memory ingress: `_content_blocks_to_openai_user_content` joins the text blocks
+    with "\\n", which is correct for the model but destroys the only trustworthy
+    structural boundary the prompt has — Buzz sends one section per content block and
+    section bodies are NOT escaped, so the boundary cannot be recovered by parsing the
+    joined string. ACP blocks carry a free `_meta` field (`TextContentBlock.field_meta`,
+    alias `_meta`), and Buzz attaches the event identity there; passing it through
+    unread keeps this function policy-free (the memory provider decides what is
+    eligible), so it can be deleted the day hermes exposes prompt metadata itself.
+    """
+    return [dict(meta) for block in prompt if (meta := getattr(block, "field_meta", None))]
