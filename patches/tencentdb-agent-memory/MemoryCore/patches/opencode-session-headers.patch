@@ -0,0 +1,29 @@
+import { randomUUID } from "node:crypto";
+
+const OPENCODE_HOST = "opencode.ai";
+
+function isOpenCodeEndpoint(baseUrl: string): boolean {
+  try {
+    return new URL(baseUrl).hostname === OPENCODE_HOST;
+  } catch {
+    return false;
+  }
+}
+
+function normalizeSessionId(sessionId?: string): string | undefined {
+  const value = sessionId?.trim();
+  return value || undefined;
+}
+
+export function buildOpenCodeHeaders(
+  baseUrl: string,
+  requestedSessionId?: string,
+  fallbackSessionId?: string,
+): Record<string, string> {
+  if (!isOpenCodeEndpoint(baseUrl)) return {};
+
+  const sessionId = normalizeSessionId(requestedSessionId)
+    ?? normalizeSessionId(fallbackSessionId)
+    ?? randomUUID();
+  return { "x-opencode-session": sessionId };
+}
