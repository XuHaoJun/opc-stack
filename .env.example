# ─────────────────────────────────────────────────────────────────────────────
# OPC stack (.env) — Buzz + Hermes + Paperclip + TencentDB-Agent-Memory
#
# Quickstart (new machine):
#   1. cp .env.example .env
#   2. Fill in OPENAI_API_KEY (OpenAI-compatible provider; one key for the whole stack)
#   3. scripts/setup.sh   (submodule init → apply patches → build → up)
#   4. tests/connectivity.sh
#
# The *_PASSWORD / *_KEY / *_SECRET values below are pre-generated; you can
# keep them or replace them with your own. Change them BEFORE first boot —
# they are baked into persistent volumes/DBs afterwards.
# ─────────────────────────────────────────────────────────────────────────────

# ── Deployment identity ──
# Prefix of the locally built images (opc/buzz:local → ${IMAGE_PREFIX}/buzz:local).
# Change only if you push images to your own registry.
IMAGE_PREFIX=opc
# Docker compose project name (prefixes volume names). Lets two stacks coexist
# on one host. Change BEFORE first `up` (volumes are named after this).
COMPOSE_PROJECT_NAME=opc

# Host file the host-sync-claude one-shot mirrors into the prototyper agent's
# home (paperclip's claude_local adapter). Leave unset for the normal
# single-stack case — compose defaults it to ${HOME}/.claude/.credentials.json.
#
# Override it when a SECOND stack runs on this host (tests/fresh-install.sh
# does): the OAuth refresh token inside is single-use, so whichever container
# refreshes it invalidates every other copy including the host's own login.
# Point the extra stack at an empty file — the hook reads empty as "no Claude
# login", warns, and exits 0, which costs nothing while claude_local is
# unwired (see AGENTS.md).
#CLAUDE_CREDENTIALS_FILE=

# ── LLM provider: OpenAI-compatible endpoint (OpenCode Go default) ──
# OpenAI-compatible endpoint: https://opencode.ai/zen/go/v1
# One key powers Hermes (front door + gateway), omp, and TencentDB memory.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
OPENAI_MODEL=deepseek-v4-flash

# ── Other LLM provider keys (optional; leave empty if using the OpenAI-compatible endpoint) ──
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# ── Buzz ──
BUZZ_DB_PASSWORD=yg_v9et7DZp483s-aN5YBJUUQnpNjoZC
BUZZ_REDIS_PASSWORD=G0ZKe3YjUStH6SlMPeiiXVBEqecWqqXB
BUZZ_S3_ACCESS_KEY=opc-minio
BUZZ_S3_SECRET_KEY=81nLKK5NG71rPqfxv2s_srws9Wa_LiLR
BUZZ_S3_BUCKET=buzz-media
BUZZ_PORT=3000
# The relay binds ONE canonical host (this URL). Every client — desktop,
# front-door agent, expert agents — must connect through exactly this
# host:port string; the relay verifies NIP-42/98 signatures against it and
# rejects anything else SILENTLY.
#
# YOU MUST CHANGE THIS from the localhost default. ws://localhost:3000 only
# works for clients that share the relay's network namespace (the desktop on
# this machine, and the `frontdoor` container). The expert agents live in the
# `hermes` container, which does NOT share that namespace — there
# ws://localhost:3000 points at hermes itself, and the expert's Buzz posts go
# nowhere. Set this to an address routable from other containers AND from
# your devices: this machine's LAN or tailnet IP, e.g. ws://192.168.1.10:3000.
# If that IP changes, update this + `docker compose up -d buzz frontdoor hermes`.
# Set to "false" to make the relay open (any pubkey can connect, no invites).
BUZZ_RELAY_URL=ws://localhost:3000
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
# Public NIP-OA owner attestation generated by:
#   scripts/set-buzz-agent-owner.sh <display-name-or-pubkey>
BUZZ_ACP_AGENT_OWNER=
BUZZ_AUTH_TAG=
# Host-only path to the owner's pkey file; never passed into Compose.
BUZZ_OWNER_KEY_FILE=
# Front-door agent model. deepseek-v4-flash produces garbage output with
# hermes's system prompt on the OpenCode Go endpoint. Default gpt-5.6-luna
# Buzz front-door agent model. deepseek-v4-pro: reliable — follows the
# skills index (loads paperclip-api), clean stream termination, pricier.
# gpt-5.6-luna: cheaper, but intermittently drops streams and skips the
# skills index (paperclip/assign-PR flow fails). deepseek-v4-flash
# degenerates with hermes's long system prompt.
BUZZ_AGENT_MODEL=deepseek-v4-pro

# ── Hermes (gateway + dashboard) ──
HERMES_DASHBOARD_USERNAME=admin
HERMES_DASHBOARD_PASSWORD=ETwXTGUTU1E3-15DVOTMjQ
HERMES_API_SERVER_KEY=7FHBXqatcxyH-x6nQpgfbw7G16j8Si45
# Per-profile API key for the scientist expert. Under multiplex each named
# profile authenticates with its OWN key (gateway/platforms/api_server.py
# _expected_api_key), and the guard is fail-closed: shorter than 16 chars
# resolves to the empty string and every request 401s.
HERMES_SCIENTIST_API_KEY=vJ2mQ8pR4tYw6xZ1aB3cD5eF7gH9iK0L
HERMES_DASHBOARD_PORT=9119
HERMES_API_PORT=8642
# Scoped Paperclip bridge key (create it in Paperclip: Settings → API keys,
# type "task bridge", scoped to a project). Optional at boot.
PAPERCLIP_BRIDGE_API_KEY=
# ── Paperclip ──
BETTER_AUTH_SECRET=07277cfeadc6ff313cd7a61ce4d2d767673839b4ef91170dda5fa70c8f8ed9bd
PAPERCLIP_PORT=3100
PAPERCLIP_PUBLIC_URL=http://localhost:3100
# First-admin account, auto-created by the paperclip-bootstrap one-shot
# (idempotent; only used before the first admin exists). Override freely.
PAPERCLIP_ADMIN_EMAIL=admin@opc.local
PAPERCLIP_ADMIN_PASSWORD=pc_Admin3Fwq9sTb2
PAPERCLIP_ADMIN_NAME=Admin
PAPERCLIP_COMPANY_NAME=OPC
PAPERCLIP_EXECUTOR_AGENT_NAME=OMP Engineer
# Paperclip hostname allow-list (comma-separated). Default includes the
# docker service name "paperclip" (hermes/frontdoor call it internally).
# Add this machine's LAN IP to open the board from other devices:
#   PAPERCLIP_ALLOWED_HOSTNAMES=paperclip,192.168.1.10
PAPERCLIP_ALLOWED_HOSTNAMES=paperclip
# Paperclip board API key: NOT an env var — the paperclip-bootstrap one-shot
# writes it to the opc-keys volume (/keys/paperclip-api.key); frontdoor/hermes
# entrypoints inject it as PAPERCLIP_API_KEY at boot. See SETUP.md.

# ── omp ──
# omp (Oh My Pi) is NOT a service — it is installed as a tool via nix into
# the buzz / frontdoor / hermes / paperclip containers (persistent on their
# /nix volumes). See SETUP.md.

# ── TencentDB-Agent-Memory ──
# Gates the MemoryCore gateway (8420) Bearer auth AND is reused by the Hermes
# memory_tencentdb provider (MEMORY_TENCENTDB_GATEWAY_API_KEY) in the
# hermes/frontdoor containers — both sides read the same var, keep in sync.
TENCENTDB_GATEWAY_API_KEY=SJstafjzZaWvvQbVZBtOxQIx53Eyamyg
# Panel login key (sk-mem-*). Created by the one-shot init-admin bootstrap.
TENCENTDB_ADMIN_USERNAME=admin
TENCENTDB_ADMIN_USER_KEY=sk-mem-0d22d1f37b54ade5d91cab6067765db1
# Meta-plane provisioning (tencentdb-bootstrap one-shot): the panel at 8125
# renders teams/agents from the kernel meta registry, so the ids the hermes
# memory plugin writes under must be registered. agent_id MUST start with
# "agt" — the panel parses chat_memory-{team}-{agent} asset ids at the last
# "-agt" boundary.
TENCENTDB_TEAM_ID=opc
TENCENTDB_TEAM_NAME=OPC
TENCENTDB_AGENT_ID=agt-hermes-front-door
TENCENTDB_AGENT_NAME=Hermes Front Door
TENCENTDB_CORE_PORT=8420
TENCENTDB_PANEL_PORT=8125
TENCENTDB_KNOWLEDGE_PORT=8424
TENCENTDB_PROXY_PORT=8096
TENCENTDB_KNOWLEDGE_PUBLIC_URL=http://localhost:8424/v3
# LLM used by memory extraction / wiki ingest (OpenAI-compatible; defaults
# follow OPENAI_* — override TENCENTDB_LLM_* only if you use another provider).
TENCENTDB_LLM_API_KEY=
TENCENTDB_LLM_BASE_URL=
TENCENTDB_LLM_MODEL=
# Proxy forwards coding-agent traffic here (OpenAI-compatible; defaults
# follow OPENAI_*).
PROXY_UPSTREAM_URL=
PROXY_UPSTREAM_API_KEY=

# ── devenv: shared backends leased per-tenant by Paperclip agents ──────────
# The `devenv` CLI (in the paperclip container) hands each prototype/ticket an
# isolated postgres database + valkey ACL user, written to the workspace .env
# as DATABASE_URL / VALKEY_URL. Reclamation is manual (`devenv release`);
# `devenv list` (or a SQL client on 127.0.0.1:5433) shows what is accumulating.
# All of these have working defaults — leave them blank and the lane still
# comes up. They are weak on purpose: loopback-only scratch backends holding
# throwaway data. Set them if you ever keep something you would miss.
DEVENV_PG_PASSWORD=
DEVENV_VALKEY_PASSWORD=
# Per-tenant credentials are derived from this salt rather than stored, which
# is what makes `devenv provision` idempotent. Changing it invalidates every
# .env already handed to an agent, so set it once or not at all.
#   openssl rand -hex 32
DEVENV_SECRET_SALT=
# Host-side ports for inspecting the data yourself (bound to 127.0.0.1).
DEVENV_PG_PORT=5433
DEVENV_VALKEY_PORT=6380
# S3 object storage (RustFS) — same loopback-only scratch stance as postgres/valkey.
# Defaults are weak scratch credentials for throwaway data; host publication is
# 127.0.0.1 only. Changing DEVENV_S3_ROOT_USER / DEVENV_S3_ROOT_PASSWORD after
# RustFS has initialized its data volume requires explicit operator reconciliation
# (credentials are baked into RustFS storage and tenant provisioning) — it does
# not rotate automatically. Tenant bucket/IAM secrets remain derived from
# DEVENV_SECRET_SALT, not these root values.
DEVENV_S3_ROOT_USER=devenv-admin
DEVENV_S3_ROOT_PASSWORD=
DEVENV_S3_PORT=9002
# ── podenv (巢狀容器租約) ──────────────────────────────────────────────
# devenv 蓋不到的那一半: 不能 multi-tenant 的 daemon、超舊版本的 image。
# 這些 port 只發佈到 127.0.0.1, 供你拿 client 直接連租到的 daemon。
# PODENV_PORT_RANGE_END 必須 = BASE + COUNT - 1 (compose 不會算術), 而
# BASE 必須低於 32768 (kernel ephemeral range) —— 與 DEVENV_HTTP_* 同一個坑。
PODENV_PORT_BASE=23000
PODENV_PORT_COUNT=16
PODENV_PORT_RANGE_END=23015
# 整條 lane 的記憶體上限。per-lease 上限做不到 (podman 的 --memory 在這個拓撲
# 下會被靜靜忽略), 所以這是唯一真的生效的旋鈕。
PODENV_MEM_LIMIT=4g

# ── prototype preview ports ───────────────────────────────────────────
# Where the preview range is published on the host.
#
# Default 0.0.0.0 — the same as paperclip (3100), buzz (3000) and hermes
# (8642/9119). The preview link lives ON the board, so anything narrower than
# the board itself produces a link that cannot be opened from where it is
# shown. Tighten per deployment if you want: 127.0.0.1 for local-only, or a
# tailnet address (Tailscale 100.x) to reach your own devices without
# listening on the LAN.
#
# Changing this requires recreating the paperclip container — docker fixes
# published ports at container-create time.
#DEVENV_HTTP_BIND=0.0.0.0

# The published preview port range. Compose defaults these to 21000 / 16 /
# 21015; set them only to move the range (a second stack on this host must).
# BASE and RANGE_END are two sources for one fact and compose cannot do
# arithmetic, so RANGE_END must equal BASE + COUNT - 1 by hand — the paperclip
# entrypoint warns when they disagree. Keep BASE below 32768: above the kernel
# ephemeral floor, a `bind(0)` elsewhere can steal a port that is leased but
# not currently listening.
#DEVENV_HTTP_PORT_BASE=21000
#DEVENV_HTTP_PORT_COUNT=16
#DEVENV_HTTP_PORT_RANGE_END=21015

# The host DEV_URL advertises to the browser. Leave empty: it is derived from
# PAPERCLIP_PUBLIC_URL, so the stack's address is configured once. Set it only
# when the preview must be reached at a different name than the board.
#DEVENV_HTTP_PUBLIC_HOST=
