+/// Zip the formatted prompt sections with their `_meta` payloads and prepend
+/// the slash-command pass-through block, if any.
+///
+/// Single source of truth for the `session/prompt` block order, because the
+/// blocks carry per-section provenance: the slash command goes FIRST (connectors
+/// detect commands via `prompt[0].text.startsWith("/")`) with no metadata — it is
+/// a local command, not an event — and every section follows in order.
+/// Reordering here would silently re-attribute `_meta` to the wrong block.
+///
+/// `metas` is positionally parallel to `sections`; both come from
+/// [`crate::queue::format_prompt_with_meta`] or from their single-element
+/// heartbeat equivalents.
+pub(crate) fn prompt_blocks_with_slash<'a>(
+    slash_command: Option<&'a str>,
+    sections: &'a [String],
+    metas: &'a [Option<serde_json::Value>],
+) -> Vec<PromptBlock<'a>> {
+    debug_assert_eq!(
+        sections.len(),
+        metas.len(),
+        "every prompt section must carry exactly one meta slot"
+    );
+    let bodies = sections
+        .iter()
+        .zip(metas.iter())
+        .map(|(text, meta)| (text.as_str(), meta.as_ref()));
+    match slash_command {
+        Some(command) => std::iter::once((command, None)).chain(bodies).collect(),
+        None => bodies.collect(),
+    }
+}
