+"""Opt-in shared-home Unix transports for the existing native session authority.
+
+Only transport is shared: control handlers, ticket minting/redemption and the native
+HTTP/WebSocket security policy remain those of the ordinary gateway bootstrap.
+"""
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import ipaddress
+import os
+from pathlib import Path
+import socket
+import stat
+import struct
+from urllib.parse import urlsplit
+
+from gateway.control_socket import GatewayControlServer
+from gateway.runtime_ownership import process_ownership
+
+_CHUNK_BYTES = 64 * 1024
+
+
+def _require_home(home: Path) -> None:
+    from hermes_cli.gateway_runtime_discovery import home_mode_unsafe
+    info = home.lstat()
+    if (not process_ownership.owns(home) or home.absolute() != home.resolve()
+            or not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid()
+            or home_mode_unsafe(info, home)):
+        raise PermissionError(f'shared native transport requires owned private profile home: {home}')
+
+
+def _remove_socket(path: Path, identity) -> None:
+    with contextlib.suppress(OSError):
+        info = path.lstat()
+        if (info.st_dev, info.st_ino) == identity:
+            path.unlink()
+
+
+def _prepare_socket(path: Path) -> None:
+    # Ownership of gateway.lock was checked first; only our UID's stale socket
+    # may be replaced, never a symlink or an unrelated file.
+    try:
+        info = path.lstat()
+    except FileNotFoundError:
+        return
+    if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid():
+        raise PermissionError(f'unsafe shared native socket: {path}')
+    _remove_socket(path, (info.st_dev, info.st_ino))
+
+
+class _SecondaryControl(GatewayControlServer):
+    """An extra transport for the root control authority, not a new ticket store."""
+
+    def __init__(self, home, root):
+        super().__init__(home)
+        self._handlers = root._handlers
+        self.private_handlers = root.private_handlers
+        self.ticket_store = root.ticket_store
+        self._connections = set()
+
+    async def _handle_connection(self, reader, writer):
+        task = asyncio.current_task()
+        self._connections.add(task)
+        try:
+            await super()._handle_connection(reader, writer)
+        finally:
+            self._connections.discard(task)
+
+    async def stop(self):
+        # Stop accepting before cancelling peers; Server.wait_closed waits for them.
+        if self._server is not None:
+            self._server.close()
+        tasks = list(self._connections)
+        for task in tasks:
+            task.cancel()
+        if tasks:
+            await asyncio.gather(*tasks, return_exceptions=True)
+        # This listener borrows the root store; never revoke the owner's tickets.
+        self.ticket_store = None
+        await super().stop()
+
+
+class _ProfileTransport:
+    def __init__(self, home, target):
+        self.home = home
+        self.path = home / 'gateway.api.sock'
+        self.target = target
+        self.identity = None
+        self.server = None
+        self.control = None
+        self.tasks = set()
+
+    async def start(self, root):
+        _require_home(self.home)
+        _prepare_socket(self.path)
+        listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        try:
+            # No await between restrictive creation and chmod; umask never leaks
+            # into another coroutine, and the socket is private from its creation.
+            old_umask = os.umask(0o177)
+            try:
+                listener.bind(str(self.path))
+            finally:
+                os.umask(old_umask)
+            info = self.path.lstat()
+            self.identity = (info.st_dev, info.st_ino)
+            os.chmod(self.path, 0o600)
+            listener.setblocking(False)
+            self.server = await asyncio.start_unix_server(self._accept, sock=listener)
+        except BaseException:
+            listener.close()
+            raise
+        if self.home != root._home:
+            # A temp-dir fallback isn't visible across the isolated containers.
+            control_path = self.home / 'gateway.sock'
+            if len(str(control_path).encode()) > 100:
+                raise ValueError('shared native control socket path exceeds Unix path limit')
+            _require_home(self.home)
+            _prepare_socket(control_path)
+            self.control = _SecondaryControl(self.home, root)
+            if not await self.control.start():
+                raise RuntimeError(f'shared native control listener unavailable: {self.home}')
+
+    def _accept(self, reader, writer):
+        task = asyncio.create_task(self._relay(reader, writer))
+        self.tasks.add(task)
+        task.add_done_callback(self.tasks.discard)
+
+    async def _relay(self, reader, writer):
+        upstream = None
+        pumps = []
+        try:
+            peer = writer.get_extra_info('socket')
+            credentials = peer.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize('3i'))
+            _pid, uid, _gid = struct.unpack('3i', credentials)
+            if uid != os.getuid():
+                return
+            upstream_reader, upstream = await asyncio.open_connection(*self.target)
+
+            async def copy(source, destination):
+                while data := await source.read(_CHUNK_BYTES):
+                    destination.write(data)
+                    await destination.drain()
+
+            pumps = [asyncio.create_task(copy(reader, upstream)),
+                     asyncio.create_task(copy(upstream_reader, writer))]
+            # EOF or failure in either direction ends this single native connection.
+            await asyncio.wait(pumps, return_when=asyncio.FIRST_COMPLETED)
+        except (OSError, ConnectionError):
+            pass
+        finally:
+            for task in pumps:
+                task.cancel()
+            if pumps:
+                await asyncio.gather(*pumps, return_exceptions=True)
+            for stream in (writer, upstream):
+                if stream is not None:
+                    stream.close()
+            for stream in (writer, upstream):
+                if stream is not None:
+                    with contextlib.suppress(OSError, ConnectionError):
+                        await stream.wait_closed()
+
+    async def stop(self):
+        if self.server is not None:
+            self.server.close()
+        tasks = list(self.tasks)
+        for task in tasks:
+            task.cancel()
+        if tasks:
+            await asyncio.gather(*tasks, return_exceptions=True)
+        if self.server is not None:
+            await self.server.wait_closed()
+            self.server = None
+        if self.control is not None:
+            await self.control.stop()
+            self.control = None
+        _remove_socket(self.path, self.identity)
+        self.identity = None
+
+
+class _SharedNative:
+    def __init__(self, runner):
+        self.runner = runner
+        self.transports = {}
+        self.lock = asyncio.Lock()
+
+    async def sync(self):
+        async with self.lock:
+            root = self.runner.session_control_server
+            origin = urlsplit(self.runner.session_api.api_origin)
+            # Resolve no caller-controlled hostnames, and never forward to an
+            # arbitrary target. Each relay is pinned to this runner's bound API.
+            if (origin.scheme != 'http' or origin.username is not None
+                    or origin.password is not None or origin.path not in ('', '/')
+                    or origin.query or origin.fragment or origin.port is None
+                    or not ipaddress.ip_address(origin.hostname).is_loopback):
+                raise ValueError('shared native API origin must be a literal loopback HTTP endpoint')
+            target = (origin.hostname, origin.port)
+            homes = {Path(a.profile_id).resolve() for a in self.runner.session_authorities.serving()}
+            for home in list(self.transports):
+                if home not in homes:
+                    await self.transports.pop(home).stop()
+            created = []
+            try:
+                for home in sorted(homes):
+                    _require_home(home)
+                    if home in self.transports:
+                        if self.transports[home].target != target:
+                            raise RuntimeError('shared native API endpoint changed while serving')
+                        continue
+                    transport = _ProfileTransport(home, target)
+                    # Register before awaiting so partial startup is always torn down.
+                    created.append(transport)
+                    await transport.start(root)
+                    self.transports[home] = transport
+            except BaseException:
+                for transport in reversed(created):
+                    self.transports.pop(transport.home, None)
+                    await transport.stop()
+                raise
+
+    async def stop(self):
+        async with self.lock:
+            transports, self.transports = self.transports, {}
+            for transport in transports.values():
+                await transport.stop()
+
+
+async def sync_shared_native(runner):
+    """Reconcile private transports with the currently serving, reserved homes."""
+    if os.environ.get('OPC_HERMES_SHARED_NATIVE') != '1':
+        return
+    if os.name != 'posix' or not hasattr(socket, 'SO_PEERCRED'):
+        raise RuntimeError('shared native transport requires Unix SO_PEERCRED')
+    if getattr(runner, 'session_api', None) is None:
+        return
+    manager = getattr(runner, '_opc_shared_native', None)
+    if manager is None:
+        manager = runner._opc_shared_native = _SharedNative(runner)
+    await manager.sync()
+
+
+async def stop_shared_native(runner):
+    """Close all listeners and cancel relays before the native API is stopped."""
+    manager = getattr(runner, '_opc_shared_native', None)
+    if manager is not None:
+        await manager.stop()
