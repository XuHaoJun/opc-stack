#!/bin/sh
# devenv — development environment resource leases for Paperclip agents.
#
#   devenv provision <key> [--with postgres,valkey,http[=N]] [--lifecycle keep] [--env-file PATH]
#   devenv release   <key>
#   devenv list
#
# Design notes live in
# docs/superpowers/specs/2026-08-18-devenv-resource-provisioning-design.md.
# Short version: agents get isolated backends with ONE idempotent command and
# read them back from .env under standard names (DATABASE_URL / VALKEY_URL),
# so the application never learns devenv exists.
#
# Reclamation is manual (`devenv release`). Accumulation is made visible by the
# devenv_usage view rather than by a reaper — see the spec's "監控" section.
#
# Exit codes: 0 ok / 2 bad usage / 3 resources exhausted / 4 backend unreachable
set -eu

DEVENV_LIB="${DEVENV_LIB:-/usr/local/lib/devenv}"

DEVENV_PG_HOST="${DEVENV_PG_HOST:-devenv-pg}"
DEVENV_PG_PORT="${DEVENV_PG_PORT:-5432}"
DEVENV_PG_ADMIN_USER="${DEVENV_PG_ADMIN_USER:-postgres}"
DEVENV_PG_ADMIN_PASSWORD="${DEVENV_PG_ADMIN_PASSWORD:-}"
DEVENV_CONTROL_DB="${DEVENV_CONTROL_DB:-devenv_control}"

DEVENV_VALKEY_HOST="${DEVENV_VALKEY_HOST:-devenv-valkey}"
DEVENV_VALKEY_PORT="${DEVENV_VALKEY_PORT:-6379}"
DEVENV_VALKEY_PASSWORD="${DEVENV_VALKEY_PASSWORD:-}"
# Slot 0 is reserved for devenv itself, so usable ids are 1..DATABASES-1.
DEVENV_VALKEY_DATABASES="${DEVENV_VALKEY_DATABASES:-64}"

DEVENV_SECRET_SALT="${DEVENV_SECRET_SALT:-}"

# Preview-port pool. Static by necessity: docker fixes published ports when the
# container is created, so the range is declared in docker-compose.yml and only
# the allocation inside it is dynamic. See providers/http.sh for why the base
# must stay below the kernel's ephemeral range.
DEVENV_HTTP_PORT_BASE="${DEVENV_HTTP_PORT_BASE:-21000}"
DEVENV_HTTP_PORT_COUNT="${DEVENV_HTTP_PORT_COUNT:-16}"

die()   { echo "devenv: $1" >&2; exit "${2:-1}"; }
note()  { echo "$1" >&2; }

# Truths devenv shares with podenv (env merge, password derivation, owner
# attribution, the reserved .env names, the provider image families). One
# file, two CLIs — see shared.sh's header for why. Sourced AFTER die()/note()
# are defined: devenv_derive_password calls die() with exit 4 (backend
# unreachable, the documented code for "cannot proceed"), and shared.sh must
# not be forced into a special-cased `return 1` just because it is sourced
# before this CLI's own die() exists.
. "$DEVENV_LIB/shared.sh"

# ── backend access ───────────────────────────────────────────────────────

devenv_psql() {
    # -w: never prompt for a password. A missing/wrong credential must fail
    # fast — an interactive prompt would hang a non-interactive agent run
    # forever, with no output explaining why.
    # client_min_messages=warning: idempotent DDL emits "already exists"
    # NOTICEs on every re-run, which would drown the one line the caller cares
    # about (provisioned / existing).
    PGPASSWORD="$DEVENV_PG_ADMIN_PASSWORD" \
    PGOPTIONS='-c client_min_messages=warning' psql \
        -h "$DEVENV_PG_HOST" -p "$DEVENV_PG_PORT" -U "$DEVENV_PG_ADMIN_USER" \
        -w -q "$@"
}
devenv_psql_admin()   { devenv_psql -d postgres "$@"; }
devenv_psql_control() { devenv_psql -d "$DEVENV_CONTROL_DB" "$@"; }

devenv_valkey_admin() {
    if [ -n "$DEVENV_VALKEY_PASSWORD" ]; then
        redis-cli -h "$DEVENV_VALKEY_HOST" -p "$DEVENV_VALKEY_PORT" \
            -a "$DEVENV_VALKEY_PASSWORD" --no-auth-warning "$@"
    else
        redis-cli -h "$DEVENV_VALKEY_HOST" -p "$DEVENV_VALKEY_PORT" "$@"
    fi
}

# ── helpers shared with providers ────────────────────────────────────────

# The control registry (database devenv_control + table devenv_tenant) is
# created by opc-devenv-seed.sh, never by this CLI. When it is absent, every
# command below reaches it through a different door and each door tells a
# different, wrong story: `provision` dies on the INSERT with psql's raw
# "database ... does not exist", and if the database exists but the table does
# not, devenv_valkey_db_alloc's registry read comes back empty and the CLI
# reports `no free valkey database id (cap N) — run 'devenv list' and release
# one`. That reads as slot exhaustion and sends the operator to release leases
# that are not the problem. Ask once, up front, and name the real cause.
devenv_require_control_schema() {
    devenv_psql_control -tAc 'SELECT 1 FROM devenv_tenant LIMIT 1' >/dev/null 2>&1 && return 0
    die "devenv control schema not ready — database '$DEVENV_CONTROL_DB' or table devenv_tenant is missing on $DEVENV_PG_HOST:$DEVENV_PG_PORT. It is created by opc-devenv-seed.sh (paperclip's entrypoint, and the devenv-expert-leases one-shot). This is NOT resource exhaustion; releasing leases will not help." 4
}

devenv_registry_get() {
    devenv_psql_control -tAc \
        "SELECT COALESCE($2::text,'') FROM devenv_tenant WHERE key = '$1'" 2>/dev/null || true
}

# Smallest free id in 1..N-1. UNIQUE(valkey_db) makes the DB the arbiter, so
# concurrent callers race harmlessly — the loser retries.
devenv_valkey_db_alloc() {
    _alloc_key="$1"
    _alloc_existing="$(devenv_registry_get "$_alloc_key" valkey_db)"
    if [ -n "$_alloc_existing" ]; then echo "$_alloc_existing"; return 0; fi

    _alloc_n="$(devenv_psql_control -tAc "
        SELECT n FROM generate_series(1, $((DEVENV_VALKEY_DATABASES - 1))) AS n
        WHERE NOT EXISTS (SELECT 1 FROM devenv_tenant t WHERE t.valkey_db = n)
        ORDER BY n LIMIT 1")"
    _alloc_n="$(echo "$_alloc_n" | tr -d '[:space:]')"
    [ -n "$_alloc_n" ] || die "no free valkey database id (cap $((DEVENV_VALKEY_DATABASES - 1))) — run 'devenv list' and release one" 3
    echo "$_alloc_n"
}

devenv_slug() {
    echo "devenv_$(echo "$1" | tr '-' '_')"
}

for _p in "$DEVENV_LIB"/providers/*.sh; do
    [ -f "$_p" ] && . "$_p"
done

# ── commands ─────────────────────────────────────────────────────────────

# EXIT trap for provision. Must re-raise the original status: a trap that
# returns normally would turn a failed provision into exit 0.
devenv_provision_cleanup() {
    _pc_rc=$?
    rm -f "${out_file:-}" 2>/dev/null || true
    if [ "$_pc_rc" -ne 0 ] && [ "${created_now:-0}" = 1 ]; then
        devenv_teardown "$key" "$slug" 2>/dev/null || true
        note "devenv: rolled back '$key' (provision failed, nothing was left registered)"
    fi
    exit "$_pc_rc"
}

# Idempotent teardown of every provider plus the registry row. Shared by
# `release` and by provision's rollback so the two can never drift.
devenv_teardown() {
    _td_key="$1"; _td_slug="$2"
    valkey_release   "$_td_key" "$_td_slug"
    http_release     "$_td_key" "$_td_slug"
    postgres_release "$_td_key" "$_td_slug"
    devenv_psql_control -c "DELETE FROM devenv_tenant WHERE key = '$_td_key'" >/dev/null
}

cmd_provision() {
    key=""; with="postgres,valkey"; lifecycle="keep"; env_file="$PWD/.env"
    while [ $# -gt 0 ]; do
        case "$1" in
            --with)      with="${2:?--with needs a value}"; shift 2 ;;
            --lifecycle) lifecycle="${2:?--lifecycle needs a value}"; shift 2 ;;
            --env-file)  env_file="${2:?--env-file needs a value}"; shift 2 ;;
            -*)          die "unknown flag: $1" 2 ;;
            *)           [ -z "$key" ] || die "unexpected argument: $1" 2; key="$1"; shift ;;
        esac
    done
    [ -n "$key" ] || die "usage: devenv provision <key> [--with ...] [--env-file PATH]" 2
    echo "$key" | grep -Eq '^[a-z][a-z0-9-]{1,40}$' \
        || die "invalid key '$key' — must match ^[a-z][a-z0-9-]{1,40}\$" 2
    [ "$lifecycle" = "keep" ] \
        || die "lifecycle '$lifecycle' is not implemented (only 'keep')" 2

    slug="$(devenv_slug "$key")"

    # A provider entry is `name` or `name=arg`. Only http takes an arg (how
    # many contiguous ports); anything else carrying one is an error rather
    # than a silently ignored argument.
    providers=""
    for spec in $(echo "$with" | tr ',' ' '); do
        prov="${spec%%=*}"
        arg=""
        [ "$spec" = "$prov" ] || arg="${spec#*=}"
        case "$prov" in
            postgres|valkey)
                [ -z "$arg" ] || die "provider '$prov' takes no '=' argument" 2 ;;
            http)
                if [ -n "$arg" ]; then
                    echo "$arg" | grep -Eq '^[1-9][0-9]*$' \
                        || die "http port count must be a positive integer, got '$arg'" 2
                    [ "$arg" -le "$DEVENV_HTTP_PORT_COUNT" ] \
                        || die "http=$arg exceeds the pool size $DEVENV_HTTP_PORT_COUNT (DEVENV_HTTP_PORT_COUNT)" 3
                    DEVENV_HTTP_COUNT="$arg"
                else
                    DEVENV_HTTP_COUNT=1
                fi
                export DEVENV_HTTP_COUNT ;;
            *) die "unknown provider '$prov' (known: postgres, valkey, http)" 2 ;;
        esac
        providers="$providers $prov"
    done
    providers="$(echo "$providers" | tr -s ' ' | sed 's/^ //;s/ $//')"
    [ -n "$providers" ] || die "--with listed no providers" 2

    postgres_probe || die "devenv-pg unreachable at $DEVENV_PG_HOST:$DEVENV_PG_PORT" 4
    devenv_require_control_schema
    case " $providers " in *" valkey "*)
        valkey_probe || die "devenv-valkey unreachable at $DEVENV_VALKEY_HOST:$DEVENV_VALKEY_PORT" 4 ;;
    esac

    existing="$(devenv_registry_get "$key" key)"

    # Register before creating: the row is what makes the valkey id and the
    # http port block exclusive, so it has to exist before anything can be
    # allocated against it.
    #
    # The cost is that a provision which fails partway (an exhausted pool is
    # the realistic case, not a crash) leaves a resource-less row behind, which
    # then shows up in `devenv list` forever as a lease nobody can explain.
    # The EXIT trap below rolls it back — but ONLY when this invocation created
    # it. Re-provisioning an existing lease must never tear down live
    # databases just because one provider had a bad day.
    created_now=0
    if [ -z "$existing" ]; then
        created_now=1
        devenv_psql_control -v ON_ERROR_STOP=1 -c "
            INSERT INTO devenv_tenant (key, slug, lifecycle, providers, created_by)
            VALUES ('$key', '$slug', '$lifecycle',
                    ARRAY[$(echo "$providers" | sed "s/[^ ]*/'&'/g" | tr ' ' ',')],
                    '$(devenv_owner)')" >/dev/null
    else
        devenv_psql_control -c \
            "UPDATE devenv_tenant SET last_seen_at = now() WHERE key = '$key'" >/dev/null
    fi

    out_file="$(mktemp)"
    trap 'devenv_provision_cleanup' EXIT INT TERM
    echo "DEVENV_KEY=$key" > "$out_file"
    for prov in $providers; do
        out="$("${prov}_provision" "$key" "$slug")"
        if [ "$prov" = valkey ]; then
            db="$(echo "$out" | sed 's#.*/##')"
            devenv_psql_control -v ON_ERROR_STOP=1 -c \
                "UPDATE devenv_tenant SET valkey_db = $db WHERE key = '$key'" >/dev/null
        fi
        printf '%s\n' "$out" >> "$out_file"
    done

    devenv_env_merge "$env_file" "$out_file"

    if [ -n "$existing" ]; then
        note "devenv: '$key' (existing) → $env_file"
    else
        note "devenv: '$key' provisioned → $env_file"
    fi
    cat "$out_file"
}

cmd_release() {
    key="${1:?usage: devenv release <key>}"
    postgres_probe || die "devenv-pg unreachable at $DEVENV_PG_HOST:$DEVENV_PG_PORT" 4
    if [ -z "$(devenv_registry_get "$key" key)" ]; then
        note "devenv: '$key' (absent)"; return 0
    fi
    slug="$(devenv_slug "$key")"

    # Warn BEFORE the row goes away, while the registry can still tell us the
    # lease had an exposed preview port. Releasing frees that port for the next
    # tenant, and a process still listening on it would make that tenant's
    # service fail to start — with a "port in use" error pointing at a lease
    # that no longer exists, which is a miserable thing to debug.
    _rel_port="$(devenv_registry_get "$key" http_port_start)"
    _rel_exposed="$(devenv_registry_get "$key" http_exposed_at)"
    if [ -n "$_rel_port" ] && [ -n "$_rel_exposed" ]; then
        note "devenv: WARNING '$key' had an exposed service on port $_rel_port."
        note "devenv:   The port is being returned to the pool, but any process still"
        note "devenv:   listening on it will break the next tenant. Stop the service"
        note "devenv:   from the Paperclip board (workspace → runtime services) if it"
        note "devenv:   is still running."
    fi

    devenv_teardown "$key" "$slug"
    note "devenv: '$key' released"
}

# Set by the `prototype` CLI after it registers a service with Paperclip.
# devenv itself never talks to paperclip; it just records that someone did, so
# `devenv list` can flag a port that was leased and then forgotten.
cmd_mark_exposed() {
    key="${1:?usage: devenv mark-exposed <key>}"
    postgres_probe || die "devenv-pg unreachable at $DEVENV_PG_HOST:$DEVENV_PG_PORT" 4
    [ -n "$(devenv_registry_get "$key" key)" ] || die "no lease named '$key'" 2
    devenv_psql_control -v ON_ERROR_STOP=1 -c \
        "UPDATE devenv_tenant SET http_exposed_at = now(), last_seen_at = now()
          WHERE key = '$key'" >/dev/null
}

cmd_list() {
    postgres_probe || die "devenv-pg unreachable at $DEVENV_PG_HOST:$DEVENV_PG_PORT" 4
    devenv_require_control_schema
    # Same view the humans query from a SQL client — one definition, no drift.
    devenv_psql_control -c \
        "SELECT key, created_by, pg_size, valkey_db,
                CASE WHEN http_port_start IS NULL THEN NULL
                     WHEN http_port_count > 1
                       THEN http_port_start || '-' || (http_port_start + http_port_count - 1)
                     ELSE http_port_start::text END
                  || CASE WHEN http_unexposed THEN ' !' ELSE '' END  AS ports,
                date_trunc('second', idle) AS idle
         FROM devenv_usage"
    # '!' = port leased but `devenv expose` never ran, so nothing is serving it.
    note "  ports '!' = leased but not exposed (run: devenv expose <name> --command ...)"

    # podenv leases live in the same database in their own table (devenv_tenant
    # is one-column-per-provider; carrying podenv's columns here would make
    # devenv's schema hold podenv's concepts). Guarded by to_regclass so devenv
    # keeps working unchanged when podenv is not installed — this is the ONE
    # line of coupling that buys a single place to look at what is occupied.
    #
    # Guard on podenv_usage (the VIEW actually queried below), not podenv_lease
    # (the TABLE): opc-podenv-seed.sh applies bootstrap.sql with
    # ON_ERROR_STOP=1 but no --single-transaction, so "table created, view
    # failed" is a reachable state that persists across boots. Guarding on the
    # table and querying the view would let that state reach a plain command
    # inside this if's BODY — which set -eu does NOT exempt from aborting the
    # whole command — destroying visibility into every lease, devenv's
    # included. A visibility tool must degrade to a warning here, never to a
    # crash.
    if [ "$(devenv_psql_control -tAc \
            "SELECT to_regclass('podenv_usage') IS NOT NULL" 2>/dev/null \
            | tr -d '[:space:]')" = "t" ]; then
        echo
        echo "podenv leases (nested containers):"
        devenv_psql_control -c \
            "SELECT key, image, netns, host_port, env_var,
                    CASE WHEN dedicated_reason IS NULL THEN ''
                         ELSE 'dedicated: ' || dedicated_reason END AS dedicated,
                    date_trunc('second', idle) AS idle
             FROM podenv_usage" \
            || note "devenv: WARNING podenv_usage query failed — podenv section skipped (see below)"
    elif [ "$(devenv_psql_control -tAc \
            "SELECT to_regclass('podenv_lease') IS NOT NULL" 2>/dev/null \
            | tr -d '[:space:]')" = "t" ]; then
        # podenv_lease exists but podenv_usage does not: exactly the partial
        # state above. Name it instead of silently skipping the section.
        note "devenv: WARNING podenv_lease exists but podenv_usage view is missing — podenv section skipped. Schema is partially applied; rerun opc-podenv-seed.sh (docker compose exec paperclip sh -c '. /usr/local/bin/opc-podenv-seed.sh; opc_podenv_seed_schema')."
    fi
}

case "${1:-}" in
    provision)    shift; cmd_provision    "$@" ;;
    release)      shift; cmd_release      "$@" ;;
    list)         shift; cmd_list         "$@" ;;
    mark-exposed) shift; cmd_mark_exposed "$@" ;;
    -h|--help|help|"")
        sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$1' (provision|release|list|mark-exposed)" 2 ;;
esac
