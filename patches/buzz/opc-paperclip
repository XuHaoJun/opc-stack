#!/bin/sh
set -eu

DEFAULT_API_URL=http://paperclip:3100

die() { printf 'opc-paperclip: %s\n' "$1" >&2; exit "${2:-1}"; }

api_base() {
    _base="${PAPERCLIP_API_URL:-$DEFAULT_API_URL}"
    _base="${_base%/}"
    _base="${_base%/api}"
    printf '%s\n' "$_base"
}

api_key() {
    if [ -n "${PAPERCLIP_API_KEY:-}" ]; then
        printf '%s\n' "$PAPERCLIP_API_KEY"
        return
    fi
    _mirror="${HERMES_HOME:-/opt/data}/.paperclip-api.key"
    [ -s "$_mirror" ] || die "no runtime-readable Paperclip credential" 4
    cat "$_mirror"
}

api_request() { # METHOD PATH [JSON]
    _method="$1"
    _path="$2"
    _body="${3-}"
    if [ -n "$_body" ]; then
        curl -fsS -X "$_method" -H "Authorization: Bearer $(api_key)" \
            -H 'Content-Type: application/json' --data-binary "$_body" \
            "$(api_base)/api$_path"
    else
        curl -fsS -X "$_method" -H "Authorization: Bearer $(api_key)" \
            "$(api_base)/api$_path"
    fi
}

# Like api_request but keeps the response body on non-2xx: prints the body on
# stdout and returns 1. Paperclip reports start failures (bind errors, a
# repo without .paperclip/preview) only in the error body, which curl -f drops.
api_request_body() { # METHOD PATH JSON
    _rb_file="$(mktemp "${TMPDIR:-/tmp}/opc-paperclip-resp.XXXXXX")" || return 1
    _rb_code="$(curl -sS -o "$_rb_file" -w '%{http_code}' -X "$1" \
        -H "Authorization: Bearer $(api_key)" -H 'Content-Type: application/json' \
        --data-binary "$3" "$(api_base)/api$2")" || { rm -f "$_rb_file"; return 1; }
    cat "$_rb_file"
    rm -f "$_rb_file"
    case "$_rb_code" in 2??) return 0 ;; *) return 1 ;; esac
}

preview_error_text() { # raw response body → short human text
    printf '%s' "$1" | jq -r '.error // empty' 2>/dev/null | head -c 600
}

canonical_repo_json() {
    _raw="$1"
    _kind=short
    case "$_raw" in
        git@github.com:*) _path="${_raw#git@github.com:}"; _kind=url ;;
        ssh://git@github.com/*) _path="${_raw#ssh://git@github.com/}"; _kind=url ;;
        https://github.com/*) _path="${_raw#https://github.com/}"; _kind=url ;;
        */*) _path="$_raw" ;;
        *) die "unsupported repository identity: $_raw" 2 ;;
    esac
    if [ "$_kind" = url ]; then
        case "$_path" in
            */) _path="${_path%/}" ;;
        esac
    else
        case "$_path" in
            ""|/*|*/|*//*|*@*|*:*|*[\?\#\%\&\;]*)
                die "unsupported repository identity: $_raw" 2 ;;
        esac
    fi
    _path="${_path%.git}"
    _owner="${_path%%/*}"
    _repo="${_path#*/}"
    [ -n "$_owner" ] && [ -n "$_repo" ] && [ "${_repo#*/}" = "$_repo" ] ||
        die "repository must be exactly owner/repo" 2
    case "$_owner" in
        *.*|*[!A-Za-z0-9_-]*) die "unsupported repository identity: $_raw" 2 ;;
    esac
    case "$_repo" in
        *[!A-Za-z0-9._-]*) die "unsupported repository identity: $_raw" 2 ;;
    esac
    _owner_lc="$(printf '%s' "$_owner" | tr '[:upper:]' '[:lower:]')"
    _repo_lc="$(printf '%s' "$_repo" | tr '[:upper:]' '[:lower:]')"
    jq -nc --arg i "github.com/$_owner_lc/$_repo_lc" \
        --arg u "https://github.com/$_owner_lc/$_repo_lc" \
        --arg o "$_owner_lc" --arg r "$_repo_lc" \
        '{identity:$i,repoUrl:$u,owner:$o,repo:$r}'
}

company_id() {
    if [ -n "${PAPERCLIP_COMPANY_ID:-}" ]; then
        printf '%s\n' "$PAPERCLIP_COMPANY_ID"
        return
    fi
    _companies="$(api_request GET /companies)" || die "failed to list Paperclip companies" 4
    _count="$(printf '%s' "$_companies" | jq -r 'if type == "array" then length else 0 end' 2>/dev/null)" ||
        die "Paperclip companies response is not an array" 4
    [ "$_count" -eq 1 ] || die "expected exactly one Paperclip company, found $_count" 4
    printf '%s\n' "$_companies" | jq -r '.[0].id // empty' \
        | { IFS= read -r _id; [ -n "$_id" ] || die "Paperclip company has no id" 4; printf '%s\n' "$_id"; }
}

list_projects() {
    _company="${1-}"
    [ -n "$_company" ] || _company="$(company_id)"
    api_request GET "/companies/$_company/projects"
}

primary_workspace_json() {
    if [ "$#" -gt 0 ]; then
        _project="$1"
    else
        _project="$(cat)"
    fi
    if [ "$(printf '%s' "$_project" | jq -r 'if (.primaryWorkspace? | type) == "object" then 1 else 0 end')" -eq 1 ]; then
        printf '%s' "$_project" | jq -c '.primaryWorkspace'
        return
    fi
    _primary_count="$(printf '%s' "$_project" | jq '[.workspaces // [] | .[] | select(.isPrimary == true)] | length')"
    case "$_primary_count" in
        0) printf '%s\n' null ;;
        1) printf '%s' "$_project" | jq -c '(.workspaces // [])[] | select(.isPrimary == true)' ;;
        *) die "multiple primary workspaces ($_primary_count); expected exactly one" 3 ;;
    esac
}

unique_project_by_repo() {
    case "$1" in
        \{*) _canonical="$1" ;;
        *) _canonical="$(canonical_repo_json "$1")" ;;
    esac
    _identity="$(printf '%s' "$_canonical" | jq -r '.identity')"
    _projects="$(list_projects)" || die "failed to list Paperclip projects" 4
    _matches="$(printf '%s' "$_projects" | jq -c '.[]')"
    _found=''
    while IFS= read -r _project; do
        [ -n "$_project" ] || continue
        _workspace="$(primary_workspace_json "$_project")"
        [ "$_workspace" != null ] || continue
        _url="$(printf '%s' "$_workspace" | jq -r '.repoUrl // empty')"
        [ -n "$_url" ] || continue
        if _live_identity="$(canonical_repo_json "$_url" 2>/dev/null | jq -r '.identity')"; then
            if [ "$_live_identity" = "$_identity" ]; then
                _found="${_found}${_project}
"
            fi
        fi
    done <<EOF
$_matches
EOF
    _count="$(printf '%s' "$_found" | sed '/^$/d' | wc -l)"
    if [ "$_count" -gt 1 ]; then
        _details="$(printf '%s' "$_found" | sed '/^$/d' | jq -r '"\(.id // "<no-id>") \(.name // "<unnamed>")"')" ||
            die "failed to format duplicate Paperclip projects" 4
        _details="$(printf '%s\n' "$_details" | tr '\n' ';' | sed 's/;$//')"
        die "multiple Paperclip projects match $_identity: $_details" 3
    fi
    if [ "$_count" -eq 1 ]; then
        printf '%s' "$_found" | sed '/^$/d' | jq -c .
    fi
}

verify_json_field() {
    [ "$#" -ge 3 ] || die "verify_json_field requires JSON, jq filter, and expected value" 2
    _json="$1"
    _filter="$2"
    _expected="$3"
    _actual="$(printf '%s' "$_json" | jq -c "$_filter")" || die "invalid JSON verification response" 4
    _want="$(printf '%s' "$_expected" | jq -c . 2>/dev/null || jq -nc --arg value "$_expected" '$value')"
    [ "$_actual" = "$_want" ] || die "Paperclip response field $_filter was $_actual, expected $_want" 4
}

validate_buzz_origin() {
    if [ -n "$1" ] || [ -n "$2" ]; then
        [ -n "$1" ] && [ -n "$2" ] ||
            die "--buzz-channel and --buzz-event must be supplied together" 2
    fi
}

create_ticket_json() { # company payload buzz-channel buzz-event
    _origin_company="$1"
    _origin_payload="$2"
    _origin_channel="$3"
    _origin_event="$4"
    if [ -z "$_origin_channel" ]; then
        api_request POST "/companies/$_origin_company/issues" "$_origin_payload"
        return
    fi
    _origin_agent="$(printf '%s' "$_origin_payload" | jq -r '.assigneeAgentId')"
    _origin_status="$(printf '%s' "$_origin_payload" | jq -r '.status // "todo"')"
    _origin_draft="$(printf '%s' "$_origin_payload" |
        jq -c '.assigneeAgentId=null | .status="backlog"')"
    _origin_created="$(api_request POST "/companies/$_origin_company/issues" "$_origin_draft")" ||
        die "failed to create unassigned Buzz ticket draft" 4
    _origin_id="$(printf '%s' "$_origin_created" | jq -r '.id // empty')"
    [ -n "$_origin_id" ] || die "Paperclip draft response has no id" 4
    # An idempotent prototype replay may already be assigned. Keep its original
    # thread; posting another marker would recreate the comment-wake race.
    if printf '%s' "$_origin_created" | jq -e --arg agent "$_origin_agent" \
        '.assigneeAgentId == $agent' >/dev/null; then
        printf '%s\n' "$_origin_created"
        return
    fi
    # Only the creator owns draft initialization. A replay can belong to
    # another concurrent caller, which may assign the issue at any moment.
    printf '%s' "$_origin_created" | jq -e '.deduplicated != true' >/dev/null ||
        die "Buzz ticket $_origin_id is an existing draft; another caller owns routing setup" 4
    printf '%s' "$_origin_created" | jq -e \
        '.assigneeAgentId == null and .status == "backlog"' >/dev/null ||
        die "Buzz ticket $_origin_id is not an unassigned backlog draft" 4
    _origin_body="$(printf 'BUZZ_CHANNEL: %s\nBUZZ_EVENT: %s' "$_origin_channel" "$_origin_event")"
    _origin_comment="$(api_request POST "/issues/$_origin_id/comments" "$(
        jq -nc --arg body "$_origin_body" '{body:$body}'
    )")" || die "routing write failed for draft $_origin_id; left unassigned in backlog" 4
    _origin_comment_id="$(printf '%s' "$_origin_comment" | jq -r '.id // empty')"
    [ -n "$_origin_comment_id" ] ||
        die "routing response missing comment id for draft $_origin_id; left unassigned in backlog" 4
    _origin_comments="$(api_request GET "/issues/$_origin_id/comments")" ||
        die "routing readback failed for draft $_origin_id; left unassigned in backlog" 4
    printf '%s' "$_origin_comments" | jq -e --arg id "$_origin_comment_id" \
        --arg body "$_origin_body" 'any(.[]; .id == $id and .body == $body)' >/dev/null ||
        die "routing verification failed for draft $_origin_id; left unassigned in backlog" 4
    api_request PATCH "/issues/$_origin_id" "$(
        jq -nc --arg agent "$_origin_agent" --arg status "$_origin_status" \
            '{assigneeAgentId:$agent,status:$status}'
    )" || die "activation failed for Buzz ticket $_origin_id; inspect its state before retrying" 4
}

FULLSTACK_MAX_CONCURRENT_RUNS_DEFAULT=4

agent_by_role() {
    _role="$1"
    _agents="$(api_request GET "/companies/$(company_id)/agents")" ||
        die "failed to list Paperclip agents" 4
    _matches="$(printf '%s' "$_agents" | jq -c --arg role "$_role" '
        if type == "array" then [.[] | select(.role == $role)] else [] end
    ' 2>/dev/null)" || die "Paperclip agents response is not an array" 4
    _count="$(printf '%s' "$_matches" | jq -r 'length')"
    case "$_count" in
        0) die "no Paperclip agent matches role $_role" 3 ;;
        1) printf '%s' "$_matches" | jq -c '.[0]' ;;
        *) die "multiple Paperclip agents match role $_role" 3 ;;
    esac
}

# ── track/style labels ──────────────────────────────────────────────────
# OPC policy reads labels, never prose. These two functions are the only writer
# of the four labels; the description markers are inputs for humans.
label_marker() { # <description-file> <Key> → value or empty
    sed -n "s/^[[:space:]]*$2[[:space:]]*:[[:space:]]*\([A-Za-z_-]*\).*/\1/p" "$1" 2>/dev/null | head -1 | tr '[:upper:]' '[:lower:]'
}

# ── admission gate ──────────────────────────────────────────────────────
# A locked track must refuse new work before anything is created. This is the
# deterministic half of the policy; the other half is Paperclip's own agent
# pause, which is what actually stops an execution from starting.
admission_check() { # <track>
    [ -n "${OPC_API_URL:-}" ] || return 0
    _key="${OPC_API_KEY:-}"
    if [ -z "$_key" ]; then
        for _f in "${HERMES_HOME:-/opt/data}/.opc-control.key" /keys/opc-control.key; do
            if [ -r "$_f" ]; then _key="$(cat "$_f")"; break; fi
        done
    fi
    [ -n "$_key" ] || die "no OPC control key available — cannot verify admission" 4
    _resp="$(curl -fsS --max-time 10 -H "Authorization: Bearer $_key" \
        "$OPC_API_URL/v1/policy/effective?track=$1" 2>/dev/null)" ||
        die "OPC policy lookup failed ($OPC_API_URL)" 4
    _locked="$(printf '%s' "$_resp" | jq -r '.values.track_locked // false')" ||
        die "OPC policy response is not JSON" 4
    [ "$_locked" != "true" ] ||
        die "track $1 is locked by the operator — no new ticket admitted (unlock it first)" 3
}

ensure_ticket_labels_json() { # <track> <style> → JSON array of label ids
    _labels="$(api_request GET "/companies/$(company_id)/labels")" ||
        die "failed to list Paperclip labels" 4
    printf '%s' "$_labels" | jq -e 'type == "array"' >/dev/null 2>&1 ||
        die "Paperclip labels response is not an array" 4
    _wanted="[\"track:$1\",\"style:$2\"]"
    _ids=""
    for _name in "track:$1" "style:$2"; do
        _id="$(printf '%s' "$_labels" | jq -r --arg n "$_name" '[.[] | select(.name == $n)][0].id // empty')"
        if [ -z "$_id" ]; then
            case "$_name" in
                track:core) _color="#2563eb" ;;
                track:lab) _color="#7c3aed" ;;
                style:blueprint) _color="#0f766e" ;;
                *) _color="#b45309" ;;
            esac
            _id="$(api_request POST "/companies/$(company_id)/labels" \
                "$(jq -nc --arg n "$_name" --arg c "$_color" '{name:$n,color:$c}')" \
                | jq -r '.id // empty')" || die "failed to create label $_name" 4
            [ -n "$_id" ] || die "Paperclip label create returned no id for $_name" 4
        fi
        _ids="${_ids}${_ids:+,}\"$_id\""
    done
    printf '[%s]' "$_ids"
}

# ── ticket preview (Paperclip runtime service named "preview") ───────────
# A code ticket's preview is a runtime service on the ticket's own execution
# workspace. Only board-key callers may write runtime-service commands, which is
# why this lives in the front door's helper and not in the engineer's skill.
preview_public_base() {
    _host="${DEVENV_HTTP_PUBLIC_HOST:-}"
    if [ -z "$_host" ] && [ -n "${PAPERCLIP_PUBLIC_URL:-}" ]; then
        _host="$(printf '%s' "$PAPERCLIP_PUBLIC_URL" | sed -e 's|^[a-zA-Z][a-zA-Z0-9+.-]*://||' -e 's|[/?#].*$||' -e 's|^[^@]*@||' -e 's|:[0-9]*$||')"
    fi
    [ -n "$_host" ] || die "no preview host: set DEVENV_HTTP_PUBLIC_HOST or PAPERCLIP_PUBLIC_URL" 4
    printf 'http://%s' "$_host"
}

preview_service_json() { # port public_base
    jq -nc --argjson port "$1" --arg base "$2" '
        {name:"preview",command:"opc-preview-run",cwd:".",port:$port,
         lifecycle:"shared",reuseScope:"execution_workspace",
         readiness:{type:"http",urlTemplate:"http://127.0.0.1:{{port}}"},
         expose:{type:"url",urlTemplate:($base + ":{{port}}")}}'
}

preview_pick_port() { # preferred-or-empty held-ports-json-array
    _base="${OPC_PREVIEW_PORT_BASE:-21012}"
    _end="${OPC_PREVIEW_PORT_END:-21015}"
    _picked="$(jq -nr --arg pref "$1" --argjson held "$2" --argjson b "$_base" --argjson e "$_end" '
        ([range($b; $e + 1)] | map(select(. as $p | $held | index($p) | not))) as $free
        | if ($pref != "" and ($free | index($pref | tonumber))) then $pref | tonumber
          else ($free[0] // empty) end')" || return 5
    [ -n "$_picked" ] || return 5
    printf '%s' "$_picked"
}

ensure_preview_label() {
    _labels="$(api_request GET "/companies/$(company_id)/labels")" ||
        die "failed to list Paperclip labels" 4
    printf '%s' "$_labels" | jq -e 'type == "array"' >/dev/null 2>&1 ||
        die "Paperclip labels response is not an array" 4
    _id="$(printf '%s' "$_labels" | jq -r '[.[] | select(.name == "preview")][0].id // empty')"
    if [ -z "$_id" ]; then
        _id="$(api_request POST "/companies/$(company_id)/labels" \
            '{"name":"preview","color":"#0891b2"}' | jq -r '.id // empty')" ||
            die "failed to create label preview" 4
        [ -n "$_id" ] || die "Paperclip label create returned no id for preview" 4
    fi
    printf '%s' "$_id"
}

# Adds the preview label to an issue JSON's labels (merged, never replaced).
preview_label_issue() { # issue-json
    _pl_label="$(ensure_preview_label)" || return 1
    _pl_id="$(printf '%s' "$1" | jq -r '.id')"
    api_request PATCH "/issues/$_pl_id" "$(printf '%s' "$1" | jq -c --arg l "$_pl_label" '
        {labelIds: ((.labelIds // [(.labels // [])[].id]) + [$l] | unique)}')" >/dev/null
}

# The workspace config (stdin: workspace JSON) with the preview service set.
# The preview entry is replaced in place (appended only when absent), so no
# other service moves away from its serviceStates key (index-keyed). Every
# index gets an explicit state: Paperclip fills a missing one from the
# workspace-wide desiredState, which the start route turns "running" — that
# would make every other service desired-running on restart and on every run.
# desiredState itself is left to Paperclip's start route.
preview_config_json() { # service-json
    jq -c --argjson svc "$1" '
        (.config // {})
        | if ((.workspaceRuntime.commands // []) | length) > 0 then error("commands") else . end
        | ((.workspaceRuntime.services // []) | map(.name) | index("preview")) as $pi
        | .workspaceRuntime = ((.workspaceRuntime // {})
            | .services = ((.services // []) as $s
                | if $pi == null then $s + [$svc] else $s | .[$pi] = $svc end))
        | (if $pi == null then (.workspaceRuntime.services | length - 1) else $pi end) as $idx
        | .serviceStates = (reduce range(0; .workspaceRuntime.services | length) as $i
            (.serviceStates // {};
             ($i | tostring) as $k
             | .[$k] = (if $i == $idx then "running" else (.[$k] // "stopped") end)))'
}

preview_probe_url() { # URL — separate function so tests can stub it
    # Only a 2xx counts; redirects are not followed, so a 302 to a login page
    # or an error page is a failure, not a green preview.
    _pc="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 10 "$1")" || return 1
    case "$_pc" in 2??) return 0 ;; *) return 1 ;; esac
}

# Where the front door can check a preview URL from. A loopback public host
# (the default PAPERCLIP_PUBLIC_URL is http://localhost:3100) names the owner's
# machine, but from inside frontdoor/hermes it names our own netns, where
# nothing listens. The published mapping is 1:1, so the same port answers on
# the paperclip container's compose name. Prints "<probe-url> <public|internal>".
preview_probe_target() { # URL
    _pt_host="$(printf '%s' "$1" | sed -e 's|^[a-zA-Z][a-zA-Z0-9+.-]*://||' -e 's|[/?#].*$||' -e 's|^[^@]*@||')"
    _pt_port="${_pt_host##*:}"
    case "$_pt_host" in
        \[*\]:*) _pt_host="${_pt_host%:*}" ;;
        \[*\]) _pt_port="" ;;
        *:*:*) _pt_port="" ;;
        *:*) _pt_host="${_pt_host%:*}" ;;
        *) _pt_port="" ;;
    esac
    case "$_pt_host" in
        localhost|127.*|\[::1\]|::1)
            [ -n "$_pt_port" ] || { printf '%s public\n' "$1"; return; }
            printf 'http://%s:%s internal\n' "${OPC_PREVIEW_INTERNAL_HOST:-paperclip}" "$_pt_port" ;;
        *) printf '%s public\n' "$1" ;;
    esac
}

# The newest runtime service named preview on a workspace JSON (stdin).
preview_service_of() {
    jq -c '[(.runtimeServices // [])[] | select(.serviceName == "preview")]
           | sort_by(.updatedAt // "") | last // empty'
}

preview_issue_json() { # OPC-N
    _pi="$(api_request GET "/issues/$1")" || die "failed to read issue $1" 4
    printf '%s' "$_pi" | jq -e '.id' >/dev/null 2>&1 || die "issue $1 not found" 4
    printf '%s' "$_pi"
}

preview_issue_arg() { # parses "--issue OPC-N" → stdout; $1.. are the args
    [ "${1-}" = --issue ] && [ "$#" -ge 2 ] || return 1
    printf '%s' "$2"
}

# Starting a service while the run that handed the ticket off is still
# finishing leaves Paperclip's record at "starting" forever (the server is
# serving, the record never turns running; measured 3/3 on v2026.1106.0). The
# in_review hand-off is exactly that moment, so wait for the issue's live runs
# to end first. A ticket still in progress keeps its long run; no wait there.
preview_wait_hand_off_run() { # issue-id
    _wr_deadline=$(( $(date +%s) + ${OPC_PREVIEW_RUN_WAIT:-120} ))
    while :; do
        _wr_live="$(api_request GET "/companies/$(company_id)/live-runs?minCount=0&limit=50")" || return 0
        [ "$(printf '%s' "$_wr_live" | jq --arg i "$1" '[.[]? | select(.issueId == $i)] | length' 2>/dev/null)" = 0 ] && return 0
        [ "$(date +%s)" -lt "$_wr_deadline" ] || return 0
        sleep "${OPC_PREVIEW_POLL_SECONDS:-2}"
    done
}

preview_up() {
    _ident="$(preview_issue_arg "$@")" || die "usage: opc-paperclip preview up --issue OPC-N" 2
    _issue="$(preview_issue_json "$_ident")" || exit $?
    _issue_id="$(printf '%s' "$_issue" | jq -r '.id')"
    if [ "$(printf '%s' "$_issue" | jq -r '.status // empty')" = in_review ]; then
        preview_wait_hand_off_run "$_issue_id"
    fi
    # A done/cancelled ticket, or one whose workspace Paperclip closed, has no
    # worktree we can vouch for: the reaper's `git branch -d` runs at the branch
    # tip, so it deletes the local branch even when only a PR or a remote squash
    # delivered it, and a rebuild would then branch off main — a green preview
    # of code without the change. Only an engineer run restores the branch.
    _reopen="reopen it with 'opc-paperclip buzz-feedback continue' (one engineer run restores the branch and hands off in_review), then preview up on the in_review event"
    case "$(printf '%s' "$_issue" | jq -r '.status // empty')" in
        done)
            # Asking for a preview puts the ticket under the acceptance rule
            # (spec 6.3a), whenever it is asked. Label it before refusing, so
            # the engineer woken by the reopen hands off in_review, not done.
            preview_label_issue "$_issue" ||
                die "$_ident is done and the preview label could not be added — add it on the board, then $_reopen" 4
            die "$_ident is done: no usable execution workspace for this ticket (labelled preview) — $_reopen" 3 ;;
        cancelled) die "$_ident is cancelled: no usable execution workspace for this ticket — $_reopen" 3 ;;
    esac
    _ws_id="$(printf '%s' "$_issue" | jq -r '.executionWorkspaceId // empty')"
    [ -n "$_ws_id" ] ||
        die "$_ident has no usable execution workspace for this ticket (no run has created one, or it was cleaned up) — if it was delivered before, $_reopen" 3
    _ws="$(api_request GET "/execution-workspaces/$_ws_id")" ||
        die "failed to read execution workspace $_ws_id" 4
    case "$(printf '%s' "$_ws" | jq -r '.status // empty')" in
        archived|cleanup_failed)
            die "$_ident has no usable execution workspace for this ticket (workspace $_ws_id is $(printf '%s' "$_ws" | jq -r .status)) — $_reopen" 3 ;;
    esac
    _base_url="$(preview_public_base)" || exit $?
    _all="$(api_request GET "/companies/$(company_id)/execution-workspaces")" ||
        die "failed to list execution workspaces" 4
    _held="$(printf '%s' "$_all" | jq -c --arg ws "$_ws_id" '
        [.[] | select(.id != $ws) | . as $w | (.runtimeServices // [])[]
         | select(.serviceName == "preview" and (.status == "running" or .status == "starting" or .status == "provisioning")
                  and .port != null) | {port, issue:$w.sourceIssueId, workspace:$w.id}]')"
    _held_ports="$(printf '%s' "$_held" | jq -c 'map(.port)')"
    _preferred="$(printf '%s' "$_ws" | jq -r '[(.config.workspaceRuntime.services // [])[]
        | select(.name == "preview") | .port][0] // empty')"
    if ! _port="$(preview_pick_port "$_preferred" "$_held_ports")"; then
        _holders=""
        for _hid in $(printf '%s' "$_held" | jq -r '.[] | if .issue then .issue else "workspace:" + .workspace end' | sort -u); do
            case "$_hid" in
                workspace:*) _hi="workspace ${_hid#workspace:}" ;;
                *) _hi="$(api_request GET "/issues/$_hid" 2>/dev/null | jq -r '.identifier // empty')" ;;
            esac
            _holders="${_holders}${_holders:+, }${_hi:-$_hid}"
        done
        die "no free preview port (${OPC_PREVIEW_PORT_BASE:-21012}-${OPC_PREVIEW_PORT_END:-21015}); held by: ${_holders:-unknown} — stop one with 'preview down'" 5
    fi
    _svc="$(preview_service_json "$_port" "$_base_url")"
    _config="$(printf '%s' "$_ws" | preview_config_json "$_svc")" ||
        die "$_ident's workspace defines workspaceRuntime.commands; preview up only manages services[] — configure the preview on the board" 4
    _idx="$(printf '%s' "$_config" | jq -r '.workspaceRuntime.services | map(.name) | index("preview")')"
    api_request PATCH "/execution-workspaces/$_ws_id" "$(jq -nc --argjson c "$_config" '{config:$c}')" >/dev/null ||
        die "failed to configure the preview service" 4
    # serviceIndex selects only the preview entry; an empty selector would
    # start every service configured on the workspace.
    if ! _start_out="$(api_request_body POST "/execution-workspaces/$_ws_id/runtime-services/start" \
        "$(jq -nc --argjson i "$_idx" '{serviceIndex:$i}')")"; then
        _err="$(preview_error_text "$_start_out")"
        [ -n "$_err" ] || _err="$(printf '%s' "$_start_out" | head -c 600)"
        die "failed to start the preview service: ${_err:-no response body}" 4
    fi
    _deadline=$(( $(date +%s) + ${OPC_PREVIEW_START_TIMEOUT:-120} ))
    while :; do
        _ws="$(api_request GET "/execution-workspaces/$_ws_id")" ||
            die "failed to read execution workspace $_ws_id" 4
        _cur="$(printf '%s' "$_ws" | preview_service_of)"
        _st="$(printf '%s' "$_cur" | jq -r '.status // empty')"
        case "$_st" in running|failed|stopped) break ;; esac
        if [ "$(date +%s)" -ge "$_deadline" ]; then
            # Paperclip can leave the record at "starting" while the server
            # already serves (upstream race with a run's finalize). Say so.
            _stuck_url="$(printf '%s' "$_cur" | jq -r '.url // empty')"
            [ -n "$_stuck_url" ] || _stuck_url="$_base_url:$_port"
            _stuck_probe="$(preview_probe_target "$_stuck_url")"
            if [ "$_st" = starting ] && preview_probe_url "${_stuck_probe% *}"; then
                die "preview $_stuck_url is serving, but Paperclip's record is stuck in starting (upstream finalize race) — run 'opc-paperclip preview down --issue $_ident' then 'preview up' again" 4
            fi
            die "preview service did not start within ${OPC_PREVIEW_START_TIMEOUT:-120}s (status: ${_st:-none})" 4
        fi
        sleep "${OPC_PREVIEW_POLL_SECONDS:-2}"
    done
    case "$_st" in
        failed|stopped) die "preview service ended up $_st right after start (see the workspace runtime log)" 4 ;;
    esac
    _got_port="$(printf '%s' "$_cur" | jq -r '.port // empty')"
    [ "$_got_port" = "$_port" ] ||
        die "preview port mismatch: requested $_port but Paperclip started it on ${_got_port:-none} (fixed-port fallback) — not publishing that URL" 4
    _url="$(printf '%s' "$_cur" | jq -r '.url // empty')"
    [ -n "$_url" ] || _url="$_base_url:$_port"
    _probe="$(preview_probe_target "$_url")"
    _probe_url="${_probe% *}"
    _probe_mode="${_probe##* }"
    preview_probe_url "$_probe_url" ||
        die "preview $_url did not answer a 2xx over HTTP (checked $_probe_url)" 4
    preview_label_issue "$_issue" || die "preview is up but the preview label could not be added" 4
    _src="$(printf '%s' "$_ws" | jq -r '.sourceIssueId // empty')"
    _src_ident=""
    if [ -n "$_src" ] && [ "$_src" != "$_issue_id" ]; then
        _src_ident="$(api_request GET "/issues/$_src" 2>/dev/null | jq -r '.identifier // empty')"
        [ -n "$_src_ident" ] || _src_ident="$_src"
    fi
    printf '%s' "$_ws" | jq -c --arg id "$_ident" --arg url "$_url" --argjson port "$_port" \
        --arg ws "$_ws_id" --arg src "$_src_ident" --arg probe "$_probe_mode" '
        {identifier:$id,url:$url,port:$port,workspaceId:$ws,status:"running",
         branchName:(.branchName // null),probe:$probe}
        + (if $src == "" then {} else {sourceIssue:$src} end)'
}

preview_down() {
    _ident="$(preview_issue_arg "$@")" || die "usage: opc-paperclip preview down --issue OPC-N" 2
    _issue="$(preview_issue_json "$_ident")" || exit $?
    _ws_id="$(printf '%s' "$_issue" | jq -r '.executionWorkspaceId // empty')"
    if [ -n "$_ws_id" ]; then
        _ws="$(api_request GET "/execution-workspaces/$_ws_id")" ||
            die "failed to read execution workspace $_ws_id" 4
        _st="$(printf '%s' "$_ws" | preview_service_of | jq -r '.status // empty')"
        _cur="$(printf '%s' "$_ws" | preview_service_of)"
        _idx="$(printf '%s' "$_ws" | jq -r '(.config.workspaceRuntime.services // []) | map(.name) | index("preview") // empty')"
        case "$_st" in
            running|starting|provisioning)
                # target only the preview service, never the whole workspace
                _sel="$(printf '%s' "$_cur" | jq -c '{runtimeServiceId:.id}')"
                if [ "$(printf '%s' "$_cur" | jq -r '.id // empty')" = "" ]; then
                    [ -n "$_idx" ] || die "no preview service configured on $_ws_id" 4
                    _sel="$(jq -nc --argjson i "$_idx" '{serviceIndex:$i}')"
                fi
                _stop_out="$(api_request_body POST "/execution-workspaces/$_ws_id/runtime-services/stop" "$_sel")" ||
                    die "failed to stop the preview service: $(preview_error_text "$_stop_out")" 4 ;;
        esac
        if [ -n "$_idx" ]; then
            # serviceStates is keyed by the service's index in services[]
            _patch="$(printf '%s' "$_ws" | jq -c --arg i "$_idx" \
                '{config:{serviceStates:((.config.serviceStates // {}) + {($i):"stopped"})}}')"
            api_request PATCH "/execution-workspaces/$_ws_id" "$_patch" >/dev/null ||
                die "failed to record the stopped preview state" 4
        fi
    fi
    jq -nc --arg id "$_ident" '{identifier:$id,status:"stopped"}'
}

preview_status() {
    _ident=""
    if [ "$#" -gt 0 ]; then
        _ident="$(preview_issue_arg "$@")" || die "usage: opc-paperclip preview status [--issue OPC-N]" 2
    fi
    _ws_only=""
    if [ -n "$_ident" ]; then
        _pi_json="$(preview_issue_json "$_ident")" || exit $?
        _ws_only="$(printf '%s' "$_pi_json" | jq -r '.executionWorkspaceId // empty')"
        [ -n "$_ws_only" ] || { printf '[]\n'; return 0; }
    fi
    _all="$(api_request GET "/companies/$(company_id)/execution-workspaces")" ||
        die "failed to list execution workspaces" 4
    _rows="$(printf '%s' "$_all" | jq -c --arg only "$_ws_only" '
        [.[] | select($only == "" or .id == $only) | . as $w
         | (.runtimeServices // [])[] | select(.serviceName == "preview")
         | {issue:$w.sourceIssueId, workspaceId:$w.id, port, url, status}]')"
    # A workspace with no source issue (shared, or detached) still holds its
    # port: list it under its workspace id rather than dropping it.
    _out="$(printf '%s' "$_rows" | jq -c '[.[] | select(.issue == null) | {identifier:null, workspaceId, port, url, status}]')"
    for _sid in $(printf '%s' "$_rows" | jq -r '[.[].issue // empty] | unique[]'); do
        _i="$(api_request GET "/issues/$_sid" 2>/dev/null | jq -r '.identifier // empty')"
        _out="$(printf '%s' "$_rows" | jq -c --arg sid "$_sid" --arg i "${_i:-$_sid}" --argjson acc "$_out" \
            '$acc + [.[] | select(.issue == $sid) | {identifier:$i, workspaceId, port, url, status}]')"
    done
    printf '%s\n' "$_out"
}

cmd_preview() {
    case "${1-}" in
        up) shift; preview_up "$@" ;;
        down) shift; preview_down "$@" ;;
        status) shift; preview_status "$@" ;;
        *) die "usage: opc-paperclip preview <up|down|status> [--issue OPC-N]" 2 ;;
    esac
}

validate_concurrency_max() {
    _max="$1"
    if ! jq -en --arg value "$_max" \
        '$value | test("^[0-9]+$") and (tonumber >= 1 and tonumber <= 50)' \
        >/dev/null 2>&1; then
        die "maxConcurrentRuns must be an integer from 1 to 50" 2
    fi
}

concurrency_show_json() {
    _agent="$1"
    _current="$(printf '%s' "$_agent" | jq -r '.runtimeConfig.heartbeat.maxConcurrentRuns // empty')"
    case "$_current" in
        ''|*[!0-9]*) die "agent has no valid runtimeConfig heartbeat maxConcurrentRuns" 4 ;;
    esac
    # A third source: the event bridge writes its adaptive slot plan under its
    # own metadata key. Without this branch, the first adaptive write would look
    # like an operator_override (current != marker) and silently freeze
    # adaptation forever.
    _bridge="$(printf '%s' "$_agent" | jq -r \
        '.metadata.opcBridgeAllocation.maxConcurrentRuns // empty')"
    _marker="$(printf '%s' "$_agent" | jq -r \
        '.metadata.opcManagedDefaults.fullstackMaxConcurrentRuns // empty')"
    if [ -n "$_bridge" ] && [ "$_bridge" = "$_current" ]; then
        _source=bridge_adaptive
    else
    case "$_marker" in
        ''|"$FULLSTACK_MAX_CONCURRENT_RUNS_DEFAULT")
            if [ "$_current" = "$FULLSTACK_MAX_CONCURRENT_RUNS_DEFAULT" ]; then
                _source=managed_default
            else
                _source=operator_override
            fi
            ;;
        *) _source=operator_override ;;
    esac
    fi
    jq -nc --argjson agent "$_agent" \
        --argjson max "$_current" \
        --argjson managed "$FULLSTACK_MAX_CONCURRENT_RUNS_DEFAULT" \
        --arg source "$_source" \
        '{agentId:$agent.id, name:$agent.name, scope:"agent_global",
          maxConcurrentRuns:$max, managedDefault:$managed, source:$source}'
}
cmd_agent_concurrency_show() {
    _role=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --role) [ "$#" -ge 2 ] || die "--role requires a value" 2; _role="$2"; shift 2 ;;
            *) die "usage: opc-paperclip agent concurrency show --role <role>" 2 ;;
        esac
    done
    [ -n "$_role" ] || die "--role is required" 2
    concurrency_show_json "$(agent_by_role "$_role")"
}

cmd_agent_concurrency_write() {
    _role="$1"
    _max="$2"
    _reset_marker="${3-}"
    _agent="$(agent_by_role "$_role")"
    _id="$(printf '%s' "$_agent" | jq -r '.id // empty')"
    [ -n "$_id" ] || die "Paperclip agent has no id" 4
    _new_runtime="$(printf '%s' "$_agent" | jq --arg value "$_max" '
        (.runtimeConfig // {}) as $r
        | $r * {heartbeat:(($r.heartbeat // {})
              * {maxConcurrentRuns:($value | tonumber)})}
        | if ((.modelProfiles? | type) == "object")
             and ((.modelProfiles.cheap? | type) == "object")
             and ((.modelProfiles.cheap.adapterConfig? | type) != "object")
          then .modelProfiles.cheap.adapterConfig = {}
          else .
          end
    ')"
    if [ "$_reset_marker" = reset ]; then
        _new_metadata="$(printf '%s' "$_agent" | jq --arg value "$_max" '
            (.metadata // {}) as $m
            | $m * {opcManagedDefaults:(($m.opcManagedDefaults // {})
                  * {fullstackMaxConcurrentRuns:($value | tonumber)})}
        ')"
    else
        _new_metadata="$(printf '%s' "$_agent" | jq '.metadata // {}')"
    fi
    _payload="$(jq -nc --argjson runtime "$_new_runtime" \
        --argjson metadata "$_new_metadata" \
        '{runtimeConfig:$runtime, metadata:$metadata}')"
    _response="$(api_request PATCH "/agents/$_id" "$_payload")" ||
        die "failed to update Paperclip agent concurrency" 4
    printf '%s' "$_response" | jq -e --arg max "$_max" \
        '.runtimeConfig.heartbeat.maxConcurrentRuns == ($max | tonumber)' >/dev/null 2>&1 ||
        die "Paperclip agent concurrency update was not verified" 4
    if [ "$_reset_marker" = reset ]; then
        printf '%s' "$_response" | jq -e --arg max "$_max" \
            '.metadata.opcManagedDefaults.fullstackMaxConcurrentRuns == ($max | tonumber)' \
            >/dev/null 2>&1 ||
            die "Paperclip managed concurrency marker update was not verified" 4
    fi
    _live="$(agent_by_role "$_role")"
    printf '%s' "$_live" | jq -e --arg max "$_max" \
        '.runtimeConfig.heartbeat.maxConcurrentRuns == ($max | tonumber)' >/dev/null 2>&1 ||
        die "Paperclip agent concurrency did not persist" 4
    if [ "$_reset_marker" = reset ]; then
        printf '%s' "$_live" | jq -e --arg max "$_max" \
            '.metadata.opcManagedDefaults.fullstackMaxConcurrentRuns == ($max | tonumber)' \
            >/dev/null 2>&1 ||
            die "Paperclip managed concurrency marker did not persist" 4
    fi
    concurrency_show_json "$_live"
}

cmd_agent_concurrency_reset() {
    _role=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --role) [ "$#" -ge 2 ] || die "--role requires a value" 2; _role="$2"; shift 2 ;;
            *) die "usage: opc-paperclip agent concurrency reset --role <role>" 2 ;;
        esac
    done
    [ -n "$_role" ] || die "--role is required" 2
    cmd_agent_concurrency_write "$_role" "$FULLSTACK_MAX_CONCURRENT_RUNS_DEFAULT" reset
}

cmd_agent_concurrency_set() {
    _role=""
    _max=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --role) [ "$#" -ge 2 ] || die "--role requires a value" 2; _role="$2"; shift 2 ;;
            --max) [ "$#" -ge 2 ] || die "--max requires a value" 2; _max="$2"; shift 2 ;;
            *) die "usage: opc-paperclip agent concurrency set --role <role> --max <1..50>" 2 ;;
        esac
    done
    [ -n "$_role" ] || die "--role is required" 2
    [ -n "$_max" ] || die "--max is required" 2
    validate_concurrency_max "$_max"
    cmd_agent_concurrency_write "$_role" "$_max"
}

cmd_repo_normalize() {
    [ "$#" -eq 1 ] || die "usage: opc-paperclip repo normalize <repo>" 2
    canonical_repo_json "$1"
}

safe_workspace_json() {
    _workspace="$1"
    _source="${2-}"
    printf '%s' "$_workspace" | jq -c --arg source "$_source" '
        {id,name,sourceType,repoUrl,
         ref:(.ref // .branch // .baseRef // .providerRef // null),
         isPrimary,source:$source}
    '
}

safe_policy_json() {
    _policy="$1"
    printf '%s' "$_policy" | jq -c '
        {enabled:(.enabled // false),
         mode:(.defaultMode // null),
         defaultMode:(.defaultMode // null),
         sharedConcurrency:(.sharedWorkspaceConcurrency // null),
         sharedWorkspaceConcurrency:(.sharedWorkspaceConcurrency // null),
         defaultWorkspace:(.defaultProjectWorkspaceId // null),
         defaultProjectWorkspaceId:(.defaultProjectWorkspaceId // null),
         strategyType:(.workspaceStrategy.type // null),
         workspaceStrategy:{type:(.workspaceStrategy.type // null)}}
    '
}
safe_issue_json() {
    _issue="$1"
    printf '%s' "$_issue" | jq -c '{id,identifier,title,projectId,projectWorkspaceId,status}'
}

workspace_source() {
    _project="$1"
    _workspace="$2"
    _marker_type="$(printf '%s' "$_workspace" | jq -r '.metadata.opcWorkspaceDefaults | type')"
    _marker_source="$(printf '%s' "$_workspace" | jq -r '.metadata.opcWorkspaceDefaults.source // empty')"
    if [ "$_marker_source" = operatorOverride ]; then
        printf '%s\n' operator_override
        return
    fi
    if [ "$_marker_type" != object ]; then
        printf '%s\n' unmanaged
        return
    fi
    _marker_lane="$(printf '%s' "$_workspace" | jq -r '.metadata.opcWorkspaceDefaults.lane // empty')"
    _marker_mode="$(printf '%s' "$_workspace" | jq -r '.metadata.opcWorkspaceDefaults.mode // empty')"
    _marker_strategy="$(printf '%s' "$_workspace" | jq -r '.metadata.opcWorkspaceDefaults.strategyType // empty')"
    if [ "$_marker_lane" != engineering ] && [ "$_marker_lane" != prototype ]; then
        printf '%s\n' unmanaged
        return
    fi
    if [ -z "$_marker_mode" ] || [ -z "$_marker_strategy" ]; then
        printf '%s\n' unmanaged
        return
    fi
    _marker_shared="$(printf '%s' "$_workspace" | jq -r '.metadata.opcWorkspaceDefaults.sharedWorkspaceConcurrency // empty')"
    _marker_enabled="$(printf '%s' "$_workspace" | jq -r '.metadata.opcWorkspaceDefaults.enabled // true')"
    _marker_workspace="$(printf '%s' "$_workspace" | jq -r '.metadata.opcWorkspaceDefaults.defaultProjectWorkspaceId // .id // empty')"
    _live_enabled="$(printf '%s' "$_project" | jq -r '.executionWorkspacePolicy.enabled // empty')"
    _live_mode="$(printf '%s' "$_project" | jq -r '.executionWorkspacePolicy.defaultMode // empty')"
    _live_strategy="$(printf '%s' "$_project" | jq -r '.executionWorkspacePolicy.workspaceStrategy.type // empty')"
    _live_shared="$(printf '%s' "$_project" | jq -r '.executionWorkspacePolicy.sharedWorkspaceConcurrency // empty')"
    _live_workspace="$(printf '%s' "$_project" | jq -r '.executionWorkspacePolicy.defaultProjectWorkspaceId // empty')"
    if [ "$_live_mode" = "$_marker_mode" ] &&
       [ "$_live_strategy" = "$_marker_strategy" ] &&
       { [ -z "$_marker_shared" ] || [ "$_live_shared" = "$_marker_shared" ]; } &&
       { [ -z "$_marker_enabled" ] || [ "$_live_enabled" = "$_marker_enabled" ]; } &&
       { [ -z "$_marker_workspace" ] || [ "$_live_workspace" = "$_marker_workspace" ]; }; then
        printf '%s\n' managed_default
    else
        printf '%s\n' operator_override
    fi
}

safe_project_workspace_json() {
    _project="$1"
    _workspace="$2"
    _source="$3"
    _policy="$(printf '%s' "$_project" | jq -c '.executionWorkspacePolicy // .workspacePolicy // {}')"
    jq -nc --argjson project "$_project" --argjson workspace "$(safe_workspace_json "$_workspace" "$_source")" \
        --argjson policy "$(safe_policy_json "$_policy")" --arg source "$_source" '
        {project:($project | {id,name,status}),
         workspace:$workspace,policy:$policy,source:$source}
    '
}

cmd_project_workspace_show() {
    _repo=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --repo) [ "$#" -ge 2 ] || die "--repo requires a value" 2; _repo="$2"; shift 2 ;;
            *) die "usage: opc-paperclip project workspace show --repo <repo>" 2 ;;
        esac
    done
    [ -n "$_repo" ] || die "--repo is required" 2
    _canonical="$(canonical_repo_json "$_repo")"
    _project="$(unique_project_by_repo "$_canonical")"
    [ -n "$_project" ] || die "no Paperclip project matches $(printf '%s' "$_canonical" | jq -r .identity)" 3
    _workspace="$(primary_workspace_json "$_project")"
    [ "$_workspace" != null ] || die "matching Paperclip project has no primary workspace" 3
    _source="$(workspace_source "$_project" "$_workspace")"
    safe_project_workspace_json "$_project" "$_workspace" "$_source"
}

projects_matching() {
    _canonical="$1"
    _identity="$(printf '%s' "$_canonical" | jq -r '.identity')"
    _projects="$(list_projects)" || die "failed to list Paperclip projects" 4
    printf '%s' "$_projects" | jq -e 'if type == "array" then . else error("not an array") end' >/dev/null 2>&1 ||
        die "Paperclip projects response is not an array" 4
    _project_lines="$(printf '%s' "$_projects" | jq -c '.[]')"
    while IFS= read -r _project; do
        [ -n "$_project" ] || continue
        _workspace="$(primary_workspace_json "$_project")"
        [ "$_workspace" != null ] || continue
        _url="$(printf '%s' "$_workspace" | jq -r '.repoUrl // empty')"
        [ -n "$_url" ] || continue
        if _live_identity="$(canonical_repo_json "$_url" 2>/dev/null | jq -r '.identity')"; then
            if [ "$_live_identity" = "$_identity" ]; then
                printf '%s\n' "$_project"
            fi
        fi
    done <<EOF
$_project_lines
EOF
}

project_match_count() {
    printf '%s\n' "$1" | sed '/^$/d' | wc -l | tr -d ' '
}

duplicate_project_error() {
    _identity="$1"
    _matches="$2"
    _details="$(printf '%s\n' "$_matches" | sed '/^$/d' | jq -r '"\(.id // "<no-id>") \(.name // "<unnamed>")"')" ||
        die "failed to format duplicate Paperclip projects" 4
    _details="$(printf '%s\n' "$_details" | tr '\n' ';' | sed 's/;$//')"
    die "multiple Paperclip projects match $_identity: $_details" 3
}

project_policy_with_defaults() {
    _project="$1"
    _workspace_id="$2"
    _mode="$3"
    _strategy="$4"
    _shared="$5"
    printf '%s' "$_project" | jq -c \
        --arg workspace "$_workspace_id" --arg mode "$_mode" \
        --arg strategy "$_strategy" --arg shared "$_shared" '
        (.executionWorkspacePolicy // {}) as $policy
        | $policy
        * {enabled:true, defaultMode:$mode,
           defaultProjectWorkspaceId:$workspace,
           workspaceStrategy:(($policy.workspaceStrategy // {}) * {type:$strategy})}
        | if $shared == "" then . else .sharedWorkspaceConcurrency = $shared end
    '
}

workspace_marker_payload() {
    _project="$1"
    _workspace="$2"
    _lane="$3"
    _mode="$4"
    _strategy="$5"
    _shared="${6-}"
    _source="${7-managedDefault}"
    printf '%s' "$_workspace" | jq -c \
        --arg lane "$_lane" --arg mode "$_mode" --arg strategy "$_strategy" \
        --arg shared "$_shared" --arg source "$_source" --arg workspace "$_workspace_id" '
        (.metadata // {}) as $metadata
        | $metadata * {opcWorkspaceDefaults:
            (($metadata.opcWorkspaceDefaults // {})
             * {lane:$lane, mode:$mode, strategyType:$strategy, source:$source,
                enabled:true, defaultProjectWorkspaceId:$workspace}
             | if $shared == "" then . else .sharedWorkspaceConcurrency = $shared end)}
    '
}

verify_project_policy() {
    _project="$1"
    _workspace_id="$2"
    _mode="$3"
    _strategy="$4"
    _shared="${5-}"
    printf '%s' "$_project" | jq -e \
        --arg workspace "$_workspace_id" --arg mode "$_mode" --arg strategy "$_strategy" --arg shared "$_shared" '
        .executionWorkspacePolicy.enabled == true
        and .executionWorkspacePolicy.defaultMode == $mode
        and .executionWorkspacePolicy.workspaceStrategy.type == $strategy
        and .executionWorkspacePolicy.defaultProjectWorkspaceId == $workspace
        and (if $shared == "" then true
             else .executionWorkspacePolicy.sharedWorkspaceConcurrency == $shared end)
    ' >/dev/null 2>&1 || die "Paperclip project workspace policy was not verified" 4
}

verify_workspace_marker() {
    _project_id="$1"
    _workspace_id="$2"
    _lane="$3"
    _mode="$4"
    _strategy="$5"
    _shared="${6-}"
    _source="${7-}"
    _project="$(api_request GET "/projects/$_project_id")" ||
        die "failed to verify Paperclip workspace marker" 4
    _workspace="$(primary_workspace_json "$_project")"
    printf '%s' "$_workspace" | jq -e \
        --arg workspace "$_workspace_id" --arg lane "$_lane" \
        --arg mode "$_mode" --arg strategy "$_strategy" --arg shared "$_shared" --arg source "$_source" '
        .id == $workspace
        and .metadata.opcWorkspaceDefaults.lane == $lane
        and .metadata.opcWorkspaceDefaults.mode == $mode
        and .metadata.opcWorkspaceDefaults.strategyType == $strategy
        and (if $shared == "" then true
             else .metadata.opcWorkspaceDefaults.sharedWorkspaceConcurrency == $shared end)
        and (if $source == "" then true else .metadata.opcWorkspaceDefaults.source == $source end)
    ' >/dev/null 2>&1 || die "Paperclip workspace marker did not persist" 4
}


reconcile_engineering_project() {
    _project="$1"
    _workspace="$(primary_workspace_json "$_project")"
    [ "$_workspace" != null ] || die "matching Paperclip project has no primary workspace" 3
    _project_id="$(printf '%s' "$_project" | jq -r '.id // empty')"
    _workspace_id="$(printf '%s' "$_workspace" | jq -r '.id // empty')"
    [ -n "$_project_id" ] && [ -n "$_workspace_id" ] ||
        die "matching Paperclip project has no project or workspace id" 4
    _marker_type="$(printf '%s' "$_workspace" | jq -r '.metadata.opcWorkspaceDefaults | type')"
    if [ "$_marker_type" != object ]; then
        _policy="$(project_policy_with_defaults "$_project" "$_workspace_id" isolated_workspace git_worktree "")"
        _response="$(api_request PATCH "/projects/$_project_id" "$(
            jq -nc --argjson policy "$_policy" '{executionWorkspacePolicy:$policy}'
        )")" || die "failed to apply engineering project workspace policy" 4
        _project="$(api_request GET "/projects/$_project_id")" ||
            die "failed to read engineering project after policy update" 4
        verify_project_policy "$_project" "$_workspace_id" isolated_workspace git_worktree
        _workspace="$(primary_workspace_json "$_project")"
        _metadata="$(workspace_marker_payload "$_project" "$_workspace" engineering isolated_workspace git_worktree "" managedDefault)"
        _response="$(api_request PATCH "/projects/$_project_id/workspaces/$_workspace_id" "$(
            jq -nc --argjson metadata "$_metadata" '{metadata:$metadata}'
        )")" || die "failed to mark engineering project workspace defaults" 4
        verify_workspace_marker "$_project_id" "$_workspace_id" engineering isolated_workspace git_worktree "" managedDefault
        _project="$(api_request GET "/projects/$_project_id")" ||
            die "failed to read engineering project after marker update" 4
    else
        _marker_lane="$(printf '%s' "$_workspace" | jq -r '.metadata.opcWorkspaceDefaults.lane // empty')"
        _marker_mode="$(printf '%s' "$_workspace" | jq -r '.metadata.opcWorkspaceDefaults.mode // empty')"
        _marker_strategy="$(printf '%s' "$_workspace" | jq -r '.metadata.opcWorkspaceDefaults.strategyType // empty')"
        _marker_source="$(printf '%s' "$_workspace" | jq -r '.metadata.opcWorkspaceDefaults.source // empty')"
        [ "$_marker_lane" = engineering ] &&
            [ -n "$_marker_mode" ] && [ -n "$_marker_strategy" ] ||
            die "engineering workspace marker is incomplete or has the wrong lane" 4
        case "$_marker_mode" in
            shared_workspace|isolated_workspace|operator_branch|adapter_default) ;;
            *) die "engineering workspace marker has an unsupported mode" 4 ;;
        esac
        case "$_marker_strategy" in
            project_primary|git_worktree|adapter_managed) ;;
            *) die "engineering workspace marker has an unsupported strategy" 4 ;;
        esac
        case "$_marker_source" in
            ""|managedDefault|operatorOverride) ;;
            *) die "engineering workspace marker has an unsupported source" 4 ;;
        esac
        _live_mode="$(printf '%s' "$_project" | jq -r '.executionWorkspacePolicy.defaultMode // empty')"
        _live_strategy="$(printf '%s' "$_project" | jq -r '.executionWorkspacePolicy.workspaceStrategy.type // empty')"
        if [ "$_marker_lane" = engineering ] &&
           { [ "$_live_mode" != "$_marker_mode" ] || [ "$_live_strategy" != "$_marker_strategy" ]; }; then
            : # A live difference from our marker is an operator override.
        fi
    fi
    printf '%s' "$_project"
}

engineering_project() {
    _canonical="$1"
    _identity="$(printf '%s' "$_canonical" | jq -r '.identity')"
    _matches="$(projects_matching "$_canonical")"
    _count="$(project_match_count "$_matches")"
    case "$_count" in
        0)
            _company="$(company_id)"
            _payload="$(printf '%s' "$_canonical" | jq -c '
                {name:(.owner + "/" + .repo),
                 description:("GitHub engineering project for " + .owner + "/" + .repo + "."),
                 status:"in_progress",
                 executionWorkspacePolicy:{
                   enabled:true, defaultMode:"isolated_workspace",
                   workspaceStrategy:{type:"git_worktree"}},
                 workspace:{
                   name:"primary", sourceType:"git_repo", repoUrl:.repoUrl, isPrimary:true}
                }')"
            _created="$(api_request POST "/companies/$_company/projects" "$_payload")" ||
                die "failed to create Paperclip engineering project" 4
            _project_id="$(printf '%s' "$_created" | jq -r '.id // empty')"
            [ -n "$_project_id" ] || die "Paperclip project create response has no id" 4
            _workspace="$(primary_workspace_json "$_created")"
            [ "$_workspace" != null ] || die "Paperclip project create response has no primary workspace" 4
            _workspace_id="$(printf '%s' "$_workspace" | jq -r '.id // empty')"
            [ -n "$_workspace_id" ] || die "Paperclip primary workspace has no id" 4
            _policy="$(project_policy_with_defaults "$_created" "$_workspace_id" isolated_workspace git_worktree "")"
            _response="$(api_request PATCH "/projects/$_project_id" "$(
                jq -nc --argjson policy "$_policy" '{executionWorkspacePolicy:$policy}'
            )")" || die "failed to bind engineering project primary workspace" 4
            _response="$(api_request GET "/projects/$_project_id")" ||
                die "failed to verify engineering project policy" 4
            verify_project_policy "$_response" "$_workspace_id" isolated_workspace git_worktree
            _workspace="$(primary_workspace_json "$_response")"
            _metadata="$(workspace_marker_payload "$_response" "$_workspace" engineering isolated_workspace git_worktree "" managedDefault)"
            _response="$(api_request PATCH "/projects/$_project_id/workspaces/$_workspace_id" "$(
                jq -nc --argjson metadata "$_metadata" '{metadata:$metadata}'
            )")" || die "failed to mark engineering project workspace defaults" 4
            verify_workspace_marker "$_project_id" "$_workspace_id" engineering isolated_workspace git_worktree "" managedDefault
            _matches="$(projects_matching "$_canonical")"
            _count="$(project_match_count "$_matches")"
            [ "$_count" -eq 1 ] || {
                [ "$_count" -gt 1 ] && duplicate_project_error "$_identity" "$_matches"
                die "new Paperclip project could not be verified uniquely" 4
            }
            printf '%s\n' "$_matches" | sed '/^$/d'
            ;;
        1)
            _project="$(printf '%s\n' "$_matches" | sed '/^$/d')"
            reconcile_engineering_project "$_project"
            ;;
        *) duplicate_project_error "$_identity" "$_matches" ;;
    esac
}

resolve_project() {
    _repo=""
    _project_id=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --repo) [ "$#" -ge 2 ] || die "--repo requires a value" 2; _repo="$2"; shift 2 ;;
            --project-id) [ "$#" -ge 2 ] || die "--project-id requires a value" 2; _project_id="$2"; shift 2 ;;
            *) die "usage: project workspace <set|reset> (--repo <repo>|--project-id <uuid>) ..." 2 ;;
        esac
    done
    [ -n "$_repo" ] || [ -n "$_project_id" ] || die "--repo or --project-id is required" 2
    [ -z "$_repo" ] || [ -z "$_project_id" ] || die "--repo and --project-id are mutually exclusive" 2
    if [ -n "$_project_id" ]; then
        api_request GET "/projects/$_project_id" ||
            die "failed to read Paperclip project $_project_id" 4
    else
        _canonical="$(canonical_repo_json "$_repo")"
        _matches="$(projects_matching "$_canonical")"
        _count="$(project_match_count "$_matches")"
        case "$_count" in
            1) printf '%s\n' "$_matches" | sed '/^$/d' ;;
            0) die "no Paperclip project matches $(printf '%s' "$_canonical" | jq -r .identity)" 3 ;;
            *) duplicate_project_error "$(printf '%s' "$_canonical" | jq -r .identity)" "$_matches" ;;
        esac
    fi
}

validate_workspace_mode() {
    case "$1" in
        shared_workspace|isolated_workspace|operator_branch|adapter_default) ;;
        *) die "unsupported project workspace mode: $1" 2 ;;
    esac
}

strategy_for_mode() {
    case "$1" in
        shared_workspace) printf '%s\n' project_primary ;;
        isolated_workspace|operator_branch) printf '%s\n' git_worktree ;;
        adapter_default) printf '%s\n' adapter_managed ;;
    esac
}

cmd_project_workspace_set() {
    _repo=""
    _project_id=""
    _mode=""
    _shared=""
    _strategy=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --repo) [ "$#" -ge 2 ] || die "--repo requires a value" 2; _repo="$2"; shift 2 ;;
            --project-id) [ "$#" -ge 2 ] || die "--project-id requires a value" 2; _project_id="$2"; shift 2 ;;
            --mode) [ "$#" -ge 2 ] || die "--mode requires a value" 2; _mode="$2"; shift 2 ;;
            --shared-concurrency) [ "$#" -ge 2 ] || die "--shared-concurrency requires a value" 2; _shared="$2"; shift 2 ;;
            --strategy) [ "$#" -ge 2 ] || die "--strategy requires a value" 2; _strategy="$2"; shift 2 ;;
            *) die "usage: opc-paperclip project workspace set (--repo <repo>|--project-id <uuid>) --mode <mode> [--shared-concurrency auto|serialize|allow] [--strategy <strategy>]" 2 ;;
        esac
    done
    [ -n "$_mode" ] || die "--mode is required" 2
    validate_workspace_mode "$_mode"
    [ -z "$_repo" ] || [ -z "$_project_id" ] || die "--repo and --project-id are mutually exclusive" 2
    [ -n "$_repo" ] || [ -n "$_project_id" ] || die "--repo or --project-id is required" 2
    case "$_shared" in ""|auto|serialize|allow) ;; *) die "shared concurrency must be auto, serialize, or allow" 2 ;; esac
    _expected_strategy="$(strategy_for_mode "$_mode")"
    [ -n "$_strategy" ] || _strategy="$_expected_strategy"
    [ "$_strategy" = "$_expected_strategy" ] ||
        die "strategy $_strategy is incompatible with mode $_mode (expected $_expected_strategy)" 2
    [ "$_mode" = shared_workspace ] || [ -z "$_shared" ] ||
        die "--shared-concurrency is only valid with shared_workspace" 2
    if [ -n "$_repo" ]; then
        _project="$(resolve_project --repo "$_repo")"
    else
        _project="$(resolve_project --project-id "$_project_id")"
    fi
    _id="$(printf '%s' "$_project" | jq -r '.id // empty')"
    [ -n "$_id" ] || die "Paperclip project has no id" 4
    _workspace="$(primary_workspace_json "$_project")"
    [ "$_workspace" != null ] || die "project must have exactly one primary workspace" 3
    _workspace_id="$(printf '%s' "$_workspace" | jq -r '.id // empty')"
    [ -n "$_workspace_id" ] || die "project primary workspace has no id" 3
    _policy="$(project_policy_with_defaults "$_project" "$_workspace_id" "$_mode" "$_strategy" "$_shared")"
    _response="$(api_request PATCH "/projects/$_id" "$(
        jq -nc --argjson policy "$_policy" '{executionWorkspacePolicy:$policy}'
    )")" || die "failed to update Paperclip project workspace policy" 4
    _live="$(api_request GET "/projects/$_id")" || die "failed to verify Paperclip project workspace policy" 4
    verify_project_policy "$_live" "$_workspace_id" "$_mode" "$_strategy" "$_shared"
    _workspace="$(primary_workspace_json "$_live")"
    _marker_lane="$(printf '%s' "$_workspace" | jq -r '.metadata.opcWorkspaceDefaults.lane // empty')"
    [ -n "$_marker_lane" ] || _marker_lane=engineering
    _metadata="$(workspace_marker_payload "$_live" "$_workspace" "$_marker_lane" "$_mode" "$_strategy" "$_shared" operatorOverride)"
    _response="$(api_request PATCH "/projects/$_id/workspaces/$_workspace_id" "$(
        jq -nc --argjson metadata "$_metadata" '{metadata:$metadata}'
    )")" || die "failed to update Paperclip workspace marker" 4
    verify_workspace_marker "$_id" "$_workspace_id" "$_marker_lane" "$_mode" "$_strategy" "$_shared" operatorOverride
    _live="$(api_request GET "/projects/$_id")" || die "failed to read Paperclip project after workspace marker update" 4
    _workspace="$(primary_workspace_json "$_live")"
    _source="$(workspace_source "$_live" "$_workspace")"
    safe_project_workspace_json "$_live" "$_workspace" "$_source"
}

cmd_project_workspace_reset() {
    _repo=""
    _project_id=""
    _lane=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --repo) [ "$#" -ge 2 ] || die "--repo requires a value" 2; _repo="$2"; shift 2 ;;
            --project-id) [ "$#" -ge 2 ] || die "--project-id requires a value" 2; _project_id="$2"; shift 2 ;;
            --lane) [ "$#" -ge 2 ] || die "--lane requires a value" 2; _lane="$2"; shift 2 ;;
            *) die "usage: opc-paperclip project workspace reset (--repo <repo>|--project-id <uuid>) --lane engineering|prototype" 2 ;;
        esac
    done
    case "$_lane" in engineering|prototype) ;; *) die "--lane must be engineering or prototype" 2 ;; esac
    [ -z "$_repo" ] || [ -z "$_project_id" ] || die "--repo and --project-id are mutually exclusive" 2
    [ -n "$_repo" ] || [ -n "$_project_id" ] || die "--repo or --project-id is required" 2
    if [ -n "$_repo" ]; then
        _project="$(resolve_project --repo "$_repo")"
    else
        _project="$(resolve_project --project-id "$_project_id")"
    fi
    _id="$(printf '%s' "$_project" | jq -r '.id // empty')"
    _workspace="$(primary_workspace_json "$_project")"
    [ "$_workspace" != null ] || die "project has no primary workspace" 3
    _workspace_id="$(printf '%s' "$_workspace" | jq -r '.id // empty')"
    [ -n "$_workspace_id" ] || die "project primary workspace has no id" 3
    if [ "$_lane" = engineering ]; then
        _mode=isolated_workspace; _strategy=git_worktree; _shared=""
    else
        _mode=shared_workspace; _strategy=project_primary; _shared=serialize
    fi
    _policy="$(project_policy_with_defaults "$_project" "$_workspace_id" "$_mode" "$_strategy" "$_shared")"
    _response="$(api_request PATCH "/projects/$_id" "$(
        jq -nc --argjson policy "$_policy" '{executionWorkspacePolicy:$policy}'
    )")" || die "failed to reset Paperclip project workspace policy" 4
    _response="$(api_request GET "/projects/$_id")" || die "failed to verify Paperclip project workspace reset" 4
    verify_project_policy "$_response" "$_workspace_id" "$_mode" "$_strategy" "$_shared"
    _workspace="$(primary_workspace_json "$_response")"
    _metadata="$(workspace_marker_payload "$_response" "$_workspace" "$_lane" "$_mode" "$_strategy" "$_shared" managedDefault)"
    _response="$(api_request PATCH "/projects/$_id/workspaces/$_workspace_id" "$(
        jq -nc --argjson metadata "$_metadata" '{metadata:$metadata}'
    )")" || die "failed to reset Paperclip workspace marker" 4
    verify_workspace_marker "$_id" "$_workspace_id" "$_lane" "$_mode" "$_strategy" "$_shared" managedDefault
    _response="$(api_request GET "/projects/$_id")" || die "failed to read Paperclip project after workspace reset" 4
    _workspace="$(primary_workspace_json "$_response")"
    safe_project_workspace_json "$_response" "$_workspace" managed_default
}

# Two statements, not one pipeline: a pipeline's exit status is jq's, and jq
# on empty stdin exits 0 with no output, so a failed list_projects used to
# reach the caller as an empty count and land in the "multiple projects"
# branch — an outage reported as an ambiguous name (exit 3).
prototype_project_matches() {
    _name="$1"
    _projects="$(list_projects)" || die "failed to list Paperclip projects" 4
    printf '%s' "$_projects" | jq -c --arg n "$_name" '
        if type == "array" then [.[] | select(.name == $n)] else error("not an array") end
    ' 2>/dev/null || die "Paperclip projects response is not an array" 4
}

list_prototype_marker_issues() {
    _company="$1"
    _marker="$2"
    _offset=0
    _matches_file="$(mktemp "${TMPDIR:-/tmp}/opc-paperclip-prototype-matches.XXXXXX")" ||
        die "failed to allocate prototype issue buffer" 4
    : >"$_matches_file"
    while :; do
        _page="$(api_request GET "/companies/$_company/issues?limit=500&offset=$_offset")" ||
            die "failed to list Paperclip issues" 4
        _page_count="$(printf '%s' "$_page" | jq -r 'if type == "array" then length else -1 end' 2>/dev/null)" ||
            die "Paperclip issues response is not an array" 4
        [ "$_page_count" -ge 0 ] ||
            die "Paperclip issues response is not an array" 4
        printf '%s' "$_page" | jq -c --arg marker "$_marker" \
            '.[] | select((.description // "" | split("\n")[0]) == $marker)' \
            >>"$_matches_file" ||
            die "Paperclip issues response is not an array" 4
        [ "$_page_count" -lt 500 ] && break
        _offset=$((_offset + _page_count))
    done
    jq -s . "$_matches_file"
    rm -f "$_matches_file"
}

prototype_primary_workspace_id() {
    _project="$1"
    _workspace="$(primary_workspace_json "$_project")"
    [ "$_workspace" != null ] || return 0
    printf '%s' "$_workspace" | jq -r '.id // empty'
}

prototyper_agent() {
    _agents="$(api_request GET "/companies/$(company_id)/agents")" ||
        die "failed to list Paperclip agents" 4
    _matches="$(printf '%s' "$_agents" | jq -c --arg n Prototyper '
        if type == "array" then [.[] | select(.name == $n)] else [] end
    ' 2>/dev/null)" || die "Paperclip agents response is not an array" 4
    _count="$(printf '%s' "$_matches" | jq -r 'length')"
    case "$_count" in
        0) die "no Paperclip agent named Prototyper" 3 ;;
        1) printf '%s' "$_matches" | jq -c '.[0]' ;;
        *) die "multiple Paperclip agents named Prototyper" 3 ;;
    esac
}

prototype_ticket_create() {
    _name=""
    _title=""
    _priority=""
    _buzz_channel=""
    _buzz_event=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --name) [ "$#" -ge 2 ] || die "--name requires a value" 2; _name="$2"; shift 2 ;;
            --title) [ "$#" -ge 2 ] || die "--title requires a value" 2; _title="$2"; shift 2 ;;
            --priority) [ "$#" -ge 2 ] || die "--priority requires a value" 2; _priority="$2"; shift 2 ;;
            --buzz-channel) [ "$#" -ge 2 ] || die "--buzz-channel requires a value" 2; _buzz_channel="$2"; shift 2 ;;
            --buzz-event) [ "$#" -ge 2 ] || die "--buzz-event requires a value" 2; _buzz_event="$2"; shift 2 ;;
            *) die "usage: opc-paperclip prototype-ticket create --name <name> --title <title> [--priority <p>] [--buzz-channel <uuid> --buzz-event <id>]" 2 ;;
        esac
    done
    [ -n "$_name" ] || die "--name is required" 2
    [ -n "$_title" ] || die "--title is required" 2
    validate_buzz_origin "$_buzz_channel" "$_buzz_event"
    printf '%s' "$_name" | grep -Eq '^[a-z][a-z0-9-]{1,40}$' ||
        die "invalid prototype name '$_name' — must match ^[a-z][a-z0-9-]{1,40}\$" 2

    _description_file="$(mktemp "${TMPDIR:-/tmp}/opc-paperclip-prototype-description.XXXXXX")" ||
        die "failed to allocate description buffer" 4
    cat >"$_description_file"
    _first_line="$(sed -n '1p' "$_description_file")"
    [ "$_first_line" = "Prototype: $_name" ] ||
        die "description must start with exactly 'Prototype: $_name'" 2
    _track="$(label_marker "$_description_file" Track)"
    [ -n "$_track" ] || _track=lab
    _style="$(label_marker "$_description_file" Style)"
    [ -n "$_style" ] || _style=exploration
    admission_check "$_track" || exit $?

    _company="$(company_id)"
    _matches="$(prototype_project_matches "$_name")" ||
        die "failed to list Paperclip projects" 4
    _project_count="$(printf '%s' "$_matches" | jq -r 'length')"
    _allow_duplicate=false
    case "$_project_count" in
        ''|*[!0-9]*) die "unexpected Paperclip projects response" 4 ;;
        0)
            _matching="$(list_prototype_marker_issues "$_company" "Prototype: $_name")"
            _active="$(printf '%s' "$_matching" | jq -c '
                [.[] | select((.status // "") != "done" and (.status // "") != "cancelled")]
            ')"
            _terminal="$(printf '%s' "$_matching" | jq -c '
                [.[] | select((.status // "") == "done" or (.status // "") == "cancelled")]
            ')"
            _active_count="$(printf '%s' "$_active" | jq -r 'length')"
            _terminal_count="$(printf '%s' "$_terminal" | jq -r 'length')"
            case "$_active_count" in
                0) ;;
                1)
                    _existing_id="$(printf '%s' "$_active" | jq -r '.[0].id // empty')"
                    [ -n "$_existing_id" ] || die "existing prototype ticket has no id" 4
                    _issue="$(api_request GET "/issues/$_existing_id")" ||
                        die "failed to read existing prototype ticket" 4
                    if printf '%s' "$_issue" | jq -e \
                        '.status == "backlog" and .assigneeAgentId == null' >/dev/null; then
                        die "prototype ticket $_existing_id is an unassigned draft; Buzz routing setup is incomplete" 4
                    fi
                    safe_issue_json "$_issue"
                    rm -f "$_description_file"
                    return 0
                    ;;
                *) _details="$(printf '%s' "$_active" | jq -r '.[] | "\(.id // "<no-id>") \(.identifier // "<no-identifier>")"' \
                       | tr '\n' ';' | sed 's/;$//')"
                   die "multiple active prototype tickets for $_name: $_details" 3 ;;
            esac
            _project_id=""
            _workspace_id=""
            _idempotency_key=""
            _terminal_epoch=0
            if [ "$_terminal_count" -eq 0 ]; then
                _idempotency_key="opc-prototype-first:$_company:$_name"
            else
                _terminal_epoch=1
            fi
            ;;
        1)
            _allow_duplicate=true
            _project="$(printf '%s' "$_matches" | jq -c '.[0]')"
            _project_id="$(printf '%s' "$_project" | jq -r '.id // empty')"
            [ -n "$_project_id" ] || die "prototype project has no id" 4
            _workspace_id="$(prototype_primary_workspace_id "$_project")"
            [ -n "$_workspace_id" ] ||
                die "prototype project has no primary workspace" 3
            _idempotency_key=""
            _terminal_epoch=0
            ;;
        *) _details="$(printf '%s' "$_matches" | jq -r '.[] | "\(.id // "<no-id>") \(.name // "<unnamed>")"' \
               | tr '\n' ';' | sed 's/;$//')"
           die "multiple Paperclip projects named $_name: $_details" 3 ;;
    esac

    _agent="$(prototyper_agent)"
    _agent_id="$(printf '%s' "$_agent" | jq -r '.id // empty')"
    [ -n "$_agent_id" ] || die "Prototyper agent has no id" 4
    case "$_track" in core|lab) ;; *) die "unknown Track: $_track (core|lab)" 2 ;; esac
    case "$_style" in blueprint|exploration) ;; *) die "unknown Style: $_style (blueprint|exploration)" 2 ;; esac
    _labels_json="$(ensure_ticket_labels_json "$_track" "$_style")" || exit $?
    _payload="$(prototype_payload_json "$_description_file" "$_title" "$_priority" \
        "$_agent_id" "$_project_id" "$_workspace_id" "$_idempotency_key" \
        "Prototype: $_name" "$_terminal_epoch" "$_allow_duplicate" "$_labels_json")"
    _created="$(create_ticket_json "$_company" "$_payload" "$_buzz_channel" "$_buzz_event")" ||
        die "failed to create prototype ticket" 4
    rm -f "$_description_file"
    _issue_id="$(printf '%s' "$_created" | jq -r '.id // empty')"
    [ -n "$_issue_id" ] || die "Paperclip prototype ticket response has no id" 4
    _issue="$(api_request GET "/issues/$_issue_id")" ||
        die "failed to verify prototype ticket" 4
    printf '%s' "$_issue" | jq -e --arg agent "$_agent_id" --arg project "$_project_id" \
        --arg workspace "$_workspace_id" '
        .assigneeAgentId == $agent
        and (if $project == "" then (.projectId // null) == null
             else .projectId == $project and .projectWorkspaceId == $workspace end)
    ' >/dev/null 2>&1 || die "Paperclip prototype ticket response was not verified" 4
    safe_issue_json "$_issue"
}

active_engineer() {
    _agents="$(api_request GET "/companies/$(company_id)/agents")" ||
        die "failed to list Paperclip agents" 4
    _matches="$(printf '%s' "$_agents" | jq -c '
        if type == "array" then
          [.[] | select(.role == "engineer")
            | select((.status // "") == "active" or (.status // "") == "idle"
                     or (.status // "") == "running" or (.status // "") == "error")
            | select((.terminatedAt // null) == null)]
        else [] end
    ')" || die "Paperclip agents response is not an array" 4
    _count="$(printf '%s' "$_matches" | jq -r 'length')"
    case "$_count" in
        0) die "no active Paperclip agent matches role engineer" 3 ;;
        1) printf '%s' "$_matches" | jq -c '.[0]' ;;
        *) die "multiple active Paperclip agents match role engineer" 3 ;;
    esac
}

# Payload builders are functions so the JSON can be validated without touching
# the API: `tests/opc-paperclip.sh` sources this file (OPC_PAPERCLIP_SOURCE_ONLY)
# and pipes each builder through `jq -e`. A malformed payload used to reach the
# board as a jq compile error at create time and nothing caught it.
engineering_payload_json() { # desc title priority status mode exec-ws agent project workspace settings labels
    jq -nc --rawfile description "$1" \
        --arg title "$2" --arg priority "$3" --arg status "$4" \
        --arg mode "$5" --arg execution_workspace_id "$6" \
        --arg agent "$7" --arg project "$8" --arg workspace "$9" \
        --argjson settings "${10}" --argjson labels "${11}" '
        {title:$title,description:$description,assigneeAgentId:$agent,
         projectId:$project,projectWorkspaceId:$workspace,labelIds:$labels,
         executionWorkspacePreference:$mode,
         executionWorkspaceSettings:$settings}
        | if $priority == "" then . else .priority=$priority end
        | if $status == "" then . else .status=$status end
        | if $mode == "reuse_existing"
          then .executionWorkspaceId=$execution_workspace_id
          | .executionWorkspacePreference="reuse_existing"
          else . end
    '
}

prototype_payload_json() { # desc title priority agent project workspace idempotency terminal_title terminal_epoch allow_duplicate labels
    jq -nc --rawfile description "$1" \
        --arg title "$2" --arg priority "$3" --arg agent "$4" \
        --arg project "$5" --arg workspace "$6" \
        --arg idempotency "$7" --arg terminal_title "$8" \
        --argjson terminal_epoch "$9" --argjson allow_duplicate "${10}" \
        --argjson labels "${11}" '
        {title:(if $terminal_epoch == 1 then $terminal_title else $title end),
         description:$description,assigneeAgentId:$agent,allowDuplicate:$allow_duplicate,
         labelIds:$labels}
        | if $priority == "" then . else .priority=$priority end
        | if $project == "" then . else .projectId=$project | .projectWorkspaceId=$workspace end
        | if $idempotency == "" then . else .idempotencyKey=$idempotency end
    '
}

cmd_labels_ensure() {
    _first="$(ensure_ticket_labels_json core blueprint)" || exit $?
    _second="$(ensure_ticket_labels_json lab exploration)" || exit $?
    jq -n --argjson a "$_first" --argjson b "$_second" '$a + $b | unique'
}

cmd_engineering_ticket_create() {
    _repo=""
    _title=""
    _priority=""
    _status=""
    _mode=inherit
    _execution_workspace_id=""
    _buzz_channel=""
    _buzz_event=""
    _preview=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --preview) _preview=1; shift ;;
            --repo) [ "$#" -ge 2 ] || die "--repo requires a value" 2; _repo="$2"; shift 2 ;;
            --title) [ "$#" -ge 2 ] || die "--title requires a value" 2; _title="$2"; shift 2 ;;
            --priority) [ "$#" -ge 2 ] || die "--priority requires a value" 2; _priority="$2"; shift 2 ;;
            --status) [ "$#" -ge 2 ] || die "--status requires a value" 2; _status="$2"; shift 2 ;;
            --mode) [ "$#" -ge 2 ] || die "--mode requires a value" 2; _mode="$2"; shift 2 ;;
            --execution-workspace-id) [ "$#" -ge 2 ] || die "--execution-workspace-id requires a value" 2; _execution_workspace_id="$2"; shift 2 ;;
            --buzz-channel) [ "$#" -ge 2 ] || die "--buzz-channel requires a value" 2; _buzz_channel="$2"; shift 2 ;;
            --buzz-event) [ "$#" -ge 2 ] || die "--buzz-event requires a value" 2; _buzz_event="$2"; shift 2 ;;
            *) die "usage: opc-paperclip engineering-ticket create --repo <repo> --title <title> [--priority <p>] [--status todo|backlog] [--mode <mode>] [--execution-workspace-id <uuid>] [--buzz-channel <uuid> --buzz-event <id>] [--preview]" 2 ;;
        esac
    done
    [ -n "$_repo" ] || die "--repo is required" 2
    [ -n "$_title" ] || die "--title is required" 2
    validate_buzz_origin "$_buzz_channel" "$_buzz_event"
    case "$_status" in ""|todo|backlog) ;; *) die "status must be todo or backlog" 2 ;; esac
    case "$_mode" in
        inherit) [ -z "$_execution_workspace_id" ] || die "--execution-workspace-id requires --mode reuse_existing" 2 ;;
        shared_workspace|isolated_workspace|operator_branch|agent_default)
            [ -z "$_execution_workspace_id" ] || die "--execution-workspace-id requires --mode reuse_existing" 2 ;;
        reuse_existing)
            [ -n "$_execution_workspace_id" ] || die "reuse_existing requires --execution-workspace-id" 2 ;;
        adapter_default)
            [ -z "$_execution_workspace_id" ] || die "--execution-workspace-id requires --mode reuse_existing" 2
            _mode=agent_default ;;
        *) die "unsupported engineering ticket mode: $_mode" 2 ;;
    esac
    _description_file="$(mktemp "${TMPDIR:-/tmp}/opc-paperclip-description.XXXXXX")" ||
        die "failed to allocate description buffer" 4
    cat >"$_description_file"
    _track="$(label_marker "$_description_file" Track)"
    [ -n "$_track" ] || _track=core
    admission_check "$_track" || exit $?
    _canonical="$(canonical_repo_json "$_repo")"
    _project="$(engineering_project "$_canonical")"
    _project_id="$(printf '%s' "$_project" | jq -r '.id // empty')"
    _workspace="$(primary_workspace_json "$_project")"
    _workspace_id="$(printf '%s' "$_workspace" | jq -r '.id // empty')"
    [ -n "$_project_id" ] && [ -n "$_workspace_id" ] ||
        die "engineering project has no primary workspace" 4
    _agent="$(active_engineer)"
    _agent_id="$(printf '%s' "$_agent" | jq -r '.id // empty')"
    [ -n "$_agent_id" ] || die "active engineer has no id" 4
    case "$_mode" in
        inherit) _settings="$(jq -nc '{mode:"inherit"}')" ;;
        shared_workspace) _settings="$(jq -nc '{mode:"shared_workspace",workspaceStrategy:{type:"project_primary"}}')" ;;
        isolated_workspace) _settings="$(jq -nc '{mode:"isolated_workspace",workspaceStrategy:{type:"git_worktree"}}')" ;;
        operator_branch) _settings="$(jq -nc '{mode:"operator_branch",workspaceStrategy:{type:"git_worktree"}}')" ;;
        agent_default) _settings="$(jq -nc '{mode:"agent_default",workspaceStrategy:{type:"adapter_managed"}}')" ;;
        reuse_existing) _settings="$(jq -nc '{mode:"reuse_existing"}')" ;;
    esac
    _style="$(label_marker "$_description_file" Style)"
    [ -n "$_style" ] || _style=blueprint
    case "$_track" in core|lab) ;; *) die "unknown Track: $_track (core|lab)" 2 ;; esac
    case "$_style" in blueprint|exploration) ;; *) die "unknown Style: $_style (blueprint|exploration)" 2 ;; esac
    _labels_json="$(ensure_ticket_labels_json "$_track" "$_style")" || exit $?
    if [ "$_preview" = 1 ]; then
        _preview_label="$(ensure_preview_label)" || exit $?
        _labels_json="$(printf '%s' "$_labels_json" | jq -c --arg l "$_preview_label" '. + [$l] | unique')"
    fi
    _payload="$(engineering_payload_json "$_description_file" "$_title" "$_priority" \
        "$_status" "$_mode" "$_execution_workspace_id" "$_agent_id" "$_project_id" \
        "$_workspace_id" "$_settings" "$_labels_json")"
    rm -f "$_description_file"
    _company="$(company_id)"
    _created="$(create_ticket_json "$_company" "$_payload" "$_buzz_channel" "$_buzz_event")" ||
        die "failed to create engineering ticket" 4
    _issue_id="$(printf '%s' "$_created" | jq -r '.id // empty')"
    [ -n "$_issue_id" ] || die "Paperclip issue create response has no id" 4
    _issue="$(api_request GET "/issues/$_issue_id")" ||
        die "failed to verify engineering ticket" 4
    printf '%s' "$_issue" | jq -e --arg agent "$_agent_id" --arg project "$_project_id" \
        --arg workspace "$_workspace_id" --arg mode "$_mode" \
        --arg execution_workspace_id "$_execution_workspace_id" '
        .assigneeAgentId == $agent and .projectId == $project
        and .projectWorkspaceId == $workspace
        and ((.executionWorkspaceSettings.mode // .executionWorkspacePreference) == $mode)
        and (if $mode == "reuse_existing"
             then .executionWorkspaceId == $execution_workspace_id
                  and .executionWorkspacePreference == "reuse_existing"
             else true end)
    ' >/dev/null 2>&1 || die "Paperclip engineering ticket response was not verified" 4
    _identifier="$(printf '%s' "$_issue" | jq -r '.identifier // empty')"
    [ -n "$_identifier" ] || die "Paperclip issue has no identifier" 4
    if [ -n "${PAPERCLIP_PUBLIC_URL:-}" ]; then
        jq -nc --arg id "$_issue_id" --arg identifier "$_identifier" \
            --arg project "$_project_id" --arg workspace "$_workspace_id" \
            --arg mode "$_mode" --arg url "${PAPERCLIP_PUBLIC_URL%/}/issues/$_identifier" \
            '{id:$id,identifier:$identifier,projectId:$project,
              projectWorkspaceId:$workspace,mode:$mode,boardUrl:$url}'
    else
        jq -nc --arg id "$_issue_id" --arg identifier "$_identifier" \
            --arg project "$_project_id" --arg workspace "$_workspace_id" --arg mode "$_mode" \
            '{id:$id,identifier:$identifier,projectId:$project,
              projectWorkspaceId:$workspace,mode:$mode}'
    fi
}

# Agent chooses whether the feedback is rework. This command chooses no ticket
# by inference: read the authenticated relay, then verify the issue on the board.
buzz_feedback() (
    action="${1-}"; [ "$#" -gt 0 ] && shift
    channel= event= selected= want_preview=
    board="${PAPERCLIP_PUBLIC_URL:-}"; board="${board%/}"
    case "$action" in resolve|continue) ;; *) die "usage: opc-paperclip buzz-feedback <resolve|continue> --channel UUID --event HEX [--issue OPC-N] [--preview]" 2 ;; esac
    while [ "$#" -gt 0 ]; do
        # --preview (continue only): the owner asked for a preview, so the
        # ticket gets the preview label in the same write that reopens it.
        if [ "$1" = --preview ]; then
            [ "$action" = continue ] || die "--preview applies to buzz-feedback continue only" 2
            want_preview=1; shift; continue
        fi
        [ "$#" -ge 2 ] || die "missing value for $1" 2
        case "$1" in
            --channel) channel="$2" ;;
            --event) event="$2" ;;
            --issue) selected="$2" ;;
            *) die "unknown feedback option: $1" 2 ;;
        esac
        shift 2
    done
    printf '%s\n' "$channel" | grep -Eq '^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$' ||
        die "expected a Buzz channel UUID" 2
    printf '%s\n' "$event" | grep -Eq '^[0-9a-f]{64}$' || die "expected a Buzz feedback event ID" 2
    keys="${BUZZ_KEYS_DIR:-/keys}"
    owner="${BUZZ_ACP_AGENT_OWNER:-}"
    notifier="$(cat "$keys/paperclip.pub")" && frontdoor="$(cat "$keys/agent.pub")" &&
        relay="$(cat "$keys/relay.pub")" || die "Buzz identities are unavailable" 4
    printf '%s\n' "$owner" | grep -Eq '^[0-9a-f]{64}$' || die "no configured Buzz operator" 3
    [ "$owner" != "$relay" ] && [ "$owner" != "$notifier" ] && [ "$owner" != "$frontdoor" ] ||
        die "Buzz operator must be a human, not a service identity" 3

    # Agent output uses Buzz's own NIP-10 parser for reply_to/thread_root.
    # Pubkeys and tags are read from the configured relay, never prompt prose.
    thread="$(buzz --format agent messages thread --channel "$channel" --event "$event" --limit 100)" ||
        die "cannot resolve feedback on the Buzz relay" 4
    context="$(printf '%s\n' "$thread" | jq -ec --arg c "$channel" --arg e "$event" \
        --arg owner "$owner" --arg notifier "$notifier" --arg frontdoor "$frontdoor" \
        --arg board "$board" '
        def tags($k): [.tags[]? | select(.[0] == $k) | .[1]];
        def root: .thread_root // .reply_to // .id;
        def issue_id: strings | select(test("^[A-Z][A-Z0-9]*-[0-9]+$"));
        if type != "array" or length >= 100 then error("thread unavailable or incomplete") else . end
        | [.[] | select(.kind == 9 and tags("h") == [$c])] as $events
        | [$events[] | select(.id == $e)] as $feedback
        | if ($feedback | length) != 1 or $feedback[0].pubkey != $owner or
             ($feedback[0] | tags("auth") | length) != 0 or
             ($feedback[0].content | type) != "string" or
             ($feedback[0].content | test("\\S") | not)
          then error("feedback must be an operator-authored Buzz message") else $feedback[0] end
        | . as $message | root as $root
        | [$events[] | select(root == $root and .created_at <= $message.created_at)] as $related
        | if any($related[]; .id == $root) then . else error("thread root is missing") end
        | { feedback: $message.content, thread_ids: [$related[].id],
            references: ([$message.content | scan("(?<![A-Za-z0-9_-])[A-Z][A-Z0-9]*-[0-9]+(?![A-Za-z0-9_-])")] | unique),
            candidates: ([
              $related[]
              | select(.id != $e and tags("auth") == [])
              | (.id == $message.reply_to) as $direct
              | if .pubkey == $notifier and (tags("opc-event") | length) == 1
                then tags("opc-issue") | select(length == 1) | .[] | issue_id | {identifier:., notice:true, direct:$direct}
                elif .pubkey == $frontdoor and $board != ""
                then .content | split($board + "/issues/")[1:][]
                     | capture("^(?<id>[A-Z][A-Z0-9]*-[0-9]+)(?:[^A-Za-z0-9_-]|$)")?
                     | {identifier:.id, notice:false, direct:$direct}
                else empty end
            ] | sort_by(.identifier) | group_by(.identifier)
              | map({identifier:.[0].identifier, notice:any(.[]; .notice), direct:any(.[]; .direct)})) }
    ')" || die "unverified Buzz feedback; no Paperclip write" 3
    company="$(company_id)" || exit $?
    candidates="$(printf '%s\n' "$context" | jq -c '.candidates[]')"
    issues='[]'
    while IFS= read -r candidate; do
        [ -n "$candidate" ] || continue
        identifier="$(printf '%s\n' "$candidate" | jq -er '.identifier')"
        issue="$(api_request GET "/issues/$identifier")" || die "cannot read linked issue $identifier" 4
        issue_id="$(printf '%s\n' "$issue" | jq -er --arg company "$company" --arg ref "$identifier" '
            select(.companyId == $company and .identifier == $ref and (.projectId | strings | length > 0))
            | .id | strings | select(test("^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"))
        ')" || die "linked issue $identifier has no verified company/project binding" 3
        if ! printf '%s\n' "$candidate" | jq -e '.notice' >/dev/null; then
            comments="$(api_request GET "/issues/$issue_id/comments")" || die "cannot verify Buzz origin for $identifier" 4
            if ! printf '%s\n' "$comments" | jq -e --arg prefix "BUZZ_CHANNEL: $channel" \
                --argjson ctx "$context" '
                any(.[]; .authorAgentId == null and (.authorUserId | strings | length > 0) and
                    (.body as $body | any($ctx.thread_ids[]; $body == ($prefix + "\nBUZZ_EVENT: " + .))))
            ' >/dev/null; then continue; fi
        fi
        issues="$(printf '%s\n' "$issues" | jq -c --argjson i "$issue" --argjson c "$candidate" \
            '. + [$i + {directBuzzReply:$c.direct}]')"
    done <<EOF
$candidates
EOF
    # A verified operator can disambiguate by naming one of the linked issues.
    refs="$(printf '%s\n' "$issues" | jq -c --argjson ctx "$context" '
        [.[].identifier | split("-")[0]] as $prefixes
        | [$ctx.references[] | select(split("-")[0] as $p | $prefixes | index($p))]
    ')"
    if [ "$refs" != '[]' ]; then
        matches="$(printf '%s\n' "$issues" | jq -c --argjson refs "$refs" \
            '[.[] | select(.identifier as $id | $refs | index($id))]')"
        if [ "$(printf '%s\n' "$refs" | jq 'length')" = 1 ] && [ "$matches" != '[]' ]; then
            issues="$matches"
        else
            die "explicit issue reference is not a unique verified ticket in this thread" 3
        fi
    else
        issues="$(printf '%s\n' "$issues" | jq -c 'if any(.[]; .directBuzzReply) then map(select(.directBuzzReply)) else . end')"
    fi
    decision="$(printf '%s\n' "$issues" | jq -r 'length | if . == 1 then "linked" elif . == 0 then "unlinked" else "ambiguous" end')"
    if [ "$action" = resolve ]; then
        printf '%s\n' "$issues" | jq -c --arg decision "$decision" \
            '{decision:$decision, issues:map({id,identifier,title,description,projectId,status})}'
        exit 0
    fi
    [ "$decision" = linked ] && [ -n "$selected" ] &&
        printf '%s\n' "$issues" | jq -e --arg i "$selected" '.[0].identifier == $i' >/dev/null ||
        die "feedback does not identify one matching issue" 3
    issue="$(printf '%s\n' "$issues" | jq -c '.[0]')"
    issue_id="$(printf '%s\n' "$issue" | jq -er '.id')"
    status="$(printf '%s\n' "$issue" | jq -er '.status')"
    rework_agent=
    # in_review, and a done ticket that was handed off to the owner's user,
    # carry no agent assignee: give it back to the agent that delivered it.
    if [ "$status" = in_review ] || { [ "$status" = done ] &&
        ! printf '%s\n' "$issue" | jq -e '.assigneeAgentId | strings | length > 0' >/dev/null; }; then
        # A preview handoff assigns the ticket to the owner's user, so the
        # agent that delivered it is the one on the newest succeeded run
        # (finishedAt, else createdAt); failed/cancelled retries never take the ticket.
        runs="$(api_request GET "/issues/$issue_id/runs")" || die "cannot read runs for $selected" 4
        rework_agent="$(printf '%s\n' "$runs" | jq -r --argjson issue "$issue" '
            ([.[]? | select(.status == "succeeded" and (.agentId | strings | length) > 0)]
              | sort_by(.finishedAt // .createdAt) | last | .agentId)
            // $issue.assigneeAgentId // empty')" || die "cannot read runs for $selected" 4
        [ -n "$rework_agent" ] || die "no agent has worked on this issue; use the board" 3
    else
        printf '%s\n' "$issue" | jq -e '.assigneeAgentId | strings | length > 0' >/dev/null ||
            die "issue has no agent assignee; use the board" 3
    fi
    products="$(api_request GET "/issues/$issue_id/work-products")" || die "cannot check delivery acceptance" 4
    printf '%s\n' "$products" | jq -e 'type == "array" and all(.[]; .reviewState != "approved" and .status != "approved" and .status != "merged")' >/dev/null ||
        die "delivery already accepted or acceptance cannot be verified" 3
    printf '%s\n' "$issue" | jq -e '(.executionState.lastDecisionOutcome != "approved") and (.executionState.status != "pending")' >/dev/null ||
        die "formal review or approval is active or recorded; use the board" 3

    # UUID-shaped deterministic key for Paperclip's board comment idempotency.
    key="$(printf '%s\n' "$event" | sed -E 's/(.{8})(.{4}).(.{3}).(.{3})(.{12}).*/\1-\2-4\3-8\4-\5/')"
    body="$(printf '%s\n' "$context" | jq -r --arg event "$event" \
        '"QA feedback from Buzz (" + $event + "):\n\n" + .feedback')"
    # A done ticket goes through Paperclip's explicit resume intent (resume
    # needs the comment; it also reopens a closed execution workspace), the
    # same gate the comment-only done path uses.
    resume=false
    if [ -n "$rework_agent" ] && [ "$status" = done ]; then status=in_review; resume=true; fi
    # Labels are merged with the issue's own, never replaced.
    labels=null
    if [ -n "$want_preview" ]; then
        preview_label="$(ensure_preview_label)" || exit $?
        labels="$(printf '%s\n' "$issue" | jq -c --arg l "$preview_label" \
            '(.labelIds // [(.labels // [])[].id]) + [$l] | unique')"
    fi
    case "$status" in
        in_review)
            response="$(api_request PATCH "/issues/$issue_id" "$(jq -nc --arg body "$body" --arg key "$key" --arg agent "$rework_agent" --argjson resume "$resume" --argjson labels "$labels" \
                '{status:"todo",assigneeAgentId:$agent,assigneeUserId:null,comment:$body,commentClientRequestId:$key}
                 + (if $resume then {resume:true} else {} end)
                 + (if $labels == null then {} else {labelIds:$labels} end)')")" || die "Paperclip did not return the issue for rework" 4
            printf '%s\n' "$response" | jq -e --arg i "$issue_id" '.id == $i and .status == "todo"' >/dev/null ||
                die "Paperclip did not confirm the rework transition" 4 ;;
        todo|in_progress|done)
            # The comment wakes the agent; the label must already be there.
            if [ "$labels" != null ]; then
                api_request PATCH "/issues/$issue_id" "$(jq -nc --argjson labels "$labels" '{labelIds:$labels}')" >/dev/null ||
                    die "Paperclip did not accept the preview label" 4
            fi
            response="$(api_request POST "/issues/$issue_id/comments" "$(jq -nc --arg body "$body" \
                --arg key "$key" --arg status "$status" '{body:$body,clientRequestId:$key} + (if $status == "done" then {resume:true} else {} end)')")" ||
                die "Paperclip did not accept QA feedback" 4
            printf '%s\n' "$response" | jq -e '.id | strings | length > 0' >/dev/null ||
                die "Paperclip did not confirm the feedback comment" 4 ;;
        *) die "issue status $status does not permit automatic QA rework; use the board" 3 ;;
    esac
    current="$(api_request GET "/issues/$issue_id")" || die "feedback write completed; cannot verify final issue state" 4
    printf '%s\n' "$current" | jq -ec --arg id "$issue_id" --arg url "$board" '
        select(.id == $id and (.status == "todo" or .status == "in_progress"))
        | {identifier,status} + (if $url != "" then {boardUrl:($url + "/issues/" + .identifier)} else {} end)
    ' || die "feedback write completed; issue is not queued for rework" 4
)

main() {
    [ "$#" -gt 0 ] || die "usage: opc-paperclip <command>" 2
    case "$1" in
        agent)
            shift
            [ "${1-}" = concurrency ] || die "usage: opc-paperclip agent concurrency <show|set|reset> ..." 2
            shift
            case "${1-}" in
                show) shift; cmd_agent_concurrency_show "$@" ;;
                set) shift; cmd_agent_concurrency_set "$@" ;;
                reset) shift; cmd_agent_concurrency_reset "$@" ;;
                *) die "usage: opc-paperclip agent concurrency <show|set|reset> ..." 2 ;;
            esac
            ;;
        repo)
            shift
            [ "${1-}" = normalize ] || die "usage: opc-paperclip repo normalize <repo>" 2
            shift
            cmd_repo_normalize "$@"
            ;;
        project)
            shift
            [ "${1-}" = workspace ] || die "usage: opc-paperclip project workspace <show|set|reset> ..." 2
            shift
            case "${1-}" in
                show) shift; cmd_project_workspace_show "$@" ;;
                set) shift; cmd_project_workspace_set "$@" ;;
                reset) shift; cmd_project_workspace_reset "$@" ;;
                *) die "usage: opc-paperclip project workspace <show|set|reset> ..." 2 ;;
            esac
            ;;
        prototype-ticket)
            shift
            [ "${1-}" = create ] || die "usage: opc-paperclip prototype-ticket create ..." 2
            shift
            prototype_ticket_create "$@"
            ;;
        labels)
            shift
            [ "${1-}" = ensure ] || die "usage: opc-paperclip labels ensure" 2
            shift
            cmd_labels_ensure
            ;;
        buzz-feedback) shift; buzz_feedback "$@" ;;
        preview) shift; cmd_preview "$@" ;;
        engineering-ticket)
            shift
            [ "${1-}" = create ] || die "usage: opc-paperclip engineering-ticket create ..." 2
            shift
            cmd_engineering_ticket_create "$@"
            ;;
        *) die "unknown command: $1" 2 ;;
    esac
}

if [ "${OPC_PAPERCLIP_SOURCE_ONLY:-0}" = "1" ]; then
    return 0 2>/dev/null || exit 0
fi

main "$@"
