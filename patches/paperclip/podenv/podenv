#!/bin/sh
# podenv — nested container leases for Paperclip agents.
#
#   podenv provision <key> --image REF --port N [--as VAR] [--url TEMPLATE]
#                          [--env K=V] [--password-env NAME]
#                          [--netns pasta|host] [--dedicated "reason"]
#                          [--volume HOST:CONTAINER] [--env-file PATH]
#   podenv release   <key>
#   podenv list
#
# Design notes (including the seven Phase 0 measurements this depends on) live
# in docs/superpowers/specs/2026-08-22-podenv-nested-container-lease-design.md.
# Short version: devenv covers shared, multi-tenant, modern backends; podenv
# covers what devenv cannot — daemons that refuse to share, and very old
# versions that only exist as an image.
#
# USE DEVENV FIRST. If devenv already provides it, this CLI refuses the image
# and tells you the devenv command instead. That is a mechanism, not advice.
#
# Reclamation is manual (`podenv release`). Nothing reclaims automatically —
# invariant 6b.
#
# Exit codes: 0 ok / 2 bad usage / 3 resources exhausted / 4 backend
# unreachable / 5 the runtime host refused to start (or restart) the lease's
# container — distinct from 4 because the backend IS reachable in this case
# (podenv_require_runtime already succeeded); the problem is the image or
# command podman was asked to run, not connectivity.
set -eu

PODENV_LIB="${PODENV_LIB:-/usr/local/lib/podenv}"
DEVENV_LIB="${DEVENV_LIB:-/usr/local/lib/devenv}"

PODENV_SOCK="${PODENV_SOCK:-/run/podenv/podman.sock}"
PODENV_DIAG="${PODENV_DIAG:-/run/podenv/diagnosis}"
PODENV_HOST_NAME="${PODENV_HOST_NAME:-podenv}"
PODENV_PORT_BASE="${PODENV_PORT_BASE:-23000}"
PODENV_PORT_COUNT="${PODENV_PORT_COUNT:-16}"

DEVENV_PG_HOST="${DEVENV_PG_HOST:-devenv-pg}"
DEVENV_PG_PORT="${DEVENV_PG_PORT:-5432}"
DEVENV_PG_ADMIN_USER="${DEVENV_PG_ADMIN_USER:-postgres}"
DEVENV_PG_ADMIN_PASSWORD="${DEVENV_PG_ADMIN_PASSWORD:-}"
DEVENV_CONTROL_DB="${DEVENV_CONTROL_DB:-devenv_control}"

die()  { echo "podenv: $1" >&2; exit "${2:-1}"; }
note() { echo "$1" >&2; }

# Shared with devenv: env merge, password derivation, owner, reserved .env
# names, provider image families. See shared.sh's header. Sourced AFTER
# die()/note() are defined — see devenv's identical comment above its own
# source line for why.
. "$DEVENV_LIB/shared.sh"

podenv_psql() {
    PGPASSWORD="$DEVENV_PG_ADMIN_PASSWORD" \
    PGOPTIONS='-c client_min_messages=warning' psql \
        -h "$DEVENV_PG_HOST" -p "$DEVENV_PG_PORT" -U "$DEVENV_PG_ADMIN_USER" \
        -w -q -d "$DEVENV_CONTROL_DB" "$@"
}

# Boolean twin of podenv_require_runtime's three checks, for callers (cmd_release)
# that only need a yes/no before deciding whether to even attempt an operation —
# not a diagnosis. Client present AND the daemon actually answers: a stale
# socket file, or one no daemon is listening on, must not read as "reachable"
# just because `[ -S ... ]` is true. Kept as the single source of truth so
# this and podenv_require_runtime can never disagree about what "reachable"
# means (F6).
podenv_runtime_reachable() {
    [ -S "$PODENV_SOCK" ] || return 1
    command -v podman >/dev/null 2>&1 || return 1
    podman --remote --url "unix://$PODENV_SOCK" version --format '{{.Server.Version}}' >/dev/null 2>&1
}

# Three distinct failures, three distinct messages. The raw errors here are
# actively misleading: podman-remote's "Cannot connect to Podman ... try
# `podman machine init`" sends the reader to a macOS workflow that does not
# exist in this stack, and a socket that exists but refuses the connection
# looks identical to one that is not listening yet.
podenv_require_runtime() {
    if podenv_runtime_reachable; then
        if [ -s "$PODENV_DIAG" ]; then
            note "podenv: WARNING runtime host self-test: $(cat "$PODENV_DIAG")"
        fi
        return 0
    fi
    # Not reachable — walk the same three checks again, in order, to name
    # which one actually failed instead of a single generic message.
    if [ ! -S "$PODENV_SOCK" ]; then
        die "no podman socket at $PODENV_SOCK. The podenv compose service is not running (or its volume is not mounted here). Start it: docker compose up -d podenv" 4
    fi
    # Check for the client BEFORE attempting to use it: a missing/broken
    # `podman` binary and a live socket refusing this uid produce the exact
    # same symptom from `command ... || ...` below (nonzero, no stdout), but
    # they have completely different repairs (rebuild the image vs. fix the
    # socket owner). Naming the wrong one sends the reader to fix a uid that
    # was never the problem.
    if ! command -v podman >/dev/null 2>&1; then
        die "no podman client on PATH. It ships in the paperclip image as Debian's apt podman-remote package (symlinked to /usr/local/bin/podman); rebuild the paperclip image if it is missing." 4
    fi
    _pr_diag=""
    [ -s "$PODENV_DIAG" ] && _pr_diag=" Runtime host reported: $(cat "$PODENV_DIAG")"
    die "the podman client is present but the socket at $PODENV_SOCK will not accept a connection. Since the client is present, the likely cause is the access gate: the socket's OWNER uid, which must equal this user's ($(id -u)).${_pr_diag}" 4
}

podenv_require_control_schema() {
    [ -n "$DEVENV_PG_ADMIN_PASSWORD" ] \
        || die "DEVENV_PG_ADMIN_PASSWORD is unset — podenv shares devenv's control database and cannot reach it" 4
    podenv_psql -tAc 'SELECT 1 FROM podenv_lease LIMIT 1' >/dev/null 2>&1 && return 0
    die "podenv control schema not ready — table podenv_lease is missing in '$DEVENV_CONTROL_DB' on $DEVENV_PG_HOST:$DEVENV_PG_PORT. It is created by opc-podenv-seed.sh (paperclip's entrypoint). This is NOT resource exhaustion; releasing leases will not help." 4
}

podman_remote() { podman --remote --url "unix://$PODENV_SOCK" "$@"; }

podenv_slug() { echo "podenv_$(echo "$1" | tr '-' '_')"; }

# Escape a value for embedding inside a single-quoted SQL string literal (the
# SQL standard: a literal quote is doubled, ' -> ''). Every value interpolated
# into a psql -c string below MUST be routed through this — key, slug, image,
# env_var, netns, the --dedicated reason, devenv_owner's output, anything in
# cmd_release. Numeric values (cport, hport) are inserted unquoted and are
# validated elsewhere to be digits-only, so they never reach this function.
# A single un-escaped call site restores the whole SQL-injection class (F1),
# so when adding a new interpolated value here, quote it.
podenv_sql_quote() { printf '%s' "$1" | sed "s/'/''/g"; }

# Smallest free port in the pool for a NEW lease, or the port an existing
# lease already holds. This alone does NOT resolve the concurrent-claim race
# (two callers can pick the same free port before either commits it) — that
# is handled by the retry loop around the INSERT in cmd_provision, which
# reallocates (this function) on every attempt since the port that just lost
# is now taken. UNIQUE(host_port) makes the database the arbiter of who wins.
# No table lock is needed here (unlike devenv's http provider) because a
# lease holds one port, not a contiguous block.
podenv_port_alloc() {
    _pa_key="$1"
    _pa_have="$(podenv_psql -tAc \
        "SELECT COALESCE(host_port::text,'') FROM podenv_lease WHERE key = '$(podenv_sql_quote "$_pa_key")'" \
        2>/dev/null | tr -d '[:space:]')"
    if [ -n "$_pa_have" ]; then echo "$_pa_have"; return 0; fi
    _pa_n="$(podenv_psql -tAc "
        SELECT n FROM generate_series($PODENV_PORT_BASE,
                                     $((PODENV_PORT_BASE + PODENV_PORT_COUNT - 1))) AS n
        WHERE NOT EXISTS (SELECT 1 FROM podenv_lease l WHERE l.host_port = n)
        ORDER BY n LIMIT 1" | tr -d '[:space:]')"
    [ -n "$_pa_n" ] || die "no free podenv port (pool $PODENV_PORT_BASE-$((PODENV_PORT_BASE + PODENV_PORT_COUNT - 1))) — run 'podenv list' and release one" 3
    echo "$_pa_n"
}

# Render {{host}} / {{port}} / {{password}} in a --url template. The double
# brace form matches the expose.urlTemplate syntax this stack already uses;
# ${port} is the wrong syntax here and AGENTS.md records it as an expired
# example from upstream docs.
podenv_render_url() {
    printf '%s' "$1" \
        | sed -e "s|{{host}}|$2|g" -e "s|{{port}}|$3|g" -e "s|{{password}}|$4|g"
}

cmd_provision() {
    key=""; image=""; cport=""; as_var=""; url_tpl=""; netns="pasta"
    dedicated=""; pw_env=""; env_file="$PWD/.env"; run_env=""; run_vol=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --image)        image="${2:?--image needs a value}"; shift 2 ;;
            --port)         cport="${2:?--port needs a value}"; shift 2 ;;
            --as)           as_var="${2:?--as needs a value}"; shift 2 ;;
            --url)          url_tpl="${2:?--url needs a value}"; shift 2 ;;
            # Accumulated in a string, re-split later under `set -f` (see the
            # comment at the re-split in cmd_provision below) so a value
            # containing `*`, `?` or `[` cannot glob-expand against this
            # process's cwd. Field splitting itself still cannot be disabled
            # in POSIX sh without an eval-based array emulation (worse than
            # the restriction), so a VALUE CONTAINING SPACES remains
            # unsupported — that limit stands; only the glob risk is gone.
            --env)          run_env="$run_env ${2:?--env needs K=V}"; shift 2 ;;
            --volume)       run_vol="$run_vol ${2:?--volume needs HOST:CONTAINER}"; shift 2 ;;
            --password-env) pw_env="${2:?--password-env needs a NAME}"; shift 2 ;;
            --netns)        netns="${2:?--netns needs pasta|host}"; shift 2 ;;
            --dedicated)    dedicated="${2:?--dedicated needs a reason}"; shift 2 ;;
            --env-file)     env_file="${2:?--env-file needs a value}"; shift 2 ;;
            --memory)
                # Never accept a flag that does nothing. Measured: podman's
                # --memory is silently ignored in this topology (memory.max
                # stays `max`, no warning), and delegation cannot be obtained
                # without mounting the host's /sys/fs/cgroup.
                die "--memory does not exist here: per-lease memory limits cannot be enforced in this topology (cgroup delegation needs a host /sys/fs/cgroup mount, which invariant 6 forbids). The whole lane is capped by PODENV_MEM_LIMIT in .env." 2 ;;
            -*)             die "unknown flag: $1" 2 ;;
            *)  [ -z "$key" ] || die "unexpected argument: $1" 2; key="$1"; shift ;;
        esac
    done

    [ -n "$key" ]   || die "usage: podenv provision <key> --image REF --port N [--as VAR]" 2
    [ -n "$image" ] || die "--image is required (e.g. --image mysql:5.7)" 2
    [ -n "$cport" ] || die "--port is required — the port the daemon listens on INSIDE the container (mysql: 3306)" 2
    echo "$key" | grep -Eq '^[a-z][a-z0-9-]{1,40}$' \
        || die "invalid key '$key' — must match ^[a-z][a-z0-9-]{1,40}\$" 2
    echo "$cport" | grep -Eq '^[1-9][0-9]*$' || die "--port must be a positive integer" 2
    case "$netns" in pasta|host) ;; *) die "--netns must be pasta or host" 2 ;; esac
    # Conservative OCI reference charset: letters, digits, and the handful of
    # separators a real reference legitimately needs (`.` version/registry
    # dots, `_-` name chars, `/` path segments, `:` tag or port, `@` digest).
    # Catches typos as well as anything crafted to break out of the SQL
    # literal this value is about to be embedded in (F1b) — belt matching
    # the escaping (F1a) below, not a substitute for it.
    echo "$image" | grep -Eq '^[A-Za-z0-9._/:@-]+$' \
        || die "--image '$image' contains characters outside the allowed OCI reference set (letters, digits, . _ - / : @)" 2

    # Default variable name from the image's own name: mysql:5.7 -> MYSQL_ADDR.
    if [ -z "$as_var" ]; then
        as_var="$(printf '%s' "$image" | sed 's|.*/||; s|:.*||; s|[^A-Za-z0-9]|_|g' \
                  | tr '[:lower:]' '[:upper:]')_ADDR"
    fi
    echo "$as_var" | grep -Eq '^[A-Z][A-Z0-9_]*$' \
        || die "--as '$as_var' is not a shell variable name (A-Z, 0-9, _)" 2

    # (b) Variable-name partition. devenv owns a fixed set of .env names; if
    # podenv could write them, one lease would silently overwrite the other's
    # connection string. The list comes from devenv/shared.sh — one home, so
    # there is no drift class here.
    if devenv_env_name_reserved "$as_var"; then
        die "'$as_var' is a variable name devenv owns (DATABASE_URL, VALKEY_URL, DEV_PORT, DEV_PORT_<n>, DEV_URL, DEV_HOST, HOST). Pick another with --as, e.g. --as ${as_var}_LEGACY. A devenv lease and a podenv lease share one .env, which only works while their variable names do not collide." 2
    fi

    # (c) Route gate. devenv already serves some image families, and it should
    # win by default: it is the shared, multi-tenant, modern lane. But an old
    # version of the SAME family is a legitimate podenv case (devenv-pg is
    # pg18; a project stuck on pg9.6 cannot use it), so this is not an absolute
    # ban — it is a detour that costs something. The reason is persisted and
    # listed, which is what keeps it from being a rubber stamp: the same
    # reasoning that keeps `prototype destroy` from having a --yes flag.
    # This is a carelessness catch, not a security boundary — anyone can pass
    # --dedicated, deliberately or not, and that is fine (see the design doc).
    # But an ACCIDENTAL evasion is worth closing: strip a registry/namespace
    # prefix, a `@<digest>` suffix (pinning by digest is good practice, so
    # this must not read as evasion), and a `:<tag>` suffix, then lowercase
    # (a local tag can be uppercase even though Docker Hub repo names cannot)
    # before resolving common renamings of the SAME software via
    # devenv_image_family_alias (shared.sh — one home for this data, same as
    # the reserved-name list above). The lookup itself is a string compare,
    # not a sed pattern match — see devenv_provider_for_family's own comment
    # in shared.sh for why that distinction matters (F2).
    _img_family="$(printf '%s' "$image" | sed 's|.*/||; s|@.*||; s|:.*||' \
        | tr '[:upper:]' '[:lower:]')"
    _img_family="$(devenv_image_family_alias "$_img_family")"
    _img_provider="$(devenv_provider_for_family "$_img_family")"
    if [ -n "$_img_provider" ] && [ -z "$dedicated" ]; then
        die "devenv already serves '$_img_family' — use it instead:
    devenv provision $key --with $_img_provider
devenv is the shared, multi-tenant lane and it should win whenever it can.
If you genuinely need a dedicated or older one (devenv-pg is pg18, devenv-valkey
is valkey 9.1), say why and it will be recorded on the lease:
    podenv provision $key --image $image --port $cport --dedicated \"<reason>\"" 2
    fi

    podenv_require_runtime
    podenv_require_control_schema

    slug="$(podenv_slug "$key")"
    # devenv_derive_password's own die (exit 4) already fires inside this
    # command substitution's subshell on a missing salt; under `set -eu` that
    # nonzero status aborts this script too, with the SAME message and code —
    # an outer `|| die ...` here would only print a redundant second message
    # (F8).
    pw="$(devenv_derive_password "$key" podenv)"

    # --netns host has no port remapping at all (measured: -p is discarded
    # without a warning), so there is nothing to bind and nothing to hold a
    # pool slot for — allocate nothing and store the container's own port as
    # host_port instead (F7). That also makes UNIQUE(host_port) mean
    # something for this mode: two --netns host leases on the same container
    # port now collide at INSERT time instead of silently sharing a port. (In
    # principle a pool-allocated port for some --netns pasta lease could
    # equal a host-netns lease's container port, but the pool is
    # 23000-23015 and the daemons this lane fronts use ports shaped like
    # 80/3306/5432, so that does not arise in practice.)
    if [ "$netns" = host ]; then
        hport="$cport"
    else
        hport="$(podenv_port_alloc "$key")"
    fi

    existing="$(podenv_psql -tAc \
        "SELECT key FROM podenv_lease WHERE key = '$(podenv_sql_quote "$key")'" \
        | tr -d '[:space:]')"

    # Register BEFORE creating: the row is what makes the port exclusive, so it
    # has to exist before anything is bound to it.
    created_now=0
    if [ -z "$existing" ]; then
        created_now=1
        if [ "$netns" = host ]; then
            # host_port IS container_port here (F7) — a UNIQUE violation means
            # another --netns host lease already claims this exact
            # container_port. Reallocating would retry the SAME fixed value
            # forever, so this is not a poolable race: fail once, plainly.
            podenv_psql -v ON_ERROR_STOP=1 -c "
                INSERT INTO podenv_lease
                  (key, slug, image, netns, container_port, host_port, env_var,
                   dedicated_reason, created_by)
                VALUES ('$(podenv_sql_quote "$key")', '$(podenv_sql_quote "$slug")',
                        '$(podenv_sql_quote "$image")', '$(podenv_sql_quote "$netns")',
                        $cport, $hport, '$(podenv_sql_quote "$as_var")',
                        $( [ -n "$dedicated" ] && printf "'%s'" "$(podenv_sql_quote "$dedicated")" || echo NULL ),
                        '$(podenv_sql_quote "$(devenv_owner)")')" >/dev/null 2>/dev/null \
                || die "--port $cport is already claimed by another --netns host lease (host_port must be unique across host-netns leases, and there is no remapping to fall back on) — pick a different --port or release the other lease ('podenv list')" 3
        else
            # The INSERT races the port claim against concurrent callers
            # (paperclip runs agent work concurrently): `podenv_port_alloc`
            # above can hand two callers the SAME free port before either
            # commits it, and UNIQUE(host_port) is what actually decides who
            # wins. This loop is what makes that promise true — on a lost
            # race (host_port already taken by the winner), reallocate (the
            # port that just lost is now occupied) and try again, bounded so
            # real pool exhaustion still surfaces as exit 3 instead of
            # spinning forever.
            _prov_attempt=0
            while :; do
                if podenv_psql -v ON_ERROR_STOP=1 -c "
                    INSERT INTO podenv_lease
                      (key, slug, image, netns, container_port, host_port, env_var,
                       dedicated_reason, created_by)
                    VALUES ('$(podenv_sql_quote "$key")', '$(podenv_sql_quote "$slug")',
                            '$(podenv_sql_quote "$image")', '$(podenv_sql_quote "$netns")',
                            $cport, $hport, '$(podenv_sql_quote "$as_var")',
                            $( [ -n "$dedicated" ] && printf "'%s'" "$(podenv_sql_quote "$dedicated")" || echo NULL ),
                            '$(podenv_sql_quote "$(devenv_owner)")')" >/dev/null 2>/dev/null
                then
                    break
                fi
                _prov_attempt=$((_prov_attempt + 1))
                [ "$_prov_attempt" -lt 5 ] \
                    || die "podenv port pool is contended — lost the host_port race 5 times in a row for '$key'. Try again; if this persists the pool is likely full (run 'podenv list')." 3
                hport="$(podenv_port_alloc "$key")"
            done
        fi
    else
        podenv_psql -c \
            "UPDATE podenv_lease SET last_seen_at = now() WHERE key = '$(podenv_sql_quote "$key")'" \
            >/dev/null
    fi

    # EXIT trap armed only now: it must roll back ONLY a row THIS invocation
    # created (created_now), never tear down a container/row that pre-dates
    # this call just because a later step (container start) had a bad day.
    # Must re-raise the original status — a trap that returns normally would
    # turn a failed provision into exit 0. Mirrors devenv's
    # devenv_provision_cleanup so the two read the same (F3b).
    podenv_provision_cleanup() {
        _pc_rc=$?
        rm -f "${out_file:-}" 2>/dev/null || true
        if [ "$_pc_rc" -ne 0 ] && [ "$created_now" = 1 ]; then
            podman_remote rm -f -v "$slug" >/dev/null 2>&1 || true
            podenv_psql -c \
                "DELETE FROM podenv_lease WHERE key = '$(podenv_sql_quote "$key")'" \
                >/dev/null 2>&1 || true
            note "podenv: rolled back '$key' (provision failed, nothing was left registered)"
        fi
        exit "$_pc_rc"
    }
    trap 'podenv_provision_cleanup' EXIT INT TERM

    # Idempotent container creation. `podman ps -a` is authoritative for its
    # own containers, unlike prototype-restore's problem where a DB row claimed
    # `running` after the process was long gone — the containers ARE this
    # service's child processes, so if it is up and they are listed, they exist.
    if podman_remote container exists "$slug" 2>/dev/null; then
        podman_remote start "$slug" >/dev/null 2>&1 \
            || die "podman could not (re)start the existing container '$slug' for lease '$key'. See why: docker compose exec podenv podman logs $slug" 5
    else
        set -- run -d --name "$slug" \
            --label "opc.podenv.lease=$slug" \
            --label "opc.podenv.key=$key" \
            --restart no \
            --network="$netns"
        [ "$netns" = host ] || set -- "$@" -p "${hport}:${cport}"
        [ -z "$pw_env" ] || set -- "$@" -e "${pw_env}=${pw}"
        # Re-split the accumulated --env/--volume strings on IFS whitespace
        # only: pathname expansion is disabled for the duration (`set -f`),
        # so a value containing `*`, `?` or `[` is passed through literally
        # instead of glob-expanding against this process's cwd and injecting
        # unrelated filenames into the container's env/mounts (F5). Field
        # splitting on spaces still can't be told apart from a literal space
        # in a value — that limitation is unchanged, see the flag-parsing
        # comment above.
        set -f
        for _e in $run_env; do set -- "$@" -e "$_e"; done
        for _v in $run_vol; do set -- "$@" -v "$_v"; done
        set +f
        set -- "$@" "$image"
        podman_remote "$@" >/dev/null \
            || die "podman could not start the lease '$key' (container '$slug', image '$image'). Run the same image by hand to see why: podman run --rm -it $image" 5
    fi

    out_file="$(mktemp)"
    if [ -n "$url_tpl" ]; then
        printf '%s=%s\n' "$as_var" \
            "$(podenv_render_url "$url_tpl" "$PODENV_HOST_NAME" "$hport" "$pw")" > "$out_file"
    else
        printf '%s=%s:%s\n' "$as_var" "$PODENV_HOST_NAME" "$hport" > "$out_file"
    fi
    devenv_env_merge "$env_file" "$out_file"
    if [ -n "$existing" ]; then
        note "podenv: '$key' (existing) → $env_file"
    else
        note "podenv: '$key' provisioned → $env_file"
    fi
    cat "$out_file"
    # No manual rm here — podenv_provision_cleanup removes out_file on EXIT
    # regardless of outcome (mirrors devenv, which does the same).
}

cmd_release() {
    key="${1:?usage: podenv release <key>}"
    podenv_require_control_schema
    if [ -z "$(podenv_psql -tAc \
            "SELECT key FROM podenv_lease WHERE key = '$(podenv_sql_quote "$key")'" \
            | tr -d '[:space:]')" ]; then
        note "podenv: '$key' (absent)"; return 0
    fi
    slug="$(podenv_slug "$key")"

    # `[ -S "$PODENV_SOCK" ]` alone only proves the socket FILE exists — a
    # stale one (left on the persistent volume by a previous run) or one no
    # daemon is listening on would take this branch, have its removal
    # swallowed by `|| true`, and still print success below. Use the same
    # client-present-AND-daemon-answers check podenv_require_runtime uses
    # (podenv_runtime_reachable, F6) so the two can never disagree about what
    # "reachable" means.
    container_gone=0
    if podenv_runtime_reachable; then
        podman_remote rm -f -v "$slug" >/dev/null 2>&1 || true
        if ! podman_remote container exists "$slug" 2>/dev/null; then
            container_gone=1
        fi
    fi

    # Ordering kept exactly as before (warn, THEN delete the row regardless):
    # that is the least-bad choice and matches devenv — a lease you cannot
    # currently reach still needs its row gone so the key can be
    # re-provisioned, but the operator has to be told the port may still be
    # held.
    if [ "$container_gone" != 1 ]; then
        note "podenv: WARNING the container for '$key' ($slug) was NOT confirmed removed."
        note "podenv:   The registry row is going away regardless, which frees port"
        note "podenv:   $(podenv_psql -tAc "SELECT host_port FROM podenv_lease WHERE key = '$(podenv_sql_quote "$key")'" | tr -d '[:space:]') for the next lease — and a container still holding it would"
        note "podenv:   make that lease fail to start. Check and remove it by hand:"
        note "podenv:   docker compose exec podenv podman ps -a --filter name=$slug"
        note "podenv:   docker compose exec podenv podman rm -f -v $slug"
    fi

    podenv_psql -c \
        "DELETE FROM podenv_lease WHERE key = '$(podenv_sql_quote "$key")'" >/dev/null

    if [ "$container_gone" = 1 ]; then
        note "podenv: '$key' released (container removed)"
    else
        note "podenv: '$key' row released; container removal NOT confirmed — see warning above"
    fi
}

cmd_list() {
    podenv_require_control_schema
    podenv_psql -c \
        "SELECT key, image, netns, host_port, env_var,
                CASE WHEN dedicated_reason IS NULL THEN ''
                     ELSE 'dedicated: ' || dedicated_reason END AS dedicated,
                date_trunc('second', idle) AS idle
         FROM podenv_usage"
    # Disk lives in podman's store, which SQL cannot see. Printed here rather
    # than left out: there is no disk quota in this lane (a hard cap needs
    # CAP_SYS_ADMIN, i.e. privileged), so visibility is the only control there
    # is — the same stance devenv takes with devenv_usage.
    if [ -S "$PODENV_SOCK" ]; then
        echo
        echo "podman store:"
        podman_remote system df 2>/dev/null || note "podenv: (store usage unavailable)"
    fi
}

case "${1:-}" in
    provision) shift; cmd_provision "$@" ;;
    release)   shift; cmd_release   "$@" ;;
    list)      shift; cmd_list      "$@" ;;
    -h|--help|help|"")
        sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$1' (provision|release|list)" 2 ;;
esac
