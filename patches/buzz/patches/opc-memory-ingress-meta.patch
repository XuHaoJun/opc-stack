+    #[test]
+    fn dumps_every_scenario_for_the_wire_contract_gate() {
+        let scenarios: serde_json::Map<String, serde_json::Value> = scenarios()
+            .into_iter()
+            .map(|(name, prompt)| (name.to_string(), serde_json::json!({ "prompt": prompt })))
+            .collect();
+        let dump = serde_json::json!({ "scenarios": scenarios });
+
+        let path = dump_path();
+        if let Some(dir) = path.parent() {
+            std::fs::create_dir_all(dir).expect("create the dump directory");
+        }
+        std::fs::write(
+            &path,
+            serde_json::to_vec_pretty(&dump).expect("serialize the dump"),
+        )
+        .expect("write the dump");
+        assert!(
+            path.is_file(),
+            "{path:?} must exist — the gate reads this file, so a silent write failure would read as a pass"
+        );
+    }
+
+    /// `<CARGO_TARGET_DIR>/opc-memory-ingress-dump.json`.
+    ///
+    /// Cargo sets `CARGO_TARGET_DIR` for the test process when the caller set it
+    /// (the image build and the offline gate both do); without it, fall back to
+    /// the workspace `target/` this crate lives under.
+    fn dump_path() -> PathBuf {
+        let target_dir = match std::env::var_os("CARGO_TARGET_DIR") {
+            Some(dir) => PathBuf::from(dir),
+            None => PathBuf::from(env!("CARGO_MANIFEST_DIR"))
