+/// Identity metadata for one batch event (spec §3): the fields Buzz received
+/// from the relay, unmodified.
+///
+/// `content` is the raw [`nostr::Event::content`] — deliberately **not** the
+/// rendered block text, which carries generated headers and tails (`Tags:`,
+/// `Parsed:`) that the event author can forge. `threadId` comes from the
+/// admission-resolved [`SessionScope`], never from parsing the text.
+fn memory_event_meta(batch: &FlushBatch, be: &BatchEvent, role: &str) -> serde_json::Value {
+    serde_json::json!({
+        "eventId": be.event.id.to_hex(),
+        "authorPubkey": be.event.pubkey.to_hex(),
+        "channelId": batch.channel_id.to_string(),
+        "threadId": batch.scope.root_event_id(),
+        "role": role,
+        "content": be.event.content,
+    })
