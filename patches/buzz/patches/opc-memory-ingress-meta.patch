+            channel_info,
+            conversation_context,
+            conversation_context_had_delivered_events: false,
+            profile_lookup: None,
+            has_system_prompt_support: true,
+            base_prompt: None,
+            system_prompt: None,
+            team_instructions: None,
+            agent_canvas: None,
+            standing_context_sent: false,
+        }
+    }
+
+    fn channel_info() -> PromptChannelInfo {
+        PromptChannelInfo {
+            name: "ops".into(),
+            channel_type: "channel".into(),
+            description: None,
+            project: None,
+        }
+    }
+
+    /// Assemble the blocks exactly as `pool::run_prompt_task` does — slash
+    /// command first (if any), then every section — and render the
+    /// `session/prompt` `prompt` array.
+    fn render_prompt(
+        slash_command: Option<&str>,
+        sections_and_metas: (Vec<String>, Vec<Option<serde_json::Value>>),
+    ) -> Vec<serde_json::Value> {
+        let (sections, metas) = sections_and_metas;
+        let blocks = prompt_blocks_with_slash(slash_command, &sections, &metas);
+        build_prompt_params_with_meta("sess-fixture", &blocks)["prompt"]
+            .as_array()
