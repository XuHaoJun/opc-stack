+    /// Identities pinned by the fixture — the tests must assert these literal
+    /// hex values, not whatever a fresh keypair happens to be.
+    const OWNER_HEX: &str = "aabbccddeeff00112233445566778899aabbccddeeff00112233445566778899";
+    const STRANGER_HEX: &str = "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff";
+    const CHANNEL_ID: &str = "3f1c4b2a-0d5e-4c7a-9b8d-1e2f3a4b5c6d";
+    const THREAD_ID: &str = "9d77aa55bb33cc11dd22ee44ff66008811aa22bb33cc44dd55ee66ff77008811";
+
+    fn channel_id() -> Uuid {
+        Uuid::parse_str(CHANNEL_ID).expect("fixture channel id is a uuid")
+    }
+
+    /// A batch event with the fixture's exact id, author and raw content.
+    ///
+    /// Composed from the wire shape the relay delivered rather than by signing:
+    /// the fixture pins literal hex values that no freshly generated (or even
+    /// valid) keypair can produce — the stranger's key is not a curve point at
+    /// all — and `nostr` happily deserializes both without validating them.
+    ///
+    /// `sig` is a placeholder. Nothing on this path verifies it: the contract is
+    /// about the fields Buzz received, and a relay that lies about identity is
+    /// exactly what the metadata has to expose, not what this code re-checks.
+    fn event(id_hex: &str, author_hex: &str, content: &str) -> BatchEvent {
+        let event: nostr::Event = serde_json::from_value(serde_json::json!({
+            "id": id_hex,
+            "pubkey": author_hex,
+            "created_at": 1_760_000_000_u64,
+            "kind": 1,
+            "tags": [],
+            "content": content,
+            "sig": "00".repeat(64),
+        }))
+        .expect("fixture event deserializes");
+        BatchEvent {
+            event,
+            prompt_tag: "mention".into(),
+            received_at: std::time::Instant::now(),
+        }
+    }
+
+    fn batch(
+        scope: SessionScope,
+        events: Vec<BatchEvent>,
+        cancelled: Vec<BatchEvent>,
+    ) -> FlushBatch {
+        FlushBatch {
+            channel_id: scope.channel_id(),
+            scope,
+            cancel_reason: (!cancelled.is_empty()).then_some(CancelReason::Steer),
+            events,
+            cancelled_events: cancelled,
+        }
+    }
+
