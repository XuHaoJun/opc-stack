#!/bin/sh
# prototype — the workflow object: a named, long-lived experiment.
#
#   prototype create    <name> [--template T] [--command CMD] [--idle 7d|never] [--ports N]
#   prototype templates | prototype layers
#   prototype layer add <name> <layer>
#   prototype expose    <name> --command CMD [--idle 7d|never] [--start|--stop]
#   prototype skill add <name> --from <git-url> [--path DIR] [--ref REF] [--only a,b]
#   prototype publish   <name> [--public] [--repo NAME] [--yes]
#   prototype list
#   prototype restore   [--dry-run]
#   prototype destroy   <name>
#
# WHY THIS IS NOT A `devenv` SUBCOMMAND
#
# devenv is a GENERIC development-resource lease: postgres, valkey, an http
# port. It knows nothing about Paperclip and must stay that way, or it stops
# being usable outside this one workflow. Creating a prototype needs three
# things devenv has no business knowing: a directory on disk, a git repo, and a
# Paperclip project. So the paperclip-aware layer lives here and calls devenv
# for leases, rather than devenv growing a paperclip dependency.
#
# WHAT A PROTOTYPE IS (see the http-preview spec, 決策二)
#
#   prototype "recipe-bot"
#     = Paperclip project    name=recipe-bot            <- named, listable
#     + project workspace    cwd=/prototypes/recipe-bot <- its own git
#     + devenv key           recipe-bot                 <- DB + port, stable
#     + runtime service      on the PROJECT workspace   <- URL never changes
#     + issues over time     each one a change request
#
# The service is attached to the PROJECT workspace, not to an execution
# workspace, so it survives with no issue in flight. That is what makes
# "bring it back up so I can look at it" a single call months later.
#
# LIFECYCLE RULE: nothing here ever deletes on its own. `destroy` is the only
# destructive command, it is never called by anything automatic, and it has no
# --yes flag on purpose.
set -eu

PROTOTYPE_ROOT="${PROTOTYPE_ROOT:-/prototypes}"
PROTOTYPE_TEMPLATES="${PROTOTYPE_TEMPLATES:-/usr/local/lib/prototype/templates}"
PROTOTYPE_LAYERS="${PROTOTYPE_LAYERS:-$PROTOTYPE_TEMPLATES/_layers}"
# 7 days. Prototypes idle-stop to free the process; the engineering lane never
# does. Stopping is not deleting: lease, database and files all stay.
PROTOTYPE_DEFAULT_IDLE="${PROTOTYPE_DEFAULT_IDLE:-7d}"
BOARD_KEY_FILE="${BOARD_KEY_FILE:-/paperclip/.opc/board-api.key}"

die()  { echo "prototype: $1" >&2; exit "${2:-1}"; }
note() { echo "$1" >&2; }

# ── paperclip api ────────────────────────────────────────────────────────

# PAPERCLIP_API_URL may or may not already end in /api; upstream's own agent
# prompt normalizes the same way, so do it identically.
api_base() {
    _b="${PAPERCLIP_API_URL:-http://paperclip:3100}"
    _b="${_b%/}"; _b="${_b%/api}"
    echo "$_b"
}

api_key() {
    # Agent runs get PAPERCLIP_API_KEY injected as a per-run token. A human on
    # `docker exec` gets nothing, so fall back to the board key the bootstrap
    # mirrors into the data volume.
    if [ -n "${PAPERCLIP_API_KEY:-}" ]; then
        echo "$PAPERCLIP_API_KEY"
    elif [ -s "$BOARD_KEY_FILE" ]; then
        cat "$BOARD_KEY_FILE"
    else
        die "no Paperclip credential (PAPERCLIP_API_KEY unset and $BOARD_KEY_FILE missing)" 4
    fi
}

api() { # api <METHOD> <PATH> [json-body-on-stdin]
    _m="$1"; _p="$2"
    if [ "$_m" = GET ] || [ "$_m" = DELETE ]; then
        curl -fsS -X "$_m" -H "Authorization: Bearer $(api_key)" "$(api_base)/api$_p"
    else
        curl -fsS -X "$_m" -H "Authorization: Bearer $(api_key)" \
             -H "Content-Type: application/json" --data-binary @- "$(api_base)/api$_p"
    fi
}

company_id() {
    if [ -n "${PAPERCLIP_COMPANY_ID:-}" ]; then echo "$PAPERCLIP_COMPANY_ID"; return; fi
    api GET "/companies" | jq -r '.[0].id // empty'
}

find_project() {
    _name="$1"
    _matches="$(api GET "/companies/$(company_id)/projects" \
        | jq -c --arg n "$_name" '[.[] | select(.name == $n)]')" ||
        die "failed to list Paperclip projects" 4
    _count="$(printf '%s' "$_matches" | jq -r 'length')"
    case "$_count" in
        0) ;;
        1) printf '%s' "$_matches" | jq -r '.[0].id // empty' ;;
        *) _details="$(printf '%s' "$_matches" | jq -r '.[] | "\(.id // "<no-id>") \(.name // "<unnamed>")"' \
               | tr '\n' ';' | sed 's/;$//')"
           die "multiple Paperclip projects named $_name: $_details" 3 ;;
    esac
}

primary_workspace_json() {
    _project="$1"
    if [ "$(printf '%s' "$_project" | jq -r 'if (.primaryWorkspace? | type) == "object" then 1 else 0 end')" -eq 1 ]; then
        printf '%s' "$_project" | jq -c '.primaryWorkspace'
        return
    fi
    _count="$(printf '%s' "$_project" | jq '[.workspaces // [] | .[] | select(.isPrimary == true)] | length')"
    case "$_count" in
        0) printf '%s\n' null ;;
        1) printf '%s' "$_project" | jq -c '(.workspaces // [])[] | select(.isPrimary == true)' ;;
        *) die "multiple primary workspaces ($_count); expected exactly one" 3 ;;
    esac
}

reconcile_workspace_policy() {
    _project_id="$1"
    _project="$(api GET "/projects/$_project_id")" ||
        die "failed to read prototype project $_project_id" 4
    _workspace="$(primary_workspace_json "$_project")"
    [ "$_workspace" != null ] || die "prototype project has no primary workspace" 3
    _workspace_id="$(printf '%s' "$_workspace" | jq -r '.id // empty')"
    [ -n "$_workspace_id" ] || die "prototype primary workspace has no id" 4

    _marker_type="$(printf '%s' "$_workspace" | jq -r '.metadata.opcWorkspaceDefaults | type')"
    _marker_lane="$(printf '%s' "$_workspace" | jq -r '.metadata.opcWorkspaceDefaults.lane // empty')"
    _marker_mode="$(printf '%s' "$_workspace" | jq -r '.metadata.opcWorkspaceDefaults.mode // empty')"
    _marker_strategy="$(printf '%s' "$_workspace" | jq -r '.metadata.opcWorkspaceDefaults.strategyType // empty')"
    _marker_shared="$(printf '%s' "$_workspace" | jq -r '.metadata.opcWorkspaceDefaults.sharedWorkspaceConcurrency // empty')"
    _marker_source="$(printf '%s' "$_workspace" | jq -r '.metadata.opcWorkspaceDefaults.source // empty')"
    _live_enabled="$(printf '%s' "$_project" | jq -r '.executionWorkspacePolicy.enabled // false')"
    _live_mode="$(printf '%s' "$_project" | jq -r '.executionWorkspacePolicy.defaultMode // empty')"
    _live_shared="$(printf '%s' "$_project" | jq -r '.executionWorkspacePolicy.sharedWorkspaceConcurrency // empty')"
    _live_strategy="$(printf '%s' "$_project" | jq -r '.executionWorkspacePolicy.workspaceStrategy.type // empty')"
    _live_workspace="$(printf '%s' "$_project" | jq -r '.executionWorkspacePolicy.defaultProjectWorkspaceId // empty')"
    if [ "$_marker_type" = object ] &&
       [ "$_marker_lane" = prototype ] &&
       [ "$_marker_source" = operatorOverride ] &&
       [ -z "$_marker_shared" ]; then
        note "prototype: operator override marker preserved without shared-concurrency migration"
        return 0
    fi

    if [ "$_marker_type" = object ] &&
       [ "$_marker_lane" = prototype ] &&
       [ "$_marker_mode" = shared_workspace ] &&
       [ "$_marker_strategy" = project_primary ] &&
       [ -z "$_marker_shared" ]; then
        _metadata="$(printf '%s' "$_workspace" | jq -c '
            (.metadata // {}) as $metadata
            | $metadata * {opcWorkspaceDefaults:
                (($metadata.opcWorkspaceDefaults // {})
                 * {sharedWorkspaceConcurrency:"serialize",source:"managedDefault"})}
        ')"
        api PATCH "/projects/$_project_id/workspaces/$_workspace_id" <<EOF >/dev/null
$(jq -nc --argjson metadata "$_metadata" '{metadata:$metadata}')
EOF
        _project="$(api GET "/projects/$_project_id")" ||
            die "failed to verify legacy prototype workspace marker" 4
        _workspace="$(primary_workspace_json "$_project")"
        [ "$(printf '%s' "$_workspace" | jq -r '.id // empty')" = "$_workspace_id" ] ||
            die "prototype primary workspace changed while marking legacy defaults" 4
        printf '%s' "$_workspace" | jq -e '
            .metadata.opcWorkspaceDefaults.lane == "prototype"
            and .metadata.opcWorkspaceDefaults.mode == "shared_workspace"
            and .metadata.opcWorkspaceDefaults.strategyType == "project_primary"
            and .metadata.opcWorkspaceDefaults.sharedWorkspaceConcurrency == "serialize"
            and .metadata.opcWorkspaceDefaults.source == "managedDefault"
        ' >/dev/null 2>&1 || die "legacy prototype workspace marker was not verified" 4
        return 0
    fi

    if [ "$_marker_type" = object ] &&
       [ "$_marker_lane" = prototype ] &&
       [ "$_marker_mode" = shared_workspace ] &&
       [ "$_marker_strategy" = project_primary ] &&
       [ "$_marker_shared" = serialize ]; then
        if [ "$_live_enabled" != true ] ||
           [ "$_live_mode" != "$_marker_mode" ] ||
           [ "$_live_shared" != "$_marker_shared" ] ||
           [ "$_live_strategy" != "$_marker_strategy" ] ||
           [ "$_live_workspace" != "$_workspace_id" ]; then
            note "prototype: workspace policy operator override preserved"
        fi
        return 0
    fi

    _policy="$(printf '%s' "$_project" | jq -c --arg workspace "$_workspace_id" '
        (.executionWorkspacePolicy // {}) as $policy
        | $policy
        * {enabled:true, defaultMode:"shared_workspace",
           sharedWorkspaceConcurrency:"serialize",
           defaultProjectWorkspaceId:$workspace,
           workspaceStrategy:(($policy.workspaceStrategy // {}) * {type:"project_primary"})}
    ')"
    api PATCH "/projects/$_project_id" <<EOF >/dev/null
$(jq -nc --argjson policy "$_policy" '{executionWorkspacePolicy:$policy}')
EOF
    _project="$(api GET "/projects/$_project_id")" ||
        die "failed to verify prototype project workspace policy" 4
    printf '%s' "$_project" | jq -e --arg workspace "$_workspace_id" '
        .executionWorkspacePolicy.enabled == true
        and .executionWorkspacePolicy.defaultMode == "shared_workspace"
        and .executionWorkspacePolicy.sharedWorkspaceConcurrency == "serialize"
        and .executionWorkspacePolicy.defaultProjectWorkspaceId == $workspace
        and .executionWorkspacePolicy.workspaceStrategy.type == "project_primary"
    ' >/dev/null 2>&1 || die "prototype workspace policy was not verified" 4

    _workspace="$(primary_workspace_json "$_project")"
    _metadata="$(printf '%s' "$_workspace" | jq -c '
        (.metadata // {}) as $metadata
        | $metadata * {opcWorkspaceDefaults:
            (($metadata.opcWorkspaceDefaults // {})
             * {lane:"prototype", mode:"shared_workspace",
                strategyType:"project_primary",
                sharedWorkspaceConcurrency:"serialize",
                source:"managedDefault"})}
    ')"
    api PATCH "/projects/$_project_id/workspaces/$_workspace_id" <<EOF >/dev/null
$(jq -nc --argjson metadata "$_metadata" '{metadata:$metadata}')
EOF
    _project="$(api GET "/projects/$_project_id")" ||
        die "failed to verify prototype workspace marker" 4
    _workspace="$(primary_workspace_json "$_project")"
    [ "$(printf '%s' "$_workspace" | jq -r '.id // empty')" = "$_workspace_id" ] ||
        die "prototype primary workspace changed while marking defaults" 4
    printf '%s' "$_workspace" | jq -e '
        .metadata.opcWorkspaceDefaults.lane == "prototype"
        and .metadata.opcWorkspaceDefaults.mode == "shared_workspace"
        and .metadata.opcWorkspaceDefaults.strategyType == "project_primary"
        and .metadata.opcWorkspaceDefaults.sharedWorkspaceConcurrency == "serialize"
        and .metadata.opcWorkspaceDefaults.source == "managedDefault"
    ' >/dev/null 2>&1 || die "prototype workspace marker was not verified" 4
}

primary_workspace_id() {
    _project="$(api GET "/projects/$1")"
    primary_workspace_json "$_project" | jq -r '.id // empty'
}

# ── helpers ──────────────────────────────────────────────────────────────

check_name() {
    # Same rule as devenv keys: the name is simultaneously the project name,
    # the devenv key and a directory name, so it has to satisfy the strictest.
    echo "$1" | grep -Eq '^[a-z][a-z0-9-]{1,40}$' \
        || die "invalid name '$1' — must match ^[a-z][a-z0-9-]{1,40}\$" 2
}

# 7d / 30m / 3600 / never  ->  seconds, or empty for never
idle_seconds() {
    case "$1" in
        never|none|off) echo "" ;;
        *d) echo $(( ${1%d} * 86400 )) ;;
        *h) echo $(( ${1%h} * 3600 )) ;;
        *m) echo $(( ${1%m} * 60 )) ;;
        *[!0-9]*) die "bad --idle '$1' (use 7d / 12h / 30m / seconds / never)" 2 ;;
        *) echo "$1" ;;
    esac
}

# Run a command as the runtime user when we are root.
#
# Anything that writes into the prototype tree OR into the runtime user's home
# must run as that user. pnpm keeps its store index under $HOME, and a single
# root-run `pnpm add` leaves it root-owned — after which every later install by
# the agent dies with "attempt to write a readonly database", nowhere near the
# thing that caused it.
as_runtime() { # as_runtime <dir> <sh -c string>
    if [ "$(id -u)" = 0 ] && id "$RUNTIME_USER" >/dev/null 2>&1; then
        su "$RUNTIME_USER" -s /bin/sh -c "cd '$1' && $2"
    else
        ( cd "$1" && sh -c "$2" )
    fi
}

# Hand a path to the runtime user.
#
# The paperclip server (and therefore every dev server it spawns) runs as
# `node`. An agent's `prototype create` already runs as node, but a human on
# `docker compose exec` is root, and root-owned files break the runtime in a
# way that looks nothing like a permissions problem: `prototype expose --start`
# fails with a 500 whose cause is `EACCES: mkdir .next/dev` buried in the
# paperclip log. Same root cause as the git ownership issue below — one tree,
# two users.
RUNTIME_USER="${PROTOTYPE_RUNTIME_USER:-node}"
own() {
    [ "$(id -u)" = 0 ] || return 0
    id "$RUNTIME_USER" >/dev/null 2>&1 || return 0
    chown -R "$RUNTIME_USER:$RUNTIME_USER" "$1" 2>/dev/null || true
}

# git, scoped to a prototype tree.
#
# The tree belongs to `node` (the runtime user), but a human running
# `docker compose exec paperclip prototype ...` is root, and git then refuses
# with "detected dubious ownership". Worse than the error: the calls guarded by
# `|| true` (the commits in create / skill add) just quietly do nothing, so a
# root-run command appears to succeed and commits nothing. safe.directory is
# set per invocation rather than globally so the exemption stays scoped.
pgit() {
    _g_dir="$1"; shift
    git -c "safe.directory=$_g_dir" -C "$_g_dir" "$@"
}

env_get() { # read a key out of the prototype's .env
    _f="$PROTOTYPE_ROOT/$1/.env"
    [ -f "$_f" ] || return 1
    sed -n "s/^$2=//p" "$_f" | head -1
}

# ── commands ─────────────────────────────────────────────────────────────

cmd_create() {
    name=""; command_=""; idle="$PROTOTYPE_DEFAULT_IDLE"; ports=1; template=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --template) template="${2:?--template needs a value}"; shift 2 ;;
            --command) command_="${2:?--command needs a value}"; shift 2 ;;
            --idle)    idle="${2:?--idle needs a value}"; shift 2 ;;
            --ports)   ports="${2:?--ports needs a value}"; shift 2 ;;
            -*) die "unknown flag: $1" 2 ;;
            *)  [ -z "$name" ] || die "unexpected argument: $1" 2; name="$1"; shift ;;
        esac
    done
    [ -n "$name" ] || die "usage: prototype create <name> [--command CMD] [--idle 7d|never]" 2
    check_name "$name"

    dir="$PROTOTYPE_ROOT/$name"

    # Every step below is idempotent, so a half-finished create is repaired by
    # running it again rather than by cleaning up by hand.
    mkdir -p "$dir"
    own "$dir"
    if [ ! -d "$dir/.git" ]; then
        pgit "$dir" init -q
        # An empty first commit gives the agent a base to diff against; without
        # it `git log`/`git diff` fail on a fresh repo and confuse the model.
        pgit "$dir" -c user.email=prototype@opc -c user.name=prototype \
            commit -q --allow-empty -m "prototype: $name" 2>/dev/null || true
        note "prototype: git repo initialised at $dir"
    fi

    # Template BEFORE provision: the template ships a .gitignore that keeps .env
    # out of git, and devenv writes that .env. Copying afterwards would either
    # clobber the lease or land the ignore rule too late.
    if [ -n "$template" ]; then
        tdir="$PROTOTYPE_TEMPLATES/$template"
        [ -d "$tdir" ] || die "unknown template '$template' (see: prototype templates)" 2
        # Never overwrite existing work — create is idempotent and a re-run on a
        # started prototype must not reset it to the scaffold.
        if [ -n "$(ls -A "$dir" 2>/dev/null | grep -v '^\.git$' | grep -v '^\.env$' || true)" ]; then
            note "prototype: '$name' already has files — skipping template '$template'"
        else
            cp -r "$tdir"/. "$dir"/
            note "prototype: scaffolded from template '$template'"
        fi
    fi
    own "$dir"

    devenv provision "$name" --with "postgres,valkey,http=$ports" --env-file "$dir/.env" >/dev/null
    own "$dir"   # devenv wrote .env as whoever ran us
    port="$(env_get "$name" DEV_PORT)" || die "devenv did not write DEV_PORT" 1
    url="$(env_get "$name" DEV_URL)"

    company="$(company_id)"
    project="$(find_project "$name")"
    if [ -z "$project" ]; then
        project="$(printf '%s' "$(jq -nc \
            --arg n "$name" --arg d "Prototype. Working tree $dir; devenv key $name; preview $url." \
            --arg cwd "$dir" \
            '{name:$n, description:$d, status:"in_progress",
              workspace:{name:"primary", sourceType:"local_path", cwd:$cwd, isPrimary:true}}')" \
            | api POST "/companies/$company/projects" | jq -r '.id')"
        [ -n "$project" ] && [ "$project" != null ] || die "failed to create Paperclip project" 1
        note "prototype: created Paperclip project $project"
    else
        note "prototype: Paperclip project exists ($project)"
    fi

    reconcile_workspace_policy "$project"

    # Attach the current ticket to the project. Paperclip does not do this for
    # us — an issue created before the project existed keeps projectId null, so
    # the board shows the prototype and the ticket as unrelated things and the
    # next run gets no workspace. Doing it here rather than asking the agent to
    # remember: PAPERCLIP_TASK_ID is injected on every issue-driven run, so the
    # information is already at hand exactly when it is needed.
    if [ -n "${PAPERCLIP_TASK_ID:-}" ]; then
        cur="$(api GET "/issues/$PAPERCLIP_TASK_ID" 2>/dev/null | jq -r '.projectId // empty')"
        if [ -z "$cur" ]; then
            jq -nc --arg p "$project" '{projectId:$p}' \
                | api PATCH "/issues/$PAPERCLIP_TASK_ID" >/dev/null 2>&1 \
                && note "prototype: linked ticket $PAPERCLIP_TASK_ID to project" \
                || note "prototype: WARNING could not link ticket to project"
        elif [ "$cur" != "$project" ]; then
            note "prototype: WARNING ticket is on a different project ($cur) — not reassigning"
        fi
    fi

    if [ -n "$command_" ]; then
        cmd_expose "$name" --command "$command_" --idle "$idle" --start
    else
        note "prototype: '$name' ready — $dir (preview port $port, not yet exposed)"
        note "prototype:   next: prototype expose $name --command '<dev server cmd>' --start"
    fi
}

cmd_expose() {
    name=""; command_=""; idle="$PROTOTYPE_DEFAULT_IDLE"; action=""; svc=web
    while [ $# -gt 0 ]; do
        case "$1" in
            --command) command_="${2:?--command needs a value}"; shift 2 ;;
            --idle)    idle="${2:?--idle needs a value}"; shift 2 ;;
            --service) svc="${2:?--service needs a value}"; shift 2 ;;
            --start)   action=start; shift ;;
            --stop)    action=stop; shift ;;
            -*) die "unknown flag: $1" 2 ;;
            *)  [ -z "$name" ] || die "unexpected argument: $1" 2; name="$1"; shift ;;
        esac
    done
    [ -n "$name" ] || die "usage: prototype expose <name> --command CMD [--idle 7d|never] [--start]" 2
    check_name "$name"

    project="$(find_project "$name")"
    [ -n "$project" ] || die "no prototype named '$name' — run 'prototype create $name' first" 2
    ws="$(primary_workspace_id "$project")"
    [ -n "$ws" ] || die "prototype '$name' has no primary workspace" 1

    if [ "$action" = stop ]; then
        printf '{}' | api POST "/projects/$project/workspaces/$ws/runtime-services/stop" >/dev/null
        note "prototype: '$name' service stopped (nothing was deleted)"
        return 0
    fi

    [ -n "$command_" ] || die "--command is required (it is what gets run to serve the preview)" 2
    port="$(env_get "$name" DEV_PORT)" || die "'$name' has no DEV_PORT — run 'prototype create $name'" 2
    secs="$(idle_seconds "$idle")"

    # port is an EXPLICIT number, never {"type":"auto"}: auto allocates from the
    # kernel's ephemeral range, which docker has not published, so the URL would
    # render fine and connect to nothing.
    #
    # readiness probes 127.0.0.1 (inside the container) while expose advertises
    # the host address — two separate fields for two separate viewpoints.
    svc_json="$(jq -nc --arg n "$svc" --arg c "$command_" --argjson p "$port" \
        --arg url "$(env_get "$name" DEV_URL)" --arg secs "$secs" '
        {name:$n, command:$c, cwd:".", port:$p, lifecycle:"shared",
         readiness:{type:"http", urlTemplate:"http://127.0.0.1:{{port}}"},
         expose:{type:"url", urlTemplate:$url}}
        + (if $secs == "" then {} else
             {stopPolicy:{type:"idle_timeout", idleSeconds:($secs|tonumber)}} end)')"

    # Upsert by name so re-running with a changed command updates the entry
    # instead of appending a second service on the same port.
    existing="$(api GET "/projects/$project" \
        | jq -c --arg id "$ws" '((.workspaces // [])[] | select(.id == $id)
            | .runtimeConfig.workspaceRuntime.services) // []')"
    merged="$(printf '%s' "$existing" | jq -c --argjson s "$svc_json" \
        '(map(select(.name != $s.name)) + [$s])')"

    jq -nc --argjson svcs "$merged" \
        '{runtimeConfig:{workspaceRuntime:{services:$svcs}, desiredState:"running"}}' \
        | api PATCH "/projects/$project/workspaces/$ws" >/dev/null

    devenv mark-exposed "$name" >/dev/null 2>&1 || true
    note "prototype: '$name' service '$svc' registered on port $port (idle=${idle})"

    if [ "$action" = start ]; then
        printf '{}' | api POST "/projects/$project/workspaces/$ws/runtime-services/start" >/dev/null
        note "prototype: started → $(env_get "$name" DEV_URL)"
    fi
}

# Vendor a skill INTO the prototype's own tree, which is what "project-only
# skill" means in practice: omp discovers skills from the working directory
# (.claude/skills, .agents/skills, .omp/skills — all three are in the binary),
# so a skill that lives in the project is visible to that project's sessions
# and to nothing else. No company-library entry, no other prototype affected.
#
# .claude/skills is the target because it is also what Claude Code reads —
# swapping the engine later keeps the skill working.
#
# Pinned to a resolved SHA with a SOURCE manifest, the same discipline as the
# image-level vendored skills: an unpinned copy silently becomes a different
# skill the next time anyone re-runs this.
cmd_skill_add() {
    name=""; from=""; path="skills"; ref=""; only=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --from) from="${2:?--from needs a git URL}"; shift 2 ;;
            --path) path="${2:?--path needs a value}"; shift 2 ;;
            --ref)  ref="${2:?--ref needs a value}"; shift 2 ;;
            --only) only="${2:?--only needs a comma list}"; shift 2 ;;
            -*) die "unknown flag: $1" 2 ;;
            *)  [ -z "$name" ] || die "unexpected argument: $1" 2; name="$1"; shift ;;
        esac
    done
    [ -n "$name" ] || die "usage: prototype skill add <name> --from <git-url> [--path DIR] [--ref REF] [--only a,b]" 2
    [ -n "$from" ] || die "--from is required" 2
    check_name "$name"
    dir="$PROTOTYPE_ROOT/$name"
    [ -d "$dir" ] || die "no prototype named '$name' — run 'prototype create $name' first" 2

    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT INT TERM
    if [ -n "$ref" ]; then
        git clone -q --depth 1 --branch "$ref" "$from" "$tmp/src" || die "clone failed: $from@$ref" 1
    else
        git clone -q --depth 1 "$from" "$tmp/src" || die "clone failed: $from" 1
    fi
    sha="$(git -C "$tmp/src" rev-parse HEAD)"
    src="$tmp/src/$path"
    [ -d "$src" ] || die "path '$path' not found in $from" 2

    mkdir -p "$dir/.claude/skills"
    count=0
    for sk in "$src"/*/; do
        [ -f "$sk/SKILL.md" ] || continue
        slug="$(basename "$sk")"
        if [ -n "$only" ]; then
            case ",$only," in *",$slug,"*) ;; *) continue ;; esac
        fi
        rm -rf "$dir/.claude/skills/$slug"
        cp -r "$sk" "$dir/.claude/skills/$slug"
        cat > "$dir/.claude/skills/$slug/SOURCE" <<SRC
# Vendored skill — do not edit these files here; re-run the command below.
#   prototype skill add $name --from $from --path $path --ref $sha --only $slug
repo=$from
path=$path/$slug
sha=$sha
ref=${ref:-HEAD}
fetched=$(date -u +%Y-%m-%d)
SRC
        count=$((count + 1))
        note "prototype: vendored skill '$slug'"
    done
    [ "$count" -gt 0 ] || die "no SKILL.md found under '$path' in $from" 2

    # Commit into the prototype's own repo: the skill is part of the project
    # now, and a later `git diff` should not be full of unexplained files.
    pgit "$dir" add .claude/skills >/dev/null 2>&1 || true
    pgit "$dir" -c user.email=prototype@opc -c user.name=prototype \
        commit -q -m "chore: vendor $count skill(s) from $from @ ${sha}" >/dev/null 2>&1 || true
    own "$dir"
    note "prototype: $count skill(s) in $dir/.claude/skills (pinned $sha)"
}

# Bring back every service that is supposed to be running.
#
# Paperclip records desiredState on the workspace but has NO boot reconciler
# that acts on it (checked: the server has five periodic timers and none of
# them touch workspaces). Runtime services are child processes of the paperclip
# server, so a container recreate — an image rebuild, `compose up -d`, a host
# reboot — kills every preview and nothing brings it back. The prototype looks
# fine on the board, its URL is simply dead, and no log says why. That was
# happening several times an hour during development.
#
# Liveness is probed on 127.0.0.1:<port> INSIDE the container rather than
# trusted from the DB: after a recreate the rows still say "running" while no
# process exists. The dev servers bind 0.0.0.0 (devenv insists on it), so
# loopback here is a true test of "is something actually listening".
cmd_restore() {
    dry=0
    [ "${1:-}" = "--dry-run" ] && dry=1

    company="$(company_id)"
    [ -n "$company" ] || die "cannot reach Paperclip" 4

    started=0; skipped=0
    for pid in $(api GET "/companies/$company/projects" | jq -r '.[].id'); do
        proj="$(api GET "/projects/$pid")" || continue
        pname="$(printf '%s' "$proj" | jq -r '.name')"
        # Only the primary workspace: that is where `prototype expose` writes.
        ws="$(printf '%s' "$proj" | jq -c '(.workspaces // [])[] | select(.isPrimary == true)' | head -1)"
        [ -n "$ws" ] || continue
        want="$(printf '%s' "$ws" | jq -r '.runtimeConfig.desiredState // ""')"
        [ "$want" = "running" ] || continue

        port="$(printf '%s' "$ws" | jq -r '[.runtimeConfig.workspaceRuntime.services[]? | .port] | first // empty')"
        if [ -n "$port" ] && curl -fsS -o /dev/null --max-time 2 "http://127.0.0.1:$port/" 2>/dev/null; then
            skipped=$((skipped + 1)); continue
        fi

        wsid="$(printf '%s' "$ws" | jq -r '.id')"
        if [ "$dry" = 1 ]; then
            note "prototype: would restart '$pname' (port ${port:-?})"
            started=$((started + 1)); continue
        fi
        if printf '{}' | api POST "/projects/$pid/workspaces/$wsid/runtime-services/start" >/dev/null 2>&1; then
            note "prototype: restarted '$pname' (port ${port:-?})"
            started=$((started + 1))
        else
            note "prototype: WARNING could not restart '$pname'"
        fi
    done
    note "prototype: restore done — $started started, $skipped already up"
}

# Push a prototype to the operator'"'"'s GitHub. Deliberately manual.
#
# This is the one command here that reaches outside the machine, using the
# operator'"'"'s own gh credential. It is never part of a ticket'"'"'s definition of
# done and agents must not call it on their own initiative — "the prototype
# turned out well, publish it" is a decision, not a cleanup step.
cmd_publish() {
    name=""; vis="--private"; repo=""; yes=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --public)  vis="--public"; shift ;;
            --private) vis="--private"; shift ;;
            --repo)    repo="${2:?--repo needs a value}"; shift 2 ;;
            --yes)     yes=1; shift ;;
            -*) die "unknown flag: $1" 2 ;;
            *)  [ -z "$name" ] || die "unexpected argument: $1" 2; name="$1"; shift ;;
        esac
    done
    [ -n "$name" ] || die "usage: prototype publish <name> [--public] [--repo NAME] [--yes]" 2
    check_name "$name"
    dir="$PROTOTYPE_ROOT/$name"
    [ -d "$dir/.git" ] || die "'$name' is not a git repository" 2
    repo="${repo:-$name}"

    command -v gh >/dev/null 2>&1 || die "gh is not installed" 4
    # `docker compose exec` does not inherit what the entrypoint exported, so
    # GH_CONFIG_DIR / GIT_SSH_COMMAND are missing in exactly the session a human
    # uses to run this. Source the same seed the entrypoint does rather than
    # making the operator remember it.
    if [ -z "${GH_CONFIG_DIR:-}" ] && [ -r /usr/local/bin/opc-gh-seed.sh ]; then
        . /usr/local/bin/opc-gh-seed.sh
        opc_gh_seed >/dev/null 2>&1 || true
    fi
    gh auth status >/dev/null 2>&1 || die "gh is not authenticated (GH_CONFIG_DIR=${GH_CONFIG_DIR:-unset})" 4

    # Refuse to push tracked secrets. .env holds DATABASE_URL with a real
    # password; the generated .gitignore covers it, but a prototype is
    # hand-edited code and one `git add -f` would put credentials on GitHub
    # permanently. Cheap to check, impossible to undo.
    leaked="$(pgit "$dir" ls-files | grep -E '(^|/)\.env($|\.)' || true)"
    if [ -n "$leaked" ]; then
        note "refusing to publish: these tracked files look like secrets —"
        printf '  %s\n' $leaked >&2
        die "remove them from git history first (git rm --cached, then rewrite if already committed)" 2
    fi

    dirty="$(pgit "$dir" status --porcelain | head -5)"
    [ -z "$dirty" ] || note "note: uncommitted changes will NOT be pushed:
$dirty"

    if pgit "$dir" remote get-url origin >/dev/null 2>&1; then
        target="$(pgit "$dir" remote get-url origin)"
        action="push to the existing remote"
    else
        target="$(gh api user --jq .login 2>/dev/null)/$repo"
        action="create a NEW ${vis#--} repo and push"
    fi

    echo "About to $action:"
    echo "  prototype  $name  ($dir)"
    echo "  remote     $target"
    echo "  commits    $(pgit "$dir" rev-list --count HEAD 2>/dev/null || echo '?')"
    if [ "$yes" != 1 ]; then
        printf "Proceed? [y/N] "
        read -r ans || ans=""
        case "$ans" in y|Y|yes|YES) ;; *) die "cancelled — nothing was pushed" 2 ;; esac
    fi

    branch="$(pgit "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
    if pgit "$dir" remote get-url origin >/dev/null 2>&1; then
        pgit "$dir" push -u origin "$branch" || die "push failed" 1
        note "prototype: pushed to $target"
    else
        ( cd "$dir" && gh repo create "$repo" "$vis" --source . --remote origin --push ) \
            || die "gh repo create failed" 1
        note "prototype: published → https://github.com/$target"
    fi
}

cmd_layers() {
    [ -d "$PROTOTYPE_LAYERS" ] || { note "no layers installed"; return 0; }
    for l in "$PROTOTYPE_LAYERS"/*/; do
        [ -d "$l" ] || continue
        n="$(basename "$l")"
        printf '%-10s %s\n' "$n" "$(sed -n '1p' "$l/README.md" 2>/dev/null | sed 's/^# *//')"
    done
}

# Layers are additive and independent BY CONTRACT. A layer that needs to know
# another layer has been applied is a design failure, not a feature to support:
# it turns testing from linear (base, base+each) into combinatorial, and this
# stack has no capacity to test a matrix.
cmd_layer_add() {
    name="${1:?usage: prototype layer add <name> <layer>}"
    layer="${2:?usage: prototype layer add <name> <layer>}"
    check_name "$name"
    dir="$PROTOTYPE_ROOT/$name"
    [ -d "$dir" ] || die "no prototype named '$name'" 2
    ldir="$PROTOTYPE_LAYERS/$layer"
    [ -x "$ldir/apply.sh" ] || die "unknown layer '$layer' (see: prototype layers)" 2

    own "$dir"
    as_runtime "$dir" "sh '$ldir/apply.sh'" || die "layer '$layer' failed" 1
    own "$dir"

    pgit "$dir" add -A >/dev/null 2>&1 || true
    pgit "$dir" -c user.email=prototype@opc -c user.name=prototype \
        commit -q -m "chore: apply '$layer' layer" >/dev/null 2>&1 || true
    note "prototype: layer '$layer' applied to '$name'"
}

cmd_templates() {
    [ -d "$PROTOTYPE_TEMPLATES" ] || { note "no templates installed"; return 0; }
    for t in "$PROTOTYPE_TEMPLATES"/*/; do
        [ -d "$t" ] || continue
        n="$(basename "$t")"
        case "$n" in _*) continue ;; esac
        printf '%-16s %s\n' "$n" "$(sed -n '3p' "$t/README.md" 2>/dev/null)"
    done
}

cmd_list() {
    company="$(company_id)"
    printf '%-24s %-8s %-26s %s\n' NAME PORT URL DIR
    api GET "/companies/$company/projects" | jq -r '.[] | .name' | while read -r n; do
        [ -d "$PROTOTYPE_ROOT/$n" ] || continue
        printf '%-24s %-8s %-26s %s\n' \
            "$n" "$(env_get "$n" DEV_PORT || echo -)" \
            "$(env_get "$n" DEV_URL || echo -)" "$PROTOTYPE_ROOT/$n"
    done
    note ""
    note "resource usage (databases, leases): devenv list"
}

cmd_destroy() {
    name="${1:-}"
    [ -n "$name" ] || die "usage: prototype destroy <name>" 2
    check_name "$name"

    dir="$PROTOTYPE_ROOT/$name"
    project="$(find_project "$name")"
    [ -n "$project" ] || [ -d "$dir" ] || die "no prototype named '$name'" 2

    # Show everything that is about to be lost BEFORE asking. Deletion here is
    # rare and irreversible; the confirmation is worth more than the keystrokes.
    echo "About to permanently destroy prototype '$name':"
    echo
    [ -d "$dir" ] && echo "  working tree   $dir  ($(du -sh "$dir" 2>/dev/null | cut -f1))"
    if [ -n "$project" ]; then
        _n_issues="$(api GET "/companies/$(company_id)/issues" \
            | jq -r --arg p "$project" '[.[] | select(.projectId == $p)] | length' 2>/dev/null || echo '?')"
        echo "  Paperclip proj $project  ($_n_issues issues)"
    fi
    docker_devenv="$(devenv list 2>/dev/null | grep -E "^ *$name " || true)"
    [ -n "$docker_devenv" ] && echo "  devenv lease   $docker_devenv"
    echo "  database       devenv_$(echo "$name" | tr '-' '_')  (dropped)"
    echo "  preview port   $(env_get "$name" DEV_PORT 2>/dev/null || echo -)  (returned to the pool)"
    echo
    # Typing the name, not y/N: this is the one action in the stack that cannot
    # be undone, and y/N is one stray keystroke away from yes. There is
    # deliberately no --yes flag — it would reduce "never delete without my
    # approval" to a single line of script.
    printf "Type the prototype name to confirm: "
    read -r confirm || confirm=""
    [ "$confirm" = "$name" ] || die "confirmation did not match — nothing was deleted" 2

    if [ -n "$project" ]; then
        ws="$(primary_workspace_id "$project")"
        if [ -n "$ws" ]; then
            printf '{}' | api POST "/projects/$project/workspaces/$ws/runtime-services/stop" >/dev/null 2>&1 || true
        fi
        api DELETE "/projects/$project" >/dev/null 2>&1 \
            || note "prototype: WARNING could not delete Paperclip project $project — remove it from the board"
    fi
    devenv release "$name" >/dev/null 2>&1 || note "prototype: WARNING devenv release failed for '$name'"
    rm -rf "$dir"
    note "prototype: '$name' destroyed"
}

case "${1:-}" in
    create)  shift; cmd_create  "$@" ;;
    expose)  shift; cmd_expose  "$@" ;;
    list)      shift; cmd_list      "$@" ;;
    templates) shift; cmd_templates "$@" ;;
    layers)    shift; cmd_layers    "$@" ;;
    layer)
        shift
        case "${1:-}" in
            add) shift; cmd_layer_add "$@" ;;
            *) die "usage: prototype layer add <name> <layer>" 2 ;;
        esac ;;
    restore) shift; cmd_restore "$@" ;;
    publish) shift; cmd_publish "$@" ;;
    destroy) shift; cmd_destroy "$@" ;;
    skill)
        shift
        case "${1:-}" in
            add) shift; cmd_skill_add "$@" ;;
            *) die "usage: prototype skill add <name> --from <git-url>" 2 ;;
        esac ;;
    -h|--help|help|"") sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$1' (create|expose|skill|layer|templates|layers|list|restore|publish|destroy)" 2 ;;
esac
