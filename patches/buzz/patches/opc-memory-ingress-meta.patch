+
+    fn thread_scope() -> SessionScope {
+        SessionScope::Thread {
+            channel_id: channel_id(),
+            root_event_id: THREAD_ID.to_string(),
+        }
+    }
+
+    /// `_meta` of block `i`, or `None` when the block carries no `_meta` key.
+    ///
+    /// The key's *absence* is part of the contract (spec §3): `Some(Value::Null)`
