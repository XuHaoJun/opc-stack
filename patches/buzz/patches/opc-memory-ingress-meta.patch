+/// and `"prior"` for [`FlushBatch::cancelled_events`] (earlier messages
+/// re-delivered by a cancel+merge — not a capture candidate).
+fn memory_events_meta(
+    batch: &FlushBatch,
+    events: &[BatchEvent],
+    role: &str,
+) -> Option<serde_json::Value> {
+    if events.is_empty() {
+        return None;
+    }
+    let events: Vec<serde_json::Value> = events
+        .iter()
+        .map(|be| memory_event_meta(batch, be, role))
+        .collect();
+    Some(serde_json::json!({ "buzz": { "memoryEvents": events } }))
+}
