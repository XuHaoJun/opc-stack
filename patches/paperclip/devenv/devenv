#!/bin/sh
# devenv — development environment resource leases for Paperclip agents.
#
#   devenv provision <key> [--with postgres,valkey] [--lifecycle keep] [--env-file PATH]
#   devenv release   <key>
#   devenv list
#
# Design notes live in
# docs/superpowers/specs/2026-08-18-devenv-resource-provisioning-design.md.
# Short version: agents get isolated backends with ONE idempotent command and
# read them back from .env under standard names (DATABASE_URL / VALKEY_URL),
# so the application never learns devenv exists.
#
# Reclamation is manual (`devenv release`). Accumulation is made visible by the
# devenv_usage view rather than by a reaper — see the spec's "監控" section.
#
# Exit codes: 0 ok / 2 bad usage / 3 resources exhausted / 4 backend unreachable
set -eu

DEVENV_LIB="${DEVENV_LIB:-/usr/local/lib/devenv}"

DEVENV_PG_HOST="${DEVENV_PG_HOST:-devenv-pg}"
DEVENV_PG_PORT="${DEVENV_PG_PORT:-5432}"
DEVENV_PG_ADMIN_USER="${DEVENV_PG_ADMIN_USER:-postgres}"
DEVENV_PG_ADMIN_PASSWORD="${DEVENV_PG_ADMIN_PASSWORD:-}"
DEVENV_CONTROL_DB="${DEVENV_CONTROL_DB:-devenv_control}"

DEVENV_VALKEY_HOST="${DEVENV_VALKEY_HOST:-devenv-valkey}"
DEVENV_VALKEY_PORT="${DEVENV_VALKEY_PORT:-6379}"
DEVENV_VALKEY_PASSWORD="${DEVENV_VALKEY_PASSWORD:-}"
# Slot 0 is reserved for devenv itself, so usable ids are 1..DATABASES-1.
DEVENV_VALKEY_DATABASES="${DEVENV_VALKEY_DATABASES:-64}"

DEVENV_SECRET_SALT="${DEVENV_SECRET_SALT:-}"

die()   { echo "devenv: $1" >&2; exit "${2:-1}"; }
note()  { echo "$1" >&2; }

# ── backend access ───────────────────────────────────────────────────────

devenv_psql() {
    # -w: never prompt for a password. A missing/wrong credential must fail
    # fast — an interactive prompt would hang a non-interactive agent run
    # forever, with no output explaining why.
    # client_min_messages=warning: idempotent DDL emits "already exists"
    # NOTICEs on every re-run, which would drown the one line the caller cares
    # about (provisioned / existing).
    PGPASSWORD="$DEVENV_PG_ADMIN_PASSWORD" \
    PGOPTIONS='-c client_min_messages=warning' psql \
        -h "$DEVENV_PG_HOST" -p "$DEVENV_PG_PORT" -U "$DEVENV_PG_ADMIN_USER" \
        -w -q "$@"
}
devenv_psql_admin()   { devenv_psql -d postgres "$@"; }
devenv_psql_control() { devenv_psql -d "$DEVENV_CONTROL_DB" "$@"; }

devenv_valkey_admin() {
    if [ -n "$DEVENV_VALKEY_PASSWORD" ]; then
        redis-cli -h "$DEVENV_VALKEY_HOST" -p "$DEVENV_VALKEY_PORT" \
            -a "$DEVENV_VALKEY_PASSWORD" --no-auth-warning "$@"
    else
        redis-cli -h "$DEVENV_VALKEY_HOST" -p "$DEVENV_VALKEY_PORT" "$@"
    fi
}

# ── helpers shared with providers ────────────────────────────────────────

# Derived, not stored: a re-run must hand back the credential a stale .env
# already holds, and derivation achieves that without plaintext secrets at rest.
devenv_derive_password() {
    [ -n "$DEVENV_SECRET_SALT" ] || die "DEVENV_SECRET_SALT is unset — set it in .env" 4
    printf '%s|%s|%s' "$DEVENV_SECRET_SALT" "$1" "$2" | sha256sum | cut -c1-32
}

devenv_registry_get() {
    devenv_psql_control -tAc \
        "SELECT COALESCE($2::text,'') FROM devenv_tenant WHERE key = '$1'" 2>/dev/null || true
}

# Smallest free id in 1..N-1. UNIQUE(valkey_db) makes the DB the arbiter, so
# concurrent callers race harmlessly — the loser retries.
devenv_valkey_db_alloc() {
    _alloc_key="$1"
    _alloc_existing="$(devenv_registry_get "$_alloc_key" valkey_db)"
    if [ -n "$_alloc_existing" ]; then echo "$_alloc_existing"; return 0; fi

    _alloc_n="$(devenv_psql_control -tAc "
        SELECT n FROM generate_series(1, $((DEVENV_VALKEY_DATABASES - 1))) AS n
        WHERE NOT EXISTS (SELECT 1 FROM devenv_tenant t WHERE t.valkey_db = n)
        ORDER BY n LIMIT 1")"
    _alloc_n="$(echo "$_alloc_n" | tr -d '[:space:]')"
    [ -n "$_alloc_n" ] || die "no free valkey database id (cap $((DEVENV_VALKEY_DATABASES - 1))) — run 'devenv list' and release one" 3
    echo "$_alloc_n"
}

devenv_slug() {
    echo "devenv_$(echo "$1" | tr '-' '_')"
}

# Rewrite only the keys devenv owns; anything else in the file is preserved.
# Both arguments are files so KEY=VALUE lines never go through word splitting.
devenv_env_merge() {
    _env_file="$1"; _env_new="$2"
    _env_tmp="${_env_file}.devenv.$$"
    : > "$_env_tmp"
    if [ -f "$_env_file" ]; then
        _env_drop="$(sed 's/=.*//' "$_env_new" | paste -sd'|' -)"
        grep -Ev "^(${_env_drop})=" "$_env_file" >> "$_env_tmp" || true
    fi
    cat "$_env_new" >> "$_env_tmp"
    mv "$_env_tmp" "$_env_file"
}

for _p in "$DEVENV_LIB"/providers/*.sh; do
    [ -f "$_p" ] && . "$_p"
done

# ── commands ─────────────────────────────────────────────────────────────

cmd_provision() {
    key=""; with="postgres,valkey"; lifecycle="keep"; env_file="$PWD/.env"
    while [ $# -gt 0 ]; do
        case "$1" in
            --with)      with="${2:?--with needs a value}"; shift 2 ;;
            --lifecycle) lifecycle="${2:?--lifecycle needs a value}"; shift 2 ;;
            --env-file)  env_file="${2:?--env-file needs a value}"; shift 2 ;;
            -*)          die "unknown flag: $1" 2 ;;
            *)           [ -z "$key" ] || die "unexpected argument: $1" 2; key="$1"; shift ;;
        esac
    done
    [ -n "$key" ] || die "usage: devenv provision <key> [--with ...] [--env-file PATH]" 2
    echo "$key" | grep -Eq '^[a-z][a-z0-9-]{1,40}$' \
        || die "invalid key '$key' — must match ^[a-z][a-z0-9-]{1,40}\$" 2
    [ "$lifecycle" = "keep" ] \
        || die "lifecycle '$lifecycle' is not implemented (only 'keep')" 2

    slug="$(devenv_slug "$key")"
    providers="$(echo "$with" | tr ',' ' ')"
    for prov in $providers; do
        case "$prov" in
            postgres|valkey) ;;
            *) die "unknown provider '$prov' (known: postgres, valkey)" 2 ;;
        esac
    done

    postgres_probe || die "devenv-pg unreachable at $DEVENV_PG_HOST:$DEVENV_PG_PORT" 4
    case " $providers " in *" valkey "*)
        valkey_probe || die "devenv-valkey unreachable at $DEVENV_VALKEY_HOST:$DEVENV_VALKEY_PORT" 4 ;;
    esac

    existing="$(devenv_registry_get "$key" key)"

    # Register before creating: the row is what makes the valkey id exclusive,
    # and every provider is idempotent, so a crash between the two is repaired
    # by re-running rather than leaving an unclaimed id.
    if [ -z "$existing" ]; then
        devenv_psql_control -v ON_ERROR_STOP=1 -c "
            INSERT INTO devenv_tenant (key, slug, lifecycle, providers, created_by)
            VALUES ('$key', '$slug', '$lifecycle',
                    ARRAY[$(echo "$providers" | sed "s/[^ ]*/'&'/g" | tr ' ' ',')],
                    '${DEVENV_OWNER:-$(id -un)@$(hostname)}')" >/dev/null
    else
        devenv_psql_control -c \
            "UPDATE devenv_tenant SET last_seen_at = now() WHERE key = '$key'" >/dev/null
    fi

    out_file="$(mktemp)"
    trap 'rm -f "$out_file"' EXIT INT TERM
    echo "DEVENV_KEY=$key" > "$out_file"
    for prov in $providers; do
        out="$("${prov}_provision" "$key" "$slug")"
        if [ "$prov" = valkey ]; then
            db="$(echo "$out" | sed 's#.*/##')"
            devenv_psql_control -v ON_ERROR_STOP=1 -c \
                "UPDATE devenv_tenant SET valkey_db = $db WHERE key = '$key'" >/dev/null
        fi
        printf '%s\n' "$out" >> "$out_file"
    done

    devenv_env_merge "$env_file" "$out_file"

    if [ -n "$existing" ]; then
        note "devenv: '$key' (existing) → $env_file"
    else
        note "devenv: '$key' provisioned → $env_file"
    fi
    cat "$out_file"
}

cmd_release() {
    key="${1:?usage: devenv release <key>}"
    postgres_probe || die "devenv-pg unreachable at $DEVENV_PG_HOST:$DEVENV_PG_PORT" 4
    if [ -z "$(devenv_registry_get "$key" key)" ]; then
        note "devenv: '$key' (absent)"; return 0
    fi
    slug="$(devenv_slug "$key")"
    valkey_release "$key" "$slug"
    postgres_release "$key" "$slug"
    devenv_psql_control -c "DELETE FROM devenv_tenant WHERE key = '$key'" >/dev/null
    note "devenv: '$key' released"
}

cmd_list() {
    postgres_probe || die "devenv-pg unreachable at $DEVENV_PG_HOST:$DEVENV_PG_PORT" 4
    # Same view the humans query from a SQL client — one definition, no drift.
    devenv_psql_control -c \
        "SELECT key, created_by, pg_size, valkey_db,
                date_trunc('second', idle) AS idle
         FROM devenv_usage"
}

case "${1:-}" in
    provision) shift; cmd_provision "$@" ;;
    release)   shift; cmd_release   "$@" ;;
    list)      shift; cmd_list      "$@" ;;
    -h|--help|help|"")
        sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$1' (provision|release|list)" 2 ;;
esac
